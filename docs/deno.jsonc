{
  "imports": {
    "lume/": "https://deno.land/x/lume@v2.5.2/",
    "preact": "npm:preact"
  },
  "tasks": {
    "build": "deno run -A _main.ts",
    "serve": "deno run -A --unstable-hmr _main.ts -s"
  },
  "compilerOptions": {
    "types": [
      "lume/types.ts",
      "./types.d.ts"
    ],
    "jsx": "precompile",
    "jsxImportSource": "preact"
  }
}
