msgid "Blimp Pilot"
msgstr "Пилот дирижабля"

#: data/json/professions.json
msgctxt "profession_female"
msgid "Blimp Pilot"
msgstr "Пилот дирижабля"

#. ~ Profession (male Blimp Pilot) description
#: data/json/professions.json
msgctxt "prof_desc_male"
msgid ""
"You once piloted a newscasting blimp, drifting above cities and fields to "
"capture stories from the skies."
msgstr ""
"Когда-то вы пилотировали дирижабль для трансляции новостей, паря над "
"городами и полями, чтобы снимать репортажи с высоты птичьего полета."

#. ~ Profession (female Blimp Pilot) description
#: data/json/professions.json
