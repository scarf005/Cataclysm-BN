msgstr[1] "котёнка-сфинкса"
msgstr[2] "котят-сфинксов"
msgstr[3] "котята-сфинксы"

#. ~ Description for Sphynx kitten
#: data/json/monsters/mammal.json
msgid ""
"An almost total lack of fur on this kitten suggests it is of the hairless "
"Sphynx breed."
msgstr "Котёнок, чье тело почти не прикрыто шерстью. Вероятно, породы сфинкс."

#: data/json/monsters/mammal.json
msgid "tabby cat"
msgid_plural "tabby cats"
msgstr[0] "полосатый кот"
msgstr[1] "полосатых кота"
msgstr[2] "полосатых котов"
msgstr[3] "полосатые коты"

#. ~ Description for tabby cat
#: data/json/monsters/mammal.json
msgid ""
"Marked with the characteristic 'M' on its forehead and decorated with "
"swirling stripes, the tabby's markings provide excellent camouflage."
msgstr ""
"Характерная отметина в виде буквы «М» на лбу и закрученные полоски "
"обеспечивают полосатому коту прекрасную маскировку."

#: data/json/monsters/mammal.json
