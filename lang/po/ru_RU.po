msgstr[0] "приклад гранатомёта"
msgstr[1] "приклада гранатомёта"
msgstr[2] "прикладов гранатомёта"
msgstr[3] "приклад гранатомёта"

#. ~ Description for {'str': 'grenade launcher buttstock'}
#: data/json/items/resources/misc.json
