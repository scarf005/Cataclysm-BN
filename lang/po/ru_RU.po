msgid_plural "Teleporter network schematics"
msgstr[0] "«Схемотехника телепортационной сети»‎"
msgstr[1] "копии «Схемотехника телепортационной сети»‎"
msgstr[2] "копий «Схемотехника телепортационной сети»‎"
