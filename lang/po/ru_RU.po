msgstr[2] "котят девон-рекс"
msgstr[3] "котята девон-рекс"

#. ~ Description for Devon Rex kitten
#: data/json/monsters/mammal.json
msgid ""
"This curly-coated kitten has enormous ears and inquisitive eyes, possibly a "
"Devon Rex."
msgstr ""
"Котёнок с кудрявой шерстью, огромными ушами и любопытными глазками, скорее "
"всего породы Девон-рекс."

#: data/json/monsters/mammal.json
msgid "Sphynx cat"
msgid_plural "Sphynx cats"
msgstr[0] "кот-сфинкс"
msgstr[1] "кота-сфинкса"
msgstr[2] "котов-сфинксов"
msgstr[3] "коты-сфинксы"

#. ~ Description for Sphynx cat
#: data/json/monsters/mammal.json
msgid ""
"The Sphynx cat has practically no fur on its body, exposing its curiously "
"wrinkled skin."
msgstr ""
"Кот-сфинкс, его кожа причудливо морщинится, демонстрируя полное отсутствие "
"меха."

#: data/json/monsters/mammal.json
