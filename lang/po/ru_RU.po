#: data/json/vehicleparts/boards.json
msgid "extra light quarterpanel"
msgstr "сверхлёгкая боковина"

#. ~ Description for {'str': 'extra light quarterpanel'}
#: data/json/vehicleparts/boards.json
msgid ""
"A half-height thin metal wall.  Keeps zombies outside the vehicle but allows"
