#: data/json/furniture_and_terrain/furniture-appliances.json
msgid "grid welding rig"
msgstr "подключённый к сети сварочный аппарат"

#. ~ Description for grid welding rig
#: data/json/furniture_and_terrain/furniture-appliances.json
msgid ""
"A vehicle welding rig connected to a electrical grid.  Has a soldering iron "
"attached."
msgstr ""
"Автомобильный сварочный аппарат, подключенный к электрической сети. К нему "
"присоединён паяльник."

