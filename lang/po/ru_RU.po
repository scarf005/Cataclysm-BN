#: src/suffer.cpp
msgid "The water wash away the scent."
msgstr "Вода смывает запах."

#: src/suffer.cpp
msgid "You feel the water burning your skin."
msgstr "Вы чувствуете, как вода жжёт вашу кожу."

#: src/teleport.cpp
msgid "You feel a strange, inwards force."
msgstr "Вы чувствуете странную внутреннюю силу."

#: src/teleport.cpp
