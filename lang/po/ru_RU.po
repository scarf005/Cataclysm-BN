#: data/mods/MagicalNights/monsters.json
msgid "animated blade"
msgid_plural "animated blades"
msgstr[0] "оживлённый клинок"
msgstr[1] "оживлённых клинка"
msgstr[2] "оживлённых клинков"
msgstr[3] "оживлённые клинки"

#. ~ Description for animated blade
#: data/mods/MagicalNights/monsters.json
msgid ""
"A conjured glowing longsword that darts and dodges around, slicing and "
"cutting your foes into small pieces."
msgstr ""
"Вызванный светящийся длинный меч, кувыркающийся в воздухе и рубящий ваших "
"врагов на мелкие кусочки."

#: data/mods/MagicalNights/monsters.json
msgid "Summoned Zombie"
msgid_plural "Summoned Zombies"
msgstr[0] "призванный зомби"
msgstr[1] "призванных зомби"
msgstr[2] "призванных зомби"
msgstr[3] "призванные зомби"

#. ~ Description for Summoned Zombie
#: data/mods/MagicalNights/monsters.json
msgid "A summoned zombie.  Slightly more intelligent than its wild cousins."
msgstr ""
"Призванный зомби. Немного более сообразительный, чем его родственники."

#: data/mods/MagicalNights/monsters.json
msgid "Summoned Skeleton"
msgid_plural "Summoned Skeletons"
msgstr[0] "призванный скелет"
msgstr[1] "призванных скелета"
msgstr[2] "призванных скелетов"
msgstr[3] "призванные скелеты"

#. ~ Description for Summoned Skeleton
#: data/mods/MagicalNights/monsters.json
msgid ""
"A summoned skeleton.  Slightly more intelligent than its wild cousins.  "
"Seems like it somehow enjoys puns."
msgstr ""
"Призванный скелет.  Его костный мозг явно побольше соображает, чем у его "
"диких собратьев. Похоже, ему нравятся каламбуры."

#: data/mods/MagicalNights/monsters.json
msgid "Summoned Decayed Pouncer"
msgid_plural "Summoned Decayed Pouncers"
msgstr[0] "призванный прогнивший когтехват"
msgstr[1] "призванных прогнивших когтехвата"
msgstr[2] "призванных прогнивших когтехватов"
msgstr[3] "призванные прогнившие когтехваты"

#. ~ Description for Summoned Decayed Pouncer
#: data/mods/MagicalNights/monsters.json
msgid ""
"A summoned zombie cougar.  Slightly more intelligent than its wild cousins."
msgstr ""
"Призванный прогнивший когтехват. Более сообразительный, чего его дикие "
"сородичи."

#: data/mods/MagicalNights/obsolete.json
