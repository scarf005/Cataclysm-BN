msgid_plural "ornamental plate armors"
msgstr[0] "парадные доспехи"
msgstr[1] "парадных доспеха"
msgstr[2] "парадных доспехов"
msgstr[3] "парадные доспехи"

#. ~ Description for {'str': 'ornamental plate armor'}
