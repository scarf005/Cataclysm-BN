#: data/json/professions.json
msgctxt "profession_male"
msgid "Military Corpse Disposal"
msgstr "Военный сжигатель трупов"

#: data/json/professions.json
msgctxt "profession_female"
msgid "Military Corpse Disposal"
msgstr "Военная сжигательница трупов"

#. ~ Profession (male Military Corpse Disposal) description
#: data/json/professions.json
msgctxt "prof_desc_male"
msgid ""
"In response to the outbreak, you were dispatched to contain the infection by"
" burning the corpses.  With command consumed by the undead, your priorities "
"have shifted to basic survival."
msgstr ""
"В ответ на вспышку эпидемии тебя отправили сжигать трупы для сдерживания "
"распространения инфекции. Учитывая, что командование было поглощено нежитью,"
" твои приоритеты сместились в сторону простого выживания."

#. ~ Profession (female Military Corpse Disposal) description
#: data/json/professions.json
msgctxt "prof_desc_female"
msgid ""
"In response to the outbreak, you were dispatched to contain the infection by"
