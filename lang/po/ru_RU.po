msgid_plural "boiled leather medium quadruped bardings with bones"
msgstr[0] "средний бард для четвероногих из варёной кожи с костями"
msgstr[1] "средних барда для четвероногих из варёной кожи с костями"
msgstr[2] "средних бардов для четвероногих из варёной кожи с костями"
msgstr[3] "средний бард для четвероногих из варёной кожи с костями"

