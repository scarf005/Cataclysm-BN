#. ~ Computer name
#: data/mods/CRT_EXPANSION/mapgen/townbase.json
msgid "C.R.I.T. H.S.P.O. Door"
msgstr "Дверь C.R.I.T. О.У.П.М."

#. ~ Computer option
#: data/mods/CRT_EXPANSION/mapgen/townbase.json
msgid "Unlock door?"
msgstr "Отпереть дверь?"

#: data/mods/CRT_EXPANSION/mapgen/townbase.json
msgid "C.R.I.T. Defensive Outpost"
msgstr "оборонительный форпост C.R.I.T."

#: data/mods/CRT_EXPANSION/mapgen/townbase.json
msgid "C.R.I.T. Defensive Outpost Roof"
msgstr "крыша оборонительного форпоста C.R.I.T."

#: data/mods/CRT_EXPANSION/martial/CRT_Bladework.json
msgid "C.R.I.T Blade-work manual"
