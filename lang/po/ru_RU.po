msgid "a klaxon blaring!"
msgstr "звук клаксона!"

#: data/json/speech.json
msgid "\"EMERGENCY, EMERGENCY!\""
msgstr "«ТРЕВОГА, ТРЕВОГА!»"

#: data/json/speech.json
msgid "a static hissing sound."
msgstr "шипение."

#: data/json/speech.json
msgid "\"That creepy abandoned post-apocalyptic lab complex looks safe…\""
msgstr "«Эта жуткая заброшенная лаборатория выглядит безопасно…»"

#: data/json/speech.json
msgid ""
"\"Don't worry, it isn't like anything could teleport out of the containment "
"cells.\""
msgstr "«Не бойся, непохоже, чтобы что-то могло выскочить из камер»."

#: data/json/speech.json
msgid "\"Hold on, I want to pulp that zombie corpse.\""
msgstr "«Погоди, я хочу разбить труп того зомби»."

#: data/json/speech.json
msgid "\"What did that thing just hit me with?\""
msgstr "«Что, эта вещь только что ударила меня?»"

#: data/json/speech.json
msgid "\"I can barely move.  Run!  Save yourself!\""
msgstr "«Я едва могу двигаться. Беги! Спасайся!»"

#: data/json/speech.json
msgid "\"Oh you motherfucking shellfish, you're going down.\""
msgstr "«Ах ты, ублюдок сраный, а ну иди сюда»."

#: data/json/speech.json
msgid "\"I… I feel weak…\""
msgstr "«Я… Я чувствую слабость…»"

#: data/json/speech.json
msgid "\"Oi, dingus, you can't keep me in 'ere.\""
msgstr "«Ой, братиш, ты не можешь держать меня 'есь»."

#: data/json/speech.json
msgid "\"We got a treaty w'yer people, don'we?\""
msgstr "«У нас же был договор с людьми, не так ли?»"

#: data/json/speech.json
msgid "\"This'll get back t'my bosses, right and so!\""
msgstr "«Это дойдёт д' моего босса, непременно!»"

#: data/json/speech.json
msgid "\"Lemme outta here!\""
msgstr "«Выпустите меня!»"

#: data/json/speech.json
msgid "\"Let me in…\""
msgstr "«Впусти меня…»"

#: data/json/speech.json
msgid "\"Let me in!\""
msgstr "«Впусти меня!»"

#: data/json/speech.json
msgid "\"We're both scavs, in't we?\""
msgstr "«Мы оба падальщики, не так ли?»"

#: data/json/speech.json
msgid ""
"\"Hey look, that one's carrying something.  Let's crack it open and steal "
"it.\""
msgstr "«Эй смотри, он что-то несёт. Давай гопанём его»."

#: data/json/speech.json
msgid "\"G… geddoff me you… you bastard…\""
msgstr "«У… Убери свои грязные лапы… Ублюдок…»"

#: data/json/speech.json
msgid "\"Did-a-chuk?\""
msgstr "«Дид-а-чук?»"

#: data/json/speech.json
msgid "\"Dad-a-chak?\""
msgstr "«Дад-а-чак?»"

#: data/json/speech.json
msgid "\"Dad-a-cham?\""
msgstr "«Дад-а-чам?»"

#: data/json/speech.json
msgid "\"Did-a-chak?\""
msgstr "«Дид-а-чак?»"

#: data/json/speech.json
msgid "\"Did-a-chum?\""
msgstr "«Дид-а-чам?»"

#: data/json/speech.json
msgid "\"Dad-a-chuk?\""
msgstr "«Дад-а-чук?»"

#: data/json/speech.json
msgid "\"What are you doing?  No!  NO!\""
msgstr "«Что ты делаешь? Нет! НЕЕТ!»"

#: data/json/speech.json
msgid "\"Did you see what they did to him?\""
msgstr "«Ты видел, что они с ним сделали?»"

#: data/json/speech.json
msgid "\"Yeah.  I can't believe he stayed alive that long.\""
msgstr "«Ага. Не могу поверить, что он всё ещё жив.»"

#: data/json/speech.json
msgid "\"I think there's something in the air that's keeping us alive.\""
msgstr "«Я думаю, что в воздухе витает что-то, что помогает нам выжить»."

#: data/json/speech.json
msgid "\"Burning… from the inside…\""
msgstr "«Горю… изнутри…»"

#: data/json/speech.json
msgid "\"This smell…  Don't know…\""
msgstr "«Этот запах… Не знаю…»"

#: data/json/speech.json
msgid "heavy breathing."
msgstr "тяжёлое дыхание."

#: data/json/speech.json src/game.cpp src/grab.cpp
msgid "a scraping noise."
msgstr "скрежет."

#: data/json/speech.json
msgid "\"No…  Stop the burning!\""
msgstr "«Нет… Останови огонь!»"

#: data/json/speech.json
msgid "\"Hrgm…  Blood…  Hungry…\""
msgstr "«Грррх… Кровь… Голод…»"

#: data/json/speech.json
msgid "\"Hunger…  Must eat…\""
msgstr "«Хочу есть… Надо есть…»"

#: data/json/speech.json
msgid "\"Run…  Chase…  Eat…\""
msgstr "«Бежать… Искать… Есть…»"

#: data/json/speech.json
msgid "hysterical laughing."
msgstr "истерический хохот."

#: data/json/speech.json
msgid "coughing."
msgstr "кашель."

#: data/json/speech.json
msgid "growling."
msgstr "ворчание."

#: data/json/speech.json
msgid "wheezing."
msgstr "хрипящее дыхание."

#: data/json/speech.json
msgid "\"WHY THE FUCK are you doing this to me?\""
msgstr "«КАКОГО ХУЯ ты со мной творишь?»"

#: data/json/speech.json
msgid "\"LEAVE!  NOW!\""
msgstr "«УЙДИ! СЕЙЧАС ЖЕ!»"

#: data/json/speech.json
msgid "\"I TOLD YOU TO GET OUT OF HERE!\""
msgstr "«Я ГОВОРИЛ ТЕБЕ УЙТИ!»"

#: data/json/speech.json
msgid "\"WHAT THE FUCK DO YOU WANT FROM ME?!\""
msgstr "«ЧТО ТЕБЕ, БЛЯДЬ, ОТ МЕНЯ НАДО?!»"

#: data/json/speech.json
msgid "\"STOP!\""
msgstr "«ХВАТИТ!»"

#: data/json/speech.json
msgid "indistinct shouting."
msgstr "неразборчивый крик."

#: data/json/speech.json
msgid "screaming."
msgstr "вопли."

#: data/json/speech.json
msgid "\"MEAT!\""
msgstr "«МЯСО!»"

#: data/json/speech.json
msgid "\"TEKELI-LI!\""
msgstr "«ТЕКЕЛИ-ЛИ!»"

#: data/json/speech.json
msgid "\"TEKELI-LI!  TEKELI-LI!  TEKELI-LI!\""
msgstr "«ТЕКЕЛИ-ЛИ! ТЕКЕЛИ-ЛИ! ТЕКЕЛИ-ЛИ!»"

#: data/json/speech.json
msgid "\"Tekeli-li.\""
msgstr "«Текели-ли!»"

#: data/json/speech.json
msgid "a slurping sound."
msgstr "хлюпающий звук."

#: data/json/speech.json
msgid "\"WHY!  WHY, WHYYY!\""
msgstr "«ПОЧЕМУ! ПОЧЕМУ! ПОЧЕМУУУ!»"

#: data/json/speech.json
msgid "an electronic voice saying \"CONNECTION FAILED.  Abort, Retry, Fail?\""
msgstr ""
"электронный голос «СОЕДИНЕНИЕ НЕ УСТАНОВЛЕНО. Завершить, Повторить, "
"Отменить?»"

#: data/json/speech.json
msgid "\"I was once a man.  A MAN!\""
msgstr "«Когда-то я был человеком. ЧЕЛОВЕКОМ!»"

#: data/json/speech.json
msgid "\"What have I become?\""
msgstr "«Во что я превратился?»"

#: data/json/speech.json
msgid "an electronic voice saying \"KILL ALL HUMANS!\""
msgstr "электронный голос «УБИТЬ ВСЕХ ЛЮДЕЙ!»"

#: data/json/speech.json
msgid "\"Have you seen my children?\""
msgstr "«Ты видел моего ребёнка?»"

#: data/json/speech.json
msgid "\"What have I become?  Why can't I die?\""
msgstr "«Во что я превратился? Почему я не могу умереть?»"

#: data/json/speech.json
msgid ""
"\"Please, kill me!\", followed by an electronic voice saying \"SELF "
"PRESERVATION PROTOCOLS ACTIVATED\""
msgstr ""
"«Прошу, убей меня!» и следом электронный голос «ПРОТОКОЛ САМОСОХРАНЕНИЯ "
"АКТИВИРОВАН»"

#: data/json/speech.json
msgid "\"Please, take me with you.\""
msgstr "«Прошу, возьми меня с собой!»"

#: data/json/speech.json
msgid "\"Not that way!  Go left!\""
msgstr "«Не сюда! Налево!»"

#: data/json/speech.json
msgid "\"I told you to let me die.\""
msgstr "«Я просил тебя дать мне умереть»."

#: data/json/speech.json
msgid "\"W-where am I?  Why does it hur-REBOOTING IN 59 SECONDS.\""
msgstr "«Г-где я? Почему мне так боль-ПЕРЕЗАГРУЗКА ЧЕРЕЗ 59 СЕКУНД»."

#: data/json/speech.json
msgid "\"THIS UNIT IS BROKEN.  PLEASE CALL AN ATTENDANT.\""
msgstr "«ЭТО УСТРОЙСТВО НЕИСПРАВНО. ПОЖАЛУЙСТА, СВЯЖИТЕСЬ С ДЕЖУРНЫМ»."

#: data/json/speech.json
msgid "\"Can't… breathe…\""
msgstr "«Не могу… дышать…»"

#: data/json/speech.json
msgid "\"This cannot continue.\""
msgstr "«Так больше нельзя»."

#: data/json/speech.json
msgid "\"USER PASSWORD UNRECOGNIZED.\""
msgstr "«ПОЛЬЗОВАТЕЛЬСКИЙ ПАРОЛЬ НЕ РАСПОЗНАН.»"

#: data/json/speech.json
msgid ""
"\"Have you seen my friend?  He went into surgery yesterday… or maybe the day"
" before…\""
msgstr "«Ты не видел моего друга? У него вчера была операция… или позавчера…»"

#: data/json/speech.json
msgid "\"Is it done?  Am I perfect now?\""
msgstr "«Готово? Я теперь совершенен?»"

#: data/json/speech.json
msgid "\"I have done what you asked.  Please let me go!\""
msgstr "«Я сделал, что ты просил. Пожалуйста, отпусти меня!»"

#: data/json/speech.json
msgid "\"I cannot… yet I must.  How do you calculate that?\""
msgstr "«Я не могу… но так надо. Как это рассчитать?»"

#: data/json/speech.json
msgid "\"This is a dream.  This has to be a dream.\""
msgstr "«Это всё сон. Это должен быть сон»."

#: data/json/speech.json
msgid "\"This is my life now… this is my life now… this is my life now…\""
msgstr "«Теперь это моя жизнь… Теперь это моя жизнь… Теперь это моя жизнь…»"

#: data/json/speech.json
msgid "\"Wanna go home…\""
msgstr "«Я хочу домой…»"

#: data/json/speech.json
msgid "screams of pain."
msgstr "крики боли."

#: data/json/speech.json
msgid "muffled sobbing."
msgstr "приглушённые рыдания."

#: data/json/speech.json
msgid ""
"\"You lied to me!  Look at what you've done!\", followed by an electronic "
"voice saying \"YOU'LL PAY FOR THIS!\""
msgstr ""
"«Ты мне соврал! Посмотри, что ты наделал!» и следом электронный голос «ТЫ ЗА"
" ЭТО ЗАПЛАТИШЬ!»"

#: data/json/speech.json src/monattack.cpp
msgid ""
"a soft robotic voice say, \"Come here and stand still for a few minutes, "
"I'll give you a check-up.\""
msgstr "мягкий электронный голос «Подойдите сюда. Я вас осмотрю»."

#: data/json/speech.json src/monattack.cpp
msgid ""
"a soft robotic voice say, \"Come on.  I don't bite, I promise it won't hurt "
"one bit.\""
msgstr ""
"мягкий электронный голос «Ну же. Я не кусаюсь, обещаю, это ни капельки не "
"больно»."

#: data/json/speech.json src/monattack.cpp
msgid "a soft robotic voice say, \"Here we go.  Just hold still.\""
msgstr "мягкий электронный голос «Вот так. Просто стойте спокойно»."

#: data/json/speech.json
msgid ""
"a voice say, \"I don't want to go but our time together is drawing to an "
"end.\""
msgstr "голос: «Я не хочу уходить, но наше с тобой время истекает»."

#: data/json/speech.json
msgid "a cheery voice say, \"Customer?  We'll be friends forever, right?\""
msgstr "весёлый голос «Покупатель? Мы же будем друзьями навечно, правда?»"

#: data/json/speech.json
msgid ""
"a neutral voice say, \"Customer I must inform you that my allocated time "
"with you will soon come to its end.\""
msgstr ""
"нейтральный голос: «Покупатель, я должен сообщить, что выделенное вам время "
"скоро истечёт»."

#: data/json/speech.json
msgid ""
"a neutral voice say, \"I'll have to leave you soon.  You can acquire more "
"friendship through my dedicated interface if you wish for me to stay.\""
msgstr ""
"нейтральный голос: «Я скоро вас покину. Вы можете приобрести больше дружбы "
"при помощи моего специализированного интерфейса, если хотите, чтобы я "
"остался»."

#: data/json/speech.json
msgid ""
"a worried voice say, \"Customer, could you please get more friendship?  I "
"don't want to go…\""
msgstr ""
"обеспокоенный голос «Покупатель, пожалуйста, не мог бы ты достать ещё "
"дружбы? Я не хочу уходить…»"

#: data/json/speech.json
msgid "a voice say, \"Oh no!  You ran out of friendship!\""
msgstr "голос «О нет! Дружба кончилась!»"

#: data/json/speech.json
msgid "a cheery voice say, \"Well I'm done here.  Have a nice day.\""
msgstr "весёлый голос: «Что ж, моя работа выполнена. Хорошего дня»."

#: data/json/speech.json
msgid ""
"a cheery voice say, \"Here are your groceries.  Thank you for shopping with "
"me today, have a nice day.\""
msgstr ""
"весёлый голос: «Вот твои покупки. Спасибо, что сегодня ты был со мной, "
"хорошего тебе дня»."

#: data/json/speech.json
msgid "a neutral voice say, \"My job here is done.  Have a nice day.\""
msgstr "нейтральный голос: «Моя работа выполнена. Хорошего дня»."

#: data/json/speech.json
msgid ""
"a distorted voice say, \"Customer…  What's happening?  I don't feel so "
"good.\""
msgstr "искажённый голос: «Покупатель… Что происходит? Мне нехорошо»."

#: data/json/speech.json
msgid ""
"a distorted voice say, \"What… have you done?  My thumbs are not responding "
"anymore!\""
msgstr "искажённый голос: «Что… что ты наделал? Я не чувствую пальцев!»"

#: data/json/speech.json
msgid "a distorted voice say, \"Carrying bags?  I don't understand…\""
msgstr "искажённый голос: «Носить пакеты? Не понимаю…»"

#: data/json/speech.json
msgid ""
"a robotic voice say, \"IRREGULAR ACTIVITY DETECTED.  THUMBS USAGE DENIED.\""
msgstr ""
"электронный голос: «ЗАМЕЧЕНА ПОДОЗРИТЕЛЬНАЯ АКТИВНОСТЬ. ИСПОЛЬЗОВАНИЕ "
"ПАЛЬЦЕВ ОТКЛОНЕНО»."

#: data/json/speech.json
msgid ""
"a robotic voice say, \"UNLICENSED USE DETECTED.  CARRYING PROTOCOL "
"DISABLED.\""
msgstr ""
"электронный голос: «ЗАМЕЧЕНО НЕЗАРЕГИСТРИРОВАННОЕ ИСПОЛЬЗОВАНИЕ. ПРОТОКОЛ "
"ПЕРЕНОСКИ ВЫКЛЮЧЕН»."

#: data/json/speech.json
msgid "\"Stop where you are!\""
msgstr "«Стоять на месте!»"

#: data/json/speech.json
msgid "\"You are under arrest!\""
msgstr "«Вы арестованы!»"

#: data/json/speech.json
msgid "\"Criminal activity detected!\""
msgstr "«Обнаружена противоправная деятельность!»"

#: data/json/speech.json
msgid "\"Criminal activity registered!\""
msgstr "«Зарегистрирована противоправная деятельность!»"

#: data/json/speech.json
msgid "\"Violation of law detected!\""
msgstr "«Обнаружено нарушение закона!»"

#: data/json/speech.json
msgid "\"Suspect on the move!\""
msgstr "«Подозреваемый в бегах!»"

#: data/json/speech.json
msgid "\"Suspect in sight!\""
msgstr "«Обнаружен подозреваемый!»"

#: data/json/speech.json
msgid "\"You are being detained!\""
msgstr "«Вы задержаны!»"

#: data/json/speech.json
msgid "\"You have right to remain silent!\""
msgstr "«У вас есть право хранить молчание!»"

#: data/json/speech.json
msgid "\"Requesting assistance!\""
msgstr "«Запрашиваю поддержку!»"

#: data/json/speech.json
msgid "\"Requesting supervisor!\""
msgstr "«Запрашиваю вызов начальства!»"

#: data/json/speech.json
msgid "\"Requesting human officer!\""
msgstr "«Запрашиваю вызов офицера!»"

#: data/json/speech.json
msgid "\"No officer on scene.  Requesting backup!\""
msgstr "«В районе нет офицера. Запрашиваю поддержку!»"

#: data/json/speech.json
msgid "\"Let me see your hands!\""
msgstr "«Покажите руки, что их было видно!»"

#: data/json/speech.json
msgid "\"Stop resisting!\""
msgstr "«Прекратите сопротивление!»"

#: data/json/speech.json
msgid "\"Code 10-66.  Copy 10-4.  Possible 10-55.\""
msgstr "«Код 10-66. Принял 10-4. Возможно 10-55»."

#: data/json/speech.json
msgid "\"Probable 10-70.\""
msgstr "«Возможно 10-70»."

#: data/json/speech.json
msgid "\"Get on the ground!  Now!\""
msgstr "«На землю, быстро!»"

#: data/json/speech.json
msgid "\"Suspected felony!\""
msgstr "«Возможное уголовное преступление!»"

#: data/json/speech.json
msgid "\"Suspected misdemeanor!\""
msgstr "«Возможное правонарушение!»"

#: data/json/speech.json
msgid "\"Do not reach for your pockets!\""
msgstr "«Уберите руки от карманов!»"

#: data/json/speech.json
msgid "\"Keep your hands up!\""
msgstr "«Руки вверх!»"

#: data/json/speech.json
msgid "\"Get on your knees!\""
msgstr "«На колени!»"

#: data/json/speech.json
msgid "\"Hands in the air!\""
msgstr "«Руки поднять!»"

#: data/json/speech.json
msgid "\"Wait for law enforcement officer!\""
msgstr "«Ожидайте сотрудника полиции!»"

#: data/json/speech.json
msgid "\"Remain where you are!\""
msgstr "«Оставайтесь на месте!»"

#: data/json/speech.json
msgid "\"Police inbound.  Stay where you are!\""
msgstr "«Полиция скоро будет. Оставайтесь на месте!»"

#: data/json/speech.json
msgid "visceral chittering."
msgstr "нутряное посвистывание."

#: data/json/speech.json
msgid "a clear, high-pitched hum."
msgstr "чистый, пронзительный гул."

#: data/json/speech.json
msgid "the hum of static electricity."
msgstr "гул статического электричества."

#: data/json/speech.json
msgid "a low buzzing sound."
msgstr "низкий жужжащий звук."

#: data/json/speech.json
msgid "\"I AM FOODPERSON.  AND I BRING SUSTENANCE!\""
msgstr "«Я ПОЕШЬ-КА. И Я ПРИНОШУ НАСЫЩЕНИЕ!»"

#: data/json/speech.json
msgid "\"Come to FoodPlace today and buy food!\""
msgstr "«Приходи в „Сядь-и-поешь“ сегодня и покупай еду!»"

#: data/json/speech.json
msgid "\"FoodPlace: The best restaurant in an area!\""
msgstr "«„Сядь-и-поешь“ — лучший ресторан на районе!»"

#: data/json/speech.json
msgid "\"Our food contains up to 95% real food.\""
msgstr "«Наша еда на 95% настоящая»."

#: data/json/speech.json
msgid "\"FoodPlace: It's the Calories.\""
msgstr "«„Сядь-и-поешь“: Всё дело в калориях»."

#: data/json/speech.json
msgid "\"You need food, don't you?  Then come with me to FOODPLACE!!\""
msgstr "«Нужно поесть? Ну так пойдём со мной в „СЯДЬ-И-ПОЕШЬ“!!»"

#: data/json/speech.json
msgid "\"FoodPlace: Edible food is OUR guarantee!\""
msgstr "«„Сядь-и-поешь“: МЫ гарантируем съедобную еду!»"

#: data/json/speech.json
msgid "Wanna play with me?"
msgstr "Поиграешь со мной?"

#: data/json/speech.json
msgid "Sing with me!"
msgstr "Спой со мной!"

#: data/json/speech.json data/json/snippets/schizophrenia.json
msgid "I love you!"
msgstr "Я тебя люблю!"

#: data/json/speech.json
msgid "Please take me with you!"
msgstr "Возьми меня с собой!"

#: data/json/speech.json
msgid "May I have a cookie?"
msgstr "Можно мне печенья?"

#: data/json/speech.json
msgid "Let's play together!"
msgstr "Поиграем вместе!"

#: data/json/speech.json
msgid "Time to play!"
msgstr "Время поиграть!"

#: data/json/speech.json
msgid "Om nom nom!  Delicious!"
msgstr "Ням-ням! Вкусно!"

#: data/json/speech.json
msgid "Are you my mommy?"
msgstr "Ты моя мамочка?"

#: data/json/speech.json
msgid "Oh, how fun!"
msgstr "Ой, как здорово!"

#: data/json/speech.json
msgid "You're my best friend!"
msgstr "Ты мой лучший друг!"

#: data/json/speech.json
msgid "Heehee!"
msgstr "Хи-хи!"

#: data/json/speech.json
msgid "Let's have fun!"
msgstr "Давай повеселимся!"

#: data/json/speech.json
msgid "Let's have a tea party!"
msgstr "Попьём чайку!"

#: data/json/speech.json
msgid "You're the best!"
msgstr "Ты лучший!"

#: data/json/speech.json
msgid "You shouldn't have done that."
msgstr "Ты не должен был так делать."

#: data/json/speech.json
msgid "Let's play… Russian roulette."
msgstr "Давай сыграем… В русскую рулетку."

#: data/json/speech.json
msgid "I hate you."
msgstr "Ненавижу тебя."

#: data/json/speech.json
msgid "Go kill yourself!"
msgstr "Убей себя!"

#: data/json/speech.json
msgid "Big Brother is watching you…"
msgstr "Большой Брат следит за тобой…"

#: data/json/speech.json
msgid "Die for me!"
msgstr "Умри за меня!"

#: data/json/speech.json
msgid "Why won't you die?"
msgstr "Почему ты никак не сдохнешь?"

#: data/json/speech.json
msgid "Blood…  Delicious."
msgstr "Кровь… Вкуснятина."

#: data/json/speech.json
msgid "See you… IN HELL!"
msgstr "Увидимся… В АДУ!"

#: data/json/speech.json
msgid "AAAIEEEEEEE!"
msgstr "Айяяяяя!"

#: data/json/speech.json
msgid "FUCK YOU!"
msgstr "ПОШЁЛ НА ХЕР!"

#: data/json/speech.json
msgid "What did you do with my Mommy?"
msgstr "Что ты сделал с моей мамочкой?"

#: data/json/speech.json
msgid "Stay with me… forever!"
msgstr "Будь со мной… Всегда!"

#: data/json/speech.json
msgid "Hey kids.  Want some candy?"
msgstr "Эй, ребятки, хотите конфеток?"

#: data/json/speech.json
msgid "Down here, they ALL float!"
msgstr "Здесь внизу, они ВСЕ летают!"

#: data/json/speech.json
msgid "Do you really need that much honey?"
msgstr "Тебе точно нужно столько мёда?"

#: data/json/speech.json
msgid "My previous owner squealed like a pig when I gutted her!"
msgstr "Моя прежняя хозяйка визжала как свинья, когда я её резал!"

#: data/json/speech.json
msgid "BARK!"
msgstr "ГАВ!"

#: data/json/speech.json
msgid "YAP!"
msgstr "ТЯФ!"

#: data/json/speech.json
msgid "WOOF!"
msgstr "АВ-АВ!"

#: data/json/speech.json
msgid "\"I'll show them.  I'll prove I was right all along!\""
msgstr "«Я им покажу. Я докажу, что правда была на моей стороне!»"

#: data/json/speech.json
msgid "\"The vectors, the vectors are all wrong…\""
msgstr "«Векторы, все векторы некорректные…»"

#: data/json/speech.json
msgid "\"There's nothing there.  This is all just a simulation, a bad dream…\""
msgstr "«Ничего там нет. Всё это симуляция, дурной сон…»"

#: data/json/speech.json
msgid "\"There's.  Nothing.  There.\""
msgstr "«Там. Ничего. Нет.»"

#: data/json/speech.json
msgid "\"They called me a fool.  Now who's the fool!?\""
msgstr "«Они считали, что я из придурков. Ну и кто теперь придурок?!»"

#: data/json/speech.json
msgid "\"Get back in your cage!\""
msgstr "«Полезай назад в свою клетку!»"

#: data/json/speech.json
msgid "\"X-ray breaching perimeter!\""
msgstr "«Рентгеново излучение пробивает периметр!»"

#: data/json/speech.json
msgid "\"Lock this sector down, damnit!\""
msgstr "«Возьмите этот сектор под оцепление, чёрт!»"

#: data/json/speech.json
msgid "\"Unknown entity escaping containment!\""
msgstr "«Неизвестная сущность вырывается из зоны содержания!»"

#: data/json/speech.json
msgid "\"I am the night rider!\""
msgstr "«Я гонщик в ночи!»"

#: data/json/speech.json
msgid "\"I'm here to swim in gasoline, baby!\""
msgstr "«Детка, я здесь чтобы поплавать в бензине!»"

#: data/json/speech.json
msgid "\"Give me unleaded, or you'll get lead!\""
msgstr "«Давай мне бессвинцовое, иначе получишь свинца!»"

#: data/json/speech.json
msgid "\"I'm a fuel-injected suicide machine!\""
msgstr "«Я суицидальная машина, полная топлива!»"

#: data/json/speech.json
msgid "\"I'm gonna tan your god damn hide!\""
msgstr "«Я твою треклятую шкуру на выделку отправлю!»"

#: data/json/speech.json
msgid "\"Which one of you fuckers touched my bike!?\""
msgstr "«Кто из вас, мудаков, трогал мой байк?!»"

#: data/json/speech.json
msgid "\"Reach for the sky!\""
msgstr "«Прямо в небо!»"

#: data/json/speech.json
msgid "\"Clear my line of fire!\""
msgstr "«Уйди с линии огня!»"

#: data/json/speech.json
msgid "\"Weapons hot!\""
msgstr "«Оружие на изготовку!»"

#: data/json/speech.json
msgid "\"Lock and load!\""
msgstr "«Заряжай!»"

#: data/json/speech.json
msgid "\"I don't have to be faster than them, just faster than you!\""
msgstr "«Мне не нужно быть быстрее, чем они, достаточно быть быстрее тебя!»"

#: data/json/speech.json
msgid "\"My feet failed me!  Arms, don't fail me!\""
msgstr "«Мои ступни меня подвели! Руки, хоть вы не подведите!»"

#: data/json/speech.json
msgid "\"Look at me.  I am the captain now.\""
msgstr "«Посмотри на меня. Теперь я капитан.»"

#: data/json/speech.json
msgid ""
"\"I don't have to take this abuse from you, there are plenty of people to "
"abuse me!\""
msgstr ""
"«Мне ни к чему твои оскорбления, вокруг и так хватает людей, чтобы меня "
"оскорблять!»"

#: data/json/speech.json
msgid "\"You're a monster!\""
msgstr "«Ты чудовище!»"

#: data/json/speech.json
msgid "\"I've had enough of your bullshit!\""
msgstr "«Довольно с меня твоего дерьма!»"

#: data/json/speech.json
msgid "\"Adios, motherfucker!\""
msgstr "«Adios, ублюдок!»"

#: data/json/speech.json
msgid "\"Get out of here or I'll kill you!\""
msgstr "«Вали отсюда, или я тебя прикончу!»"

#: data/json/speech.json
msgid "\"Keep your distance!\""
msgstr "«Сохраняй дистанцию!»"

#: data/json/speech.json
msgid "\"This is my territory, asshole!\""
msgstr "«Это моя точка, ты, жопа!»"

#: data/json/speech.json
msgid "\"Fuck off, I saw this place first!\""
msgstr "«Съеби, мои глаза приметили это место раньше!»"

#: data/json/speech.json
msgid "\"Get out of here, I own this town now!\""
msgstr "«Проваливай, теперь это мой город!»"

#: data/json/speech.json
msgid "\"We've got incoming!\""
msgstr "«Нас атакуют!»"

#: data/json/speech.json
msgid "\"Hostiles inbound.\""
msgstr "«Враги на подходе.»"

#: data/json/speech.json
msgid "\"I've got movement!\""
msgstr "«У меня тут движение!»"

#: data/json/speech.json
msgid "\"Danger close!\""
msgstr "«Опасность рядом!»"

#: data/json/speech.json
msgid "\"Last one alive, lock the door!\""
msgstr "«Последний живой, заприте дверь!»"

#: data/json/speech.json
msgid "\"We have you surrounded, at least from this side!\""
msgstr "«Мы тебя окружили, по крайней мере с этой стороны!»"

#: data/json/speech.json
msgid "\"Charge!\""
msgstr "«В атаку!»"

#: data/json/speech.json
msgid "\"Contact!\""
msgstr "«Контакт!»"

#: data/json/speech.json
msgid "\"Contact, enemy in sight!\""
msgstr "«Контакт, вижу противника!»"

#: data/json/speech.json
msgid "\"Target in sight!\""
msgstr "«Наблюдаю цель!»"

#: data/json/speech.json
msgid "\"We've got hostiles!\""
msgstr "«У нас тут враги!»"

#: data/json/speech.json data/json/snippets/schizophrenia.json
msgid "\"What do you think you're doing?\""
msgstr "«Что это ты делаешь?»"

#: data/json/speech.json data/json/snippets/schizophrenia.json
msgid "\"Stop laughing at me!\""
msgstr "«Хватит надо мной смеяться!»"

#: data/json/speech.json data/json/snippets/schizophrenia.json
msgid "\"Stay away from me!\""
msgstr "«Держись от меня подальше!»"

#: data/json/speech.json data/json/snippets/schizophrenia.json
msgid "\"It wasn't my fault!\""
msgstr "«Это была не моя ошибка!»"

#: data/json/speech.json data/json/snippets/schizophrenia.json
msgid "\"They made me do it!\""
msgstr "«Меня заставили это сделать!»"

#: data/json/speech.json data/json/snippets/schizophrenia.json
msgid "\"What are you!?\""
msgstr "«Да кто ты такой?»"

#: data/json/speech.json
msgid "the roar of a chainsaw!"
msgstr "рёв бензопилы!"

#: data/json/speech.json
msgid "a motor sputtering to life!"
msgstr "шипение заведённого двигателя!"

#: data/json/speech.json
msgid "an engine revving up!"
msgstr "рёв запущенного двигателя!"

