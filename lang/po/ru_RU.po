#: data/json/npcs/talk_tags.json
msgid "Sounds like something bad's going on."
msgstr "По звуку, какая-то неприятность."

#: data/json/npcs/talk_tags.json
msgid "Where's the party?"
msgstr "Где тут вечеринка?"

#: data/json/npcs/talk_tags.json
msgid "Sounds like shit's going down."
msgstr "Звучит как будто дерьмо попало на вентилятор."

#: data/json/npcs/talk_tags.json
msgid "I hear something moving - sounded like"
msgstr "Я слышал, как что-то двигалось — похоже на"

#: data/json/npcs/talk_tags.json
