msgstr[1] "кота Девон-рекса"
msgstr[2] "котов Девон-рексов"
msgstr[3] "коты Девон-рекс"

#. ~ Description for Devon Rex cat
#: data/json/monsters/mammal.json
msgid ""
"An unusual-looking cat with strikingly large eyes and ears, sporting a soft "
"curly coat of fur."
msgstr ""
"Кот необычной внешности с большими ушами и глазами, покрытый мягким "
"завивающимся мехом."

#: data/json/monsters/mammal.json
