#: data/json/professions.json
msgctxt "profession_male"
msgid "Pirate"
msgstr "Пират"

#: data/json/professions.json
msgctxt "profession_female"
msgid "Pirate"
msgstr "Пират"

#. ~ Profession (male Pirate) description
#: data/json/professions.json
msgctxt "prof_desc_male"
msgid ""
"Arr!  Your costume may be shipshape, but the end of the world's scuppered "
"all your plans.  Strike up your Jolly Roger and hoist the Bloody Red, for no"
" quarter shall be given."
msgstr ""
"Арр! Может, твой костюм и великолепен, но конец света перечеркнул все твои "
"планы. Поднимай Веселого Роджера и Кроваво-красный флаг, потому что пощады "
"не будет."

#. ~ Profession (female Pirate) description
#: data/json/professions.json
