msgstr[2] "брёвен"
msgstr[3] "бревно"

#. ~ Description for {'str': 'log'}
#: data/json/items/resources/wood.json
msgid ""
"A large chunk of log, cut from a tree.  (a)ctivate a wood axe or wood saw to"
" cut it into planks."
msgstr ""
"Большой кусок бревна, полученный из ствола дерева.  (a)ктивируйте топор или "
"пилу, чтобы распилить его на доски."

#: data/json/items/resources/wood.json
msgid "splintered wood"
msgid_plural "splintered wood"
msgstr[0] "расколотая древесина"
