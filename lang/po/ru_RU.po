msgid_plural "atlatls"
msgstr[0] "атлатль"
msgstr[1] "атлатля"
msgstr[2] "атлатлей"
msgstr[3] "атлатль"

#: data/json/items/ranged/slings.json
msgid ""
"A wooden tool for supporting a javelin, to throw it more effectively than by"
" hand."
msgstr ""
"Деревянное приспособление для метания дротиков с большей эффективностью, "
"нежели руками."

#: data/json/items/ranged/spearguns.json
