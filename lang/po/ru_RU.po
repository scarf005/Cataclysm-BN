msgstr[1] "M1911A1"
msgstr[2] "M1911A1"
msgstr[3] "M1911A1"

#: data/mods/exotic_ammo/gun/38super.json
msgid ""
"The M1911A1 is an extremely popular pistol known for its reliability.  This "
"one is chambered for .38 Super."
msgstr ""
"M1911A1 — чрезвычайно популярный пистолет, знаменитый своей надёжностью. "
"Предназначен для патрона .38 Super."

#: data/mods/exotic_ammo/gun/454.json
msgid "Taurus Raging Bull"
msgid_plural "Taurus Raging Bull"
