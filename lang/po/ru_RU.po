msgstr[1] "тёплых солнечника"
msgstr[2] "тёплых солнечников"
msgstr[3] "тёплые солнечники"

#. ~ Description for {'str': 'warmouth'}
#: data/json/monsters/fish.json
msgid ""
"A warmouth, similar to a rock bass, this small fish is related to the "
"sunfish."
msgstr ""
"Тёплый солнечник, похожая на каменного окуня маленькая рыбка, родственник "
"солнечника."

#: data/json/monsters/fish.json
