#: data/json/professions.json
msgctxt "profession_male"
msgid "Rollerblader"
msgstr "Роллер"

#: data/json/professions.json
msgctxt "profession_female"
msgid "Rollerblader"
msgstr "Роллерша"

#. ~ Profession (male Rollerblader) description
#: data/json/professions.json
msgctxt "prof_desc_male"
msgid ""
"You love to skate!  At least now the grown-ups aren't telling you where you "
"can't roll."
msgstr ""
"Ты любишь кататься на роликах! По крайней мере, теперь взрослые не запретят "
"тебе кататься, где хочется."

#. ~ Profession (female Rollerblader) description
