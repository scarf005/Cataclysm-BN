msgstr "смонтированный M249"

#: data/json/vehicleparts/turret.json
msgid "mounted gatling shotgun"
msgstr "смонтированная картечница Гатлинга"

#: data/json/vehicleparts/turret.json
msgid "mounted pneumatic bolt driver"
msgstr "пневматический болтовёрт (турель)"

#: data/json/vehicleparts/turret.json
msgid "mounted pneumatic assault rifle"
msgstr "установленная пневматическая штурмовая винтовка"

#: data/json/vehicleparts/turret.json
