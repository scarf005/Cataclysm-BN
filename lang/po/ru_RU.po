#: data/json/clothing_mods.json
msgid "Destroy steel padding"
msgstr "Удалить стальные вставки"

#: data/json/clothing_mods.json
msgid "Pad with hard steel"
msgstr "Усилить вставками из закалённой стали"

#: data/json/clothing_mods.json
msgid "Destroy hard steel padding"
msgstr "Удалить вставки из закалённой стали"

#: data/json/clothing_mods.json
msgid "Pad with superalloy"
msgstr "Усилить суперсплавом"

#: data/json/clothing_mods.json
msgid "Destroy superalloy padding"
