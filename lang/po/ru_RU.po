msgstr ""
"Замечен %1$s — безопасный режим включён! %2$s, чтобы его отключить; %3$s, "
"чтобы проигнорировать монстра %4$s."

#: src/game.cpp
#, c-format
msgid "Really step into %s?"
msgstr "Уверены, что хотите зайти в %s?"

#: src/game.cpp
#, c-format
msgid "Your %s refuses to move over that ledge!"
msgstr "Ваш %s отказывается двигаться по этому выступу!"

#: src/game.cpp
msgid "You can't fit there."
msgstr "Вы не поместитесь здесь."

#: src/game.cpp
msgid "Your mount can't fit there."
msgstr "Ваше верховое животное не может сюда поместиться."

#: src/game.cpp
#, c-format
msgid "You cannot move as your %s isn't able to move."
msgstr "Вы не можете двигаться, потому что ваш %s не может двигаться."

#: src/game.cpp
msgid "Can't find grabbed object."
msgstr "Не удаётся найти схваченный объект."

#: src/game.cpp
msgid "You cannot board a vehicle whilst riding."
msgstr "Вы не можете зайти в транспорт верхом."

#: src/game.cpp
#, c-format
msgid "Stepping into that %1$s looks risky.  %2$s"
msgstr "%1$sвыглядит небезопасно для перемещения. %2$s"

#: src/game.cpp
msgid "But you enter anyway."
msgstr "Но вам удаётся войти."

#: src/game.cpp
msgid "Run into it if you wish to enter anyway."
msgstr "Разбегайтесь, если всё же хотите проникнуть внутрь."

#: src/game.cpp
msgid "Crouch and move into it if you wish to enter anyway."
msgstr "Пригнитесь, если всё же хотите проникнуть внутрь."

#: src/game.cpp
msgid "You cannot pass obstacles whilst mounted."
msgstr "Нельзя заходить на препятствия во время езды верхом."

#: src/game.cpp
#, c-format
msgid "Moving onto this %s is slow!"
msgstr "%s замедляет ваше передвижение!"

#: src/game.cpp
#, c-format
msgid "Moving off of this %s is slow!"
msgstr "%s замедляет ваше передвижение!"

#: src/game.cpp
msgid "Your tentacles stick to the ground, but you pull them free."
msgstr "Ваши щупальца присосались к земле, но вы оттянули их обратно."

#: src/game.cpp
msgid "a rattling sound."
msgstr "грохочущий звук."

#: src/game.cpp
#, c-format
msgid "Label here: %s"
msgstr "Метка: %s"

#: src/game.cpp
#, c-format
msgid "The sign says: %s"
msgstr "На знаке написано: %s"

#: src/game.cpp
msgid "There is a sign here, but you are unable to read it."
msgstr "Здесь знак, но вы не можете прочесть, что на нём."

#: src/game.cpp
#, c-format
msgid "Written here: %s"
msgstr "Здесь написано: %s"

#: src/game.cpp
msgid "Something is written here, but you are unable to read it."
msgstr "Здесь что-то написано, но вы не можете прочесть, что именно."

#: src/game.cpp
#, c-format
msgid "You hurt your left foot on the %s!"
msgstr "Вы травмируете левую ступню о %s!"

#: src/game.cpp
#, c-format
msgid "You hurt your right foot on the %s!"
msgstr "Вы травмируете правую ступню о %s!"

#: src/game.cpp
#, c-format
msgid "Your %s gets cut!"
msgstr "Ваш %s был порезан!"

#. ~ 1$s - bodypart name in accusative, 2$s is terrain name.
#: src/game.cpp
#, c-format
msgid "You cut your %1$s on the %2$s!"
msgstr "Вы порезали %1$s об %2$s!"

#: src/game.cpp src/gates.cpp
#, c-format
msgid "You push the %s out of the way."
msgstr "Вы толкаете %s с дороги."

#: src/game.cpp
#, c-format
msgid "There is no room to push the %s out of the way."
msgstr "Вам некуда оттолкнуть с пути %s."

#: src/game.cpp
#, c-format
msgid "You displace the %s."
msgstr "Вы сдвигаете существо (%s)."

#: src/game.cpp
#, c-format
msgid "You cannot move the %s out of the way."
msgstr "Вы не можете отодвинуть %s прочь."

#: src/game.cpp
msgid "There's something here, but you can't see what it is."
msgstr "Здесь что-то есть, но вы не видите, что именно."

#. ~ number of items: "<number> <item>"
#: src/game.cpp
#, c-format
msgid "%1$d %2$s"
msgid_plural "%1$d %2$s"
msgstr[0] "%1$d %2$s"
msgstr[1] "%1$d %2$s"
msgstr[2] "%1$d %2$s"
msgstr[3] "%1$d %2$s"

#: src/game.cpp
#, c-format
msgid "You see here %s."
msgstr "Под ногами %s."

#: src/game.cpp
#, c-format
msgid "You see here %s and %s."
msgstr "Под ногами %s и %s."

#: src/game.cpp
#, c-format
msgid "You see here %s, %s, and %s."
msgstr "Под ногами %s, %s и %s."

#: src/game.cpp
#, c-format
msgid "You see here %s, %s and %d more item."
msgid_plural "You see here %s, %s and %d more items."
msgstr[0] "Вы видите здесь %s, %s и ещё %d предмет."
msgstr[1] "Вы видите здесь %s, %s и ещё %d предмета."
msgstr[2] "Вы видите здесь %s, %s и ещё %d предметов."
msgstr[3] "Вы видите здесь %s, %s и ещё %d предмет."

