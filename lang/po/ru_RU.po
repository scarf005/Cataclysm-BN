msgstr "СЧЁТЧИК ГЕЙГЕРА @ ЗОНА:… СРЕДН %s мЗв/ч."

#: src/computer_session.cpp
#, c-format
msgid "GEIGER COUNTER @ ZONE:… MAX %s mSv/h."
msgstr "СЧЁТЧИК ГЕЙГЕРА @ ЗОНА:… МАКС %s мЗв/ч."

#: src/computer_session.cpp
#, c-format
msgid "GEIGER COUNTER @ CONSOLE:… %s mSv/h."
msgstr "СЧЁТЧИК ГЕЙГЕРА @ КОНСОЛЬ:… %s мЗв/ч."

#: src/computer_session.cpp
#, c-format
msgid "PERSONAL DOSIMETRY:… %s mSv."
msgstr "ДОЗИМЕТРИЯ ПЕРСОНАЛА:… %s мЗв/ч."

#: src/computer_session.cpp
msgid "Conveyor belt malfunction.  Consult maintenance team."
msgstr "Сбой конвейера. Свяжитесь с технической службой."

#: src/computer_session.cpp
msgid "Moving items: PLATFORM --> UNLOADING BAY."
msgstr "Перемещение предметов: ПЛАТФОРМА —> РАЗГРУЗКА."

#: src/computer_session.cpp
msgid "No items detected at: PLATFORM."
msgstr "Не найдено предметов в: ПЛАТФОРМА."

#: src/computer_session.cpp
msgid "Moving items: LOADING BAY --> PLATFORM."
msgstr "Перемещение предметов: ПОГРУЗКА —> ПЛАТФОРМА."

#: src/computer_session.cpp
msgid "No items detected at: LOADING BAY."
msgstr "Не найдено предметов в: ПОГРУЗКА."

#: src/computer_session.cpp
msgid "Conveyor belt cycle complete.  Press any key…"
msgstr "Цикл конвейерной ленты завершён. Нажмите любую клавишу…"

#: src/computer_session.cpp
msgid "Toggling shutters.  Press any key…"
msgstr "Переключение рольставен. Нажмите любую клавишу…"

#: src/computer_session.cpp
msgid "Operation irreversible.  Extract radioactive material?"
msgstr "Необратимая операция. Извлечь радиоактивный материал?"

#: src/computer_session.cpp
msgid "Extraction sequence complete…  Press any key."
msgstr "Процедура извлечения завершена… Нажмите любую клавишу."

#: src/computer_session.cpp
msgid "ERROR!  Radiation platform unresponsive…  Press any key."
msgstr "ОШИБКА! Платформа не отвечает… Нажмите любую клавишу."

#: src/computer_session.cpp
msgid "Initiating POWER-DIAG ver.2.34…"
msgstr "Запуск POWER-DIAG ver.2.34…"

#: src/computer_session.cpp
msgid "Short circuit detected!"
msgstr "Зарегистрировано короткое замыкание!"

#: src/computer_session.cpp
msgid "Short circuit rerouted."
msgstr "Обход короткого замыкания завершён."

#: src/computer_session.cpp
msgid "Fuse reset."
msgstr "Предохранитель переустановлен."

#: src/computer_session.cpp
msgid "Ground re-enabled."
msgstr "Заземление восстановлено."

#: src/computer_session.cpp
#, c-format
msgid "Internal power lines status: 85%% OFFLINE.  Reason: DAMAGED."
msgstr ""
"Статус резервного источника энергии: 85%% ВЫКЛЮЧЕН. Причина: ПОВРЕЖДЕНИЕ."

#: src/computer_session.cpp
#, c-format
msgid ""
"External power lines status: 100%% OFFLINE.  Reason: NO EXTERNAL POWER "
"DETECTED."
msgstr ""
"Статус резервного источника энергии: 100%% ВЫКЛЮЧЕН. Причина: НЕ НАЙДЕН "
"ВНЕШНИЙ ИСТОЧНИК ЭНЕРГИИ."

#: src/computer_session.cpp
msgid "Backup power status: STANDBY MODE."
msgstr "Статус резервного источника энергии: РЕЖИМ ОЖИДАНИЯ."

#: src/computer_session.cpp
msgid "Backup power status: OFFLINE.  Reason: UNKNOWN"
msgstr "Статус резервного источника энергии: ВЫКЛЮЧЕН. Причина: НЕИЗВЕСТНО"

#: src/computer_session.cpp
msgid "The console shuts down."
msgstr "Консоль выключается."

#: src/computer_session.cpp
msgid "Manhacks drop from compartments in the ceiling."
msgstr "Мэнхаки вылетают из отсеков в потолке."

#: src/computer_session.cpp
msgid "Secubots emerge from compartments in the floor."
msgstr "Робохраны поднимаются из люков в полу."

#: src/computer_session.cpp
msgid "The console shocks you."
msgstr "Консоль ударила вас током."

#: src/computer_session.cpp
msgid "You're protected from electric shocks."
msgstr "Вы защищены от электрических разрядов."

#: src/computer_session.cpp
msgid "Your body is damaged by the electric shock!"
msgstr "Вас поразило электричеством!"

#: src/computer_session.cpp
msgid "The pump explodes!"
msgstr "Насос взорвался!"

#: src/computer_session.cpp
msgid "Sewage leaks!"
msgstr "Утечка нечистот!"

#: src/computer_session.cpp
msgid "ERROR: Disruptive Spin"
msgstr "ОШИБКА: Разрушительное Вращение"

#: src/computer_session.cpp
msgid "ERROR: Please use blood-contained samples."
msgstr "ОШИБКА: Пожалуйста, используйте только образцы с кровью."

#: src/computer_session.cpp
msgid "ERROR: Blood draw kit, empty."
msgstr "ОШИБКА: Набор для взятия крови, пустой."

#: src/computer_session.cpp
msgid "ERROR: Blood sample destroyed."
msgstr "ОШИБКА: Образец крови уничтожен."

#: src/computer_session.cpp
msgid "ERROR: ACCESSING DATA MALFUNCTION"
msgstr "ОШИБКА: НАРУШЕН ДОСТУП К ДАННЫМ"

#: src/computer_session.cpp
msgid "ERROR: Data bank destroyed."
msgstr "ОШИБКА: Банк данных уничтожен."

#: src/computer_session.cpp
msgid "SEARCHING FOR NEAREST REFUGEE CENTER, PLEASE WAIT…"
msgstr "ПОИСК БЛИЖАЙШЕГО ЦЕНТРА БЕЖЕНЦЕВ, ПОЖАЛУЙСТА ПОДОЖДИТЕ…"

#. ~555-0164 is a fake phone number in the US, please replace it with a number
#. that will not cause issues in your locale if possible.
#: src/computer_session.cpp
#, c-format
msgid ""
"\n"
"REFUGEE CENTER FOUND!  LOCATION: %d %s\n"
"\n"
"IF YOU HAVE ANY FEEDBACK CONCERNING YOUR VISIT PLEASE CONTACT\n"
"THE DEPARTMENT OF EMERGENCY MANAGEMENT PUBLIC AFFAIRS OFFICE.\n"
"THE LOCAL OFFICE CAN BE REACHED BETWEEN THE HOURS OF 9AM AND\n"
"4PM AT 555-0164.\n"
"\n"
"IF YOU WOULD LIKE TO SPEAK WITH SOMEONE IN PERSON OR WOULD LIKE\n"
"TO WRITE US A LETTER PLEASE SEND IT TO…\n"
msgstr ""
"\n"
"НАЙДЕН ЦЕНТР БЕЖЕНЦЕВ! МЕСТОПОЛОЖЕНИЕ: %d %s\n"
"\n"
"ЕСЛИ У ВАС ЕСТЬ ОТЗЫВ ПО ВАШЕМУ ВИЗИТУ, ПОЖАЛУЙСТА, СВЯЖИТЕСЬ\n"
"С ОФИСОМ ОБЩЕСТВЕННЫХ ДЕЛ ДЕПАРТАМЕНТА ПО ЧРЕЗВЫЧАЙНЫМ СИТУАЦИЯМ.\n"
"С МЕСТНЫМ ОФИСОМ МОЖНО СВЯЗАТЬСЯ С 9:00 И\n"
"ДО 16:00 ПО ТЕЛЕФОНУ 555-0164.\n"
"\n"
"ЕСЛИ ВЫ ХОТИТЕ ПОГОВОРИТЬ С КЕМ-ТО ЛИЧНО ИЛИ\n"
"НАПИСАТЬ НАМ ПИСЬМО, ПОЖАЛУЙСТА ОТПРАВЬТЕ ЕГО…\n"

