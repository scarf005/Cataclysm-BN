msgstr[1] "скидочные карты «Сядь-и-поешь»"
msgstr[2] "скидочных карт «Сядь-и-поешь»"
msgstr[3] "скидочные карты «Сядь-и-поешь»"

#. ~ Description for {'str': 'foodplace loyalty card'}
#: data/json/items/generic.json
msgid ""
"A bright pink loyalty card, all the points are stamped.  This would "
"definitely prove your fidelity to Foodplace, if it still meant anything…"
msgstr ""
"Ярко-розовая карта скидок, все пункты проштампованы. Это определенно "
"доказало бы вашу верность «Сядь-и-поешь», если бы это всё ещё что-то "
"значило…"

#: data/json/items/generic.json
msgid "withered plant"
msgid_plural "withered plants"
msgstr[0] "увядшее растение"
msgstr[1] "увядших растения"
msgstr[2] "увядших растений"
msgstr[3] "увядшее растение"

#. ~ Description for {'str': 'withered plant'}
#: data/json/items/generic.json
msgid ""
"A dead plant.  Good for starting fires or making a pile of leaves to sleep "
"on."
msgstr ""
"Высохшее растение. Хорошо подходит для разведения огня. На куче таких можно "
"спать."

#: data/json/items/generic.json
msgid "fur pelt"
msgid_plural "fur pelts"
msgstr[0] "шкура"
msgstr[1] "шкуры"
msgstr[2] "шкур"
msgstr[3] "шкура"

#. ~ Description for {'str': 'fur pelt'}
#: data/json/items/generic.json
msgid "A small bolt of fur from an animal.  Can be made into warm clothing."
msgstr "Маленький комок меха животных. Используется для пошива тёплой одежды."

#: data/json/items/generic.json
msgid "faux fur pelt"
msgid_plural "faux fur pelts"
msgstr[0] "кусок искусственного меха"
msgstr[1] "куска искусственного меха"
msgstr[2] "кусков искусственного меха"
msgstr[3] "кусок искусственного меха"

#. ~ Description for {'str': 'faux fur pelt'}
#: data/json/items/generic.json
msgid "A small bolt of garishly colored faux fur.  Can be made into clothing."
msgstr ""
"Маленький комок ярко окрашенного искусственного меха. Используется для "
"пошива одежды."

#: data/json/items/generic.json
msgid "leather patch"
msgid_plural "leather patches"
msgstr[0] "кожаный лоскут"
msgstr[1] "кожаных лоскута"
msgstr[2] "кожаных лоскутов"
