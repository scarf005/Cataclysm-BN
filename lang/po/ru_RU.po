#. ~ Remove message for effect(s) 'Hasted'.
#. ~ Remove message for effect(s) 'Slowed'.
#: data/mods/MagicalNights/effects/effects.json
msgid "You return to your normal speed."
msgstr "Ваша скорость возвращается к обычному уровню."

#. ~ Description of effect 'Slowed'.
#: data/mods/MagicalNights/effects/effects.json
msgid "Your speed is magically inhibited."
msgstr ""

#. ~ Apply message for effect(s) 'Slowed'.
#: data/mods/MagicalNights/effects/effects.json
msgid "Everyone else suddenly seems to speed up!"
msgstr ""

#. ~ Description of effect 'Synaptic Stimulation'.
#: data/mods/MagicalNights/effects/effects.json
