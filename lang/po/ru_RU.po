"транспорта, но позволяет смотреть через неё."

#: data/json/vehicleparts/boards.json
msgid "aluminum board"
msgstr "алюминиевый кузов"

#: data/json/vehicleparts/boards.json
msgid "aluminum quarterpanel"
msgstr "алюминиевая боковина"

#: data/json/vehicleparts/boards.json
msgid "stow board"
msgstr "складной кузов"

#. ~ Description for {'str': 'stow board'}
#: data/json/vehicleparts/boards.json
