msgstr "«Лейтенант Хорнблауэр» К.С. Форестера."

#: data/json/items/book/misc.json
msgid "This is a copy of \"Master and Commander\" by Patrick O'Brian."
msgstr "«Мастер и командир» Патрика О'Брайана."

#: data/json/items/book/misc.json
