msgstr[1] "биосилицированной хитиновой брони"
msgstr[2] "биосилицированной хитиновой брони"
msgstr[3] "биосилицированная хитиновая броня"

#. ~ Description for {'str': 'biosilicified chitin armor'}
#: data/json/items/armor/suits_protection.json
msgid ""
"Leg and body armor crafted from the carefully cleaned and pruned "
