#: data/json/vehicleparts/turret.json
msgid "mounted Cerberus laser cannon"
msgstr "установленная лазерная пушка Цербер"

#: data/json/vehicleparts/turret.json
msgid "mounted gatling laser"
msgstr "смонтированный гатлинг-лазер"

#: data/json/vehicleparts/turret.json
msgid "mounted marksman laser"
msgstr "установленный стрелковый лазер"

#: data/json/vehicleparts/turret.json
