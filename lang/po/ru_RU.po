#: data/json/items/battery.json
msgid "heavy plutonium battery"
msgid_plural "heavy plutonium batteries"
msgstr[0] "тяжёлая плутониевая батарейка"
msgstr[1] "тяжёлых плутониевых батарейки"
msgstr[2] "тяжёлых плутониевых батареек"
msgstr[3] "тяжёлая плутониевая батарейка"

#. ~ Description for {'str': 'heavy plutonium battery', 'str_pl': 'heavy
#. plutonium batteries'}
#: data/json/items/battery.json
msgid ""
"This battery uses a thin plutonium-244 and exotic nanocompound from "
"repurposed plutonium fission cells.  It is universally compatible with all "
"kinds of industrial-grade equipment and large tools.  It stores a huge "
"amount of power, but cannot be recharged by external means, instead it "
"steadily self-charges over time."
msgstr ""
"В этой батарейке используется тонкий стержень из плутония-244 для "
"стабилизации экзотического наносоединения, изготовленного из переработанных "
"элементов плутониевого синтеза. Она универсально совместима с оборудованием "
"индустриального класса и большими электроинструментами. Батарейка хранит "
"огромное количество энергии, но её невозможно перезарядить вручную; вместо "
"этого она медленно восстанавливает свой заряд сама по себе."

#: data/json/items/battery.json
msgid "military plutonium fuel cell"
msgid_plural "military plutonium fuel cells"
msgstr[0] "военная плутониевая батарейка"
msgstr[1] "военных плутониевых батареек"
msgstr[2] "военных плутониевых батареек"
msgstr[3] "военные плутониевые батарейки"

#. ~ Description for {'str': 'military plutonium fuel cell'}
#: data/json/items/battery.json
msgid ""
"This battery uses a thin plutonium-244 and exotic nanocompound from "
"repurposed plutonium fission cells.  It was used in military mech-suits, was"
" highly experimental, and had no civilian applications.  It stores a "
"stupendous amount of power, but cannot be recharged by external means, "
"instead it steadily self-charges over time."
msgstr ""
"В этой батарейке используется тонкий стержень из плутония-244 для "
"стабилизации экзотического наносоединения, изготовленного из переработанных "
"элементов плутониевого синтеза. Будучи экспериментальной разработкой, в "
"гражданском секторе никогда не применялась, и была предназначена для военных"
" экзоскелетов. Батарейка хранит огромное количество энергии, но её "
"невозможно перезарядить вручную; вместо этого она медленно восстанавливает "
"свой заряд сама по себе."

