#: data/mods/CrazyCataclysm/crazy_speech.json
msgid "\"Thought you'd seen the last of us, didn't ya?\""
msgstr ""

#: data/mods/CrazyCataclysm/crazy_speech.json
msgid "\"Dang!\""
msgstr ""

#: data/mods/CrazyCataclysm/crazy_speech.json
msgid "\"I thought we fixed that.\""
msgstr ""

#: data/mods/CrazyCataclysm/crazy_speech.json
msgid "\"What's a guy gotta got to do to get some bullets around here?\""
msgstr ""

#: data/mods/CrazyCataclysm/crazy_speech.json
msgid "\"Nope.  Still can't see.\""
msgstr ""

#: data/mods/CrazyCataclysm/crazy_speech.json
msgid "\"Yep.  Still blind.\""
