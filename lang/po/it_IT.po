msgstr[2] ""

#. ~ Description for .117 tipped HP pellets
#: data/mods/CRT_EXPANSION/items/crt_ammo.json
msgid ""
"A medium grain lead pellet tipped with a pointed bit of hard plastic with "
"the purpose of maximum expansion upon hitting a target."
msgstr ""
"Un pallino di piombo con grain medio appuntito con un pezzo di plastica "
"indurita,  per lo scopo di espandersi al massimo una volta colpito il "
"bersaglio."

#: data/mods/CRT_EXPANSION/items/crt_ammo.json
msgid ".117 alloy pellets"
msgid_plural ".117 alloy pelletss"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""

#. ~ Description for .117 alloy pellets
#: data/mods/CRT_EXPANSION/items/crt_ammo.json
msgid ""
"An gimmicky alloy pellet with the purpose of reaching a higher velocity than"
" a normal lead pellet for breaking the sound barrier resulting in an "
"extremely loud crack, not so useful for stealth."
msgstr ""
"Un pallino in lega, con l'espediente di raggiungere una velocità più alta di"
" un normale pallino in piombo per rompere la barriera sonora, risultando in "
"un crepio estrememante rumoroso, non così utile per la furtività."

#: data/mods/CRT_EXPANSION/items/crt_ammo.json
