#: data/mods/CrazyCataclysm/crazy_speech.json
msgid "\"She's probably okay.\""
msgstr ""

#: data/mods/CrazyCataclysm/crazy_speech.json
msgid "\"Noted.\""
msgstr ""

#: data/mods/CrazyCataclysm/crazy_speech.json
msgid "\"But I need to protect the humans!\""
msgstr ""

#: data/mods/CrazyCataclysm/crazy_speech.json
msgid "\"We're back!\""
msgstr ""

#: data/mods/CrazyCataclysm/crazy_speech.json
msgid "\"Hi there!\""
msgstr ""

#: data/mods/CrazyCataclysm/crazy_speech.json
