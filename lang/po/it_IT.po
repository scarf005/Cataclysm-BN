msgstr[1] "coltelli da macellaio"
msgstr[2] "coltelli da macellaio"

#. ~ Description for {'str': 'butcher knife', 'str_pl': 'butcher knives'}
#: data/json/items/melee/knives_kitchen.json
msgid ""
"This is a sharp, heavy knife.  It makes a good melee weapon, and is an ideal"
" item for butchering corpses."
msgstr ""
"Questo è un coltello affilato e pesante. È un'ottima arma, e un oggetto "
"ideale per macellare cadaveri."

#: data/json/items/melee/knives_kitchen.json
msgid "steak knife"
msgid_plural "steak knives"
msgstr[0] "coltello da bistecca"
msgstr[1] "coltelli da bistecca"
msgstr[2] "coltelli da bistecca"

