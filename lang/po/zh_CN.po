msgid "douchebag"
msgstr "二逼"

#: data/json/npcs/talk_tags.json
msgid "dumbass"
msgstr "哈逼"

#: data/json/npcs/talk_tags.json
msgid "dumb <name_b>"
msgstr "死<name_b>"

