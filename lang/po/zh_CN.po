#: data/json/monsters/fish.json
msgid "whitefish"
msgid_plural "whitefish"
msgstr[0] "白鱼"

#. ~ Description for {'str_sp': 'whitefish'}
#: data/json/monsters/fish.json
msgid ""
"A whitefish, closely related to salmon.  One can assume they are just as "
"nice when cooked with smoke."
msgstr "一条白鱼（白鲑），鲑鱼的近亲。你可以认为它们烟熏了之后也一样好吃。"

#: data/json/monsters/fish.json
msgid "largemouth bass"
msgid_plural "largemouth bass"
msgstr[0] "大嘴鲈"

#. ~ Description for {'str_sp': 'largemouth bass'}
#: data/json/monsters/fish.json
msgid "A largemouth bass.  Very popular with sports fishermen."
msgstr "一条大嘴鲈。很受钓鱼爱好者的喜爱。"

#: data/json/monsters/fish.json
msgid "smallmouth bass"
msgid_plural "smallmouth bass"
msgstr[0] "小嘴鲈"

#. ~ Description for {'str_sp': 'smallmouth bass'}
#: data/json/monsters/fish.json
msgid ""
"A smallmouth bass.  Being intolerant to pollution in the water, smallmouth "
"bass are a good indicator of how clean it is."
msgstr "一条小口黑鲈。对于水里的污染很不耐受，小口黑鲈是一个衡量水质清洁的很好指标。"

#: data/json/monsters/fish.json
msgid "striped bass"
msgid_plural "striped bass"
msgstr[0] "条纹鲈"

#. ~ Description for {'str_sp': 'striped bass'}
#: data/json/monsters/fish.json
msgid ""
"A striped bass.  Mostly a salt water fish, they migrate to fresher water to "
"spawn."
msgstr "一只条纹鲈。一般生活在咸水里，它们产卵的时候会游到淡水里。"

#: data/json/monsters/fish.json
msgid "white bass"
msgid_plural "white bass"
msgstr[0] "白鲈"

#. ~ Description for {'str_sp': 'white bass'}
#: data/json/monsters/fish.json
msgid ""
"A white bass.  Common to the region, a slab-sided and spiny-rayed little "
"fish."
msgstr "一条白鲈，体型扁平的多刺小鱼。在这一带很常见。"

#: data/json/monsters/fish.json
msgid "perch"
msgid_plural "perches"
msgstr[0] "河鲈"

#. ~ Description for {'str': 'perch', 'str_pl': 'perches'}
#: data/json/monsters/fish.json
msgid ""
"A small sprightly perch.  A very bony fish, still got some tasty meat on it "
"though."
msgstr "一条活蹦乱跳的小鲈鱼。骨头特多，但肉也还挺好吃的。"

#: data/json/monsters/fish.json
msgid "walleye"
msgid_plural "walleyes"
msgstr[0] "碧古鱼"

#. ~ Description for {'str': 'walleye'}
#: data/json/monsters/fish.json
msgid "A walleye, a green-brown medium-sized fish with a white belly."
msgstr "一条碧古鱼。一种绿褐身体、白色肚腩的中型鱼。"

#: data/json/monsters/fish.json
msgid "sunfish"
msgid_plural "sunfish"
msgstr[0] "太阳鱼"

#. ~ Description for {'str_sp': 'sunfish'}
#: data/json/monsters/fish.json
msgid "A sunfish.  A small fish related to bass or bluegill."
msgstr "一条太阳鱼。一种跟鲈鱼或者蓝鳃太阳鱼关系较近的小鱼。"

#: data/json/monsters/fish.json
msgid "pumpkinseed sunfish"
msgid_plural "pumpkinseed sunfish"
msgstr[0] "驼背太阳鱼"

#. ~ Description for {'str_sp': 'pumpkinseed sunfish'}
#: data/json/monsters/fish.json
msgid "A pumpkinseed sunfish.  A small fish related to bass or bluegill."
msgstr "一条驼背太阳鱼。一种跟鲈鱼或者蓝鳃太阳鱼关系较近的小鱼。"

#: data/json/monsters/fish.json
msgid "bluegill"
msgid_plural "bluegills"
msgstr[0] "蓝鳃太阳鱼"

#. ~ Description for {'str': 'bluegill'}
#: data/json/monsters/fish.json
msgid ""
"A bluegill, an invasive species in Japan.  Commonly gutted and cooked whole."
msgstr "一条蓝鳃太阳鱼，被引进日本后成为当地危险的入侵物种。一般把内脏去掉整条鱼烧了吃。"

#: data/json/monsters/fish.json
msgid "redbreast sunfish"
msgid_plural "redbreast sunfish"
msgstr[0] "红胸太阳鱼"

#. ~ Description for {'str_sp': 'redbreast sunfish'}
#: data/json/monsters/fish.json
msgid "A redbreast sunfish.  A small fish related to bass or bluegill."
msgstr "一条红胸太阳鱼。一种跟鲈鱼或者蓝鳃太阳鱼关系较近的小鱼。"

#: data/json/monsters/fish.json
