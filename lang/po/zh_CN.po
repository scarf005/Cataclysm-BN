#: data/mods/CRT_EXPANSION/martial/generaltechn.json
msgid "TEAR"
msgstr "撕裂"

#: data/mods/CRT_EXPANSION/martial/generaltechn.json
msgid "Crit only, 110% Cut, 115% Stab, min melee 2"
