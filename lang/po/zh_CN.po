msgstr "一个用管子加工而来的折叠轻质车架。"

#: data/json/items/vehicle/frames.json
msgid "extra-light frame"
msgid_plural "extra-light frames"
msgstr[0] "超轻车架"

#. ~ Description for {'str': 'extra-light frame'}
