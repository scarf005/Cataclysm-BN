msgstr "阿尔伯塔龙巢"

#. ~ Description for {'str': 'albertosaurus nest'}
#: data/mods/DinoMod/overmap/map_extras.json
msgid "An albertosaurus nest."
msgstr "一个阿尔伯塔龙巢。"

#: data/mods/DinoMod/overmap/map_extras.json
msgid "allosaurus nest"
msgstr "异特龙巢"

#. ~ Description for {'str': 'allosaurus nest'}
#: data/mods/DinoMod/overmap/map_extras.json
msgid "An allosaurus nest."
msgstr "一个异特龙巢。"

#: data/mods/DinoMod/overmap/map_extras.json
msgid "anchisaurus nest"
msgstr "近蜥龙巢"

#. ~ Description for {'str': 'anchisaurus nest'}
#: data/mods/DinoMod/overmap/map_extras.json
msgid "An anchisaurus nest."
