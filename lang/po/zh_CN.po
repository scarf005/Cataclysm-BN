#: data/json/professions.json
msgctxt "profession_male"
msgid "Pilot"
msgstr "飞行员"

#: data/json/professions.json
msgctxt "profession_female"
msgid "Pilot"
msgstr "飞行员"

#. ~ Profession (male Pilot) description
#: data/json/professions.json
msgctxt "prof_desc_male"
msgid ""
"You’ve spent years in the cockpit, guiding passengers, cargo, or your own "
"craft through the skies. The Cataclysm has grounded you, but the thrill of "
"flight still calls…"
msgstr "你曾在驾驶舱里度过数年，驾驶着客机、货机或你自己的飞机翱翔天际。大灾变让你停飞了，但飞行的快感仍在呼唤着你……"

