msgid_plural "sealed sauropod stomachs"
msgstr[0] "蜥脚恐龙胃囊水袋"

#. ~ Description for {'str': 'sealed sauropod stomach'}
#: data/mods/DinoMod/items/containers.json
msgid ""
"The stomach of a sauropod, cleaned and sealed with strings.  It can hold 6 "
"liters of water."
msgstr "一只巨型蜥脚恐龙的胃囊，清洗干净之后用绳子扎好。可以装6L的水。"

#: data/mods/DinoMod/items/egg.json
msgid "dinosaur egg"
msgid_plural "dinosaur eggs"
msgstr[0] "恐龙蛋"

#. ~ Description for dinosaur egg
#: data/mods/DinoMod/items/egg.json
msgid "Pale, round egg laid by a dinosaur."
msgstr "一颗苍白的圆形恐龙蛋。"

#: data/mods/DinoMod/items/egg.json
msgid "small dinosaur egg"
msgid_plural "small dinosaur eggs"
msgstr[0] "小型恐龙蛋"

#. ~ Description for small dinosaur egg
