msgstr "一块能够储存电能的电池，并能够为车上的各类电子设备提供电力。"

#: data/json/vehicleparts/battery.json
msgid "motorbike battery, small"
msgstr "摩托车电池（小型）"

#: data/json/vehicleparts/battery.json
msgid "swappable very large storage battery"
msgstr "可更换超大容量蓄电池"

#. ~ Description for {'str': 'swappable very large storage battery'}
#. ~ Description for {'str': 'swappable large storage battery'}
