msgstr "\"电影怎么样？\""

#: data/json/speech.json
msgid "\"How was your trip?\""
msgstr "\"你的旅行怎么样？\""

#: data/json/speech.json
msgid "\"How's it going?\""
msgstr "\"怎么样了？\""

#: data/json/speech.json
msgid "\"See you later.\""
msgstr "\"再见！\""

#: data/json/speech.json
msgid "\"See you tonight.\""
msgstr "\"今晚见！\""

#: data/json/speech.json
msgid "\"I got this weird rash a few days ago.\""
msgstr "\"我前几天得了奇怪的皮疹\""

#: data/json/speech.json
msgid "\"Let me have a look at it.\""
msgstr "\"让我们看看。\""

#: data/json/speech.json
msgid "\"When did you find out?\""
msgstr "\"你什么时候发现的？\""

#: data/json/speech.json
msgid "\"Seven o'clock.\""
msgstr "\"七点整。\""

#: data/json/speech.json
msgid "\"Nobody is helping us.\""
msgstr "\"没有人会来帮助我们。\""

#: data/json/speech.json
msgid "\"We're on our own.\""
msgstr "\"我们只能靠自己。\""

#: data/json/speech.json
msgid "\"We're all alone.\""
msgstr "\"我们完了。\""

#: data/json/speech.json
msgid "\"We should split into groups of two each.\""
msgstr "\"我们要各分两组。\""

#: data/json/speech.json
msgid "\"It can't follow all of us.\""
msgstr "\"它不可能跟着我们所有的人。\""

#: data/json/speech.json
msgid "\"Be careful out there.\""
msgstr "\"外出小心。\""

#: data/json/speech.json data/mods/CrazyCataclysm/crazy_speech.json
msgid "\"There you are.\""
msgstr "\"你在这儿啊。\""

