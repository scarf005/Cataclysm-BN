#: data/json/items/armor/power_armor.json
msgid "power armor helmet"
msgid_plural "power armor helmets"
msgstr[0] "动力装甲头盔"

#. ~ Use action msg for {'str': 'power armor helmet'}.
#. ~ Use action msg for {'str': 'heavy power armor helmet'}.
#. ~ Use action msg for {'str': 'light power armor helmet'}.
#: data/json/items/armor/power_armor.json
msgid "The %s seals shut and beeps once."
msgstr "%s关闭并发出一声蜂鸣声。"

#. ~ Description for {'str': 'power armor helmet'}
#. ~ Description for {'str': 'power armor helmet (active)', 'str_pl': 'power
#. armor helmets (active)'}
#: data/json/items/armor/power_armor.json
msgid ""
"A fully enclosed combat helmet for hazardous environments, this was designed"
" to fit with a powered exoskeleton, using cameras to expand visual range.  "
"In practice, the cameras were unreliable and easily fouled.  The "
"environmental controls function best with direct-skin contact."
msgstr ""
"一个全覆盖式的危险环境防护作战头盔，设计与动力外骨骼一同使用，使用内置相机扩大视野范围。实地测试时发现，内置相机可靠性较差，而且很容易被欺骗。环境防护功能需要直接接触皮肤才能更好生效。"

#: data/json/items/armor/power_armor.json
msgid "power armor helmet (active)"
msgid_plural "power armor helmets (active)"
msgstr[0] "动力装甲头盔（开启）"

#. ~ Use action msg for {'str': 'power armor helmet (active)', 'str_pl':
#. 'power armor helmets (active)'}.
#. ~ Use action msg for {'str': 'heavy power armor helmet (active)', 'str_pl':
#. 'heavy power armor helmets (active)'}.
#. ~ Use action msg for {'str': 'light power armor helmet (active)', 'str_pl':
