#: data/mods/MagicalNights/items/class_items.json
msgid "Stormshaper rune"
msgid_plural "Stormshaper runes"
msgstr[0] "风暴塑造者符文"

#. ~ Description for {'str': 'Stormshaper rune'}
#: data/mods/MagicalNights/items/class_items.json
