#: data/json/professions.json
msgctxt "profession_male"
msgid "Crazy Cat Dude"
msgstr "猫奴"

#: data/json/professions.json
msgctxt "profession_female"
msgid "Crazy Cat Lady"
msgstr "猫奴"

#. ~ Profession (male Crazy Cat Dude) description
#: data/json/professions.json
msgctxt "prof_desc_male"
msgid ""
"Everyone is dead?  Well, it doesn't matter… your cats are all the friends "
"you need!"
msgstr "所有人都死了？随他便吧……只要有猫猫可以吸就够了！"

