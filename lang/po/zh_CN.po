msgstr "锡制餐盘，轻巧而紧凑。"

#: data/json/items/generic/dining_kitchen.json
msgid "tin cup"
msgid_plural "tin cups"
msgstr[0] "锡杯"

#. ~ Description for {'str': 'tin cup'}
