msgstr "一套用来蒸发制冷剂的细长蛇形管。"

#: data/json/items/generic.json
msgid "condenser coil"
msgid_plural "condenser coils"
msgstr[0] "冷凝器"

#. ~ Description for {'str': 'condenser coil'}
