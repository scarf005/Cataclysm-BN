msgstr "一个中型锡制罐子，就是装汤水的那种。这个已经被打开而且没法简单的重新密封。"

#: data/json/items/containers.json
msgid "plastic canteen"
msgid_plural "plastic canteens"
msgstr[0] "军用水壶"

#. ~ Description for {'str': 'plastic canteen'}
#: data/json/items/containers.json
msgid ""
