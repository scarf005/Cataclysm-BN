#: src/consumption.cpp
#, c-format
msgid "<npcname> digests %d %s and recharges %d point of energy."
msgid_plural "<npcname> digests %d %s and recharges %d points of energy."
msgstr[0] "<npcname>消化了%d个%s，并将其转化成了 %d 点能量。"

#: src/consumption.cpp
#, c-format
msgid "You digest your %s and recharge %d point of energy."
