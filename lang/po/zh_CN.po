msgid "\"It's faster than us.\""
msgstr "\"它比我们快。\""

#: data/json/speech.json
msgid "\"It's looking right at us.\""
msgstr "\"它正看着我们。\""

#: data/json/speech.json
msgid "\"It's heading right for us!\""
msgstr "\"它正在向我们这边过来！\""

#: data/json/speech.json
msgid "\"Can you swim?\""
msgstr "\"你会游泳吗？\""

#: data/json/speech.json
msgid "\"Don't do that.\""
msgstr "\"别那样做！\""

#: data/json/speech.json
msgid "\"You hear that?\""
msgstr "\"你听到了吗？\""

#: data/json/speech.json
msgid "\"Be quiet.\""
msgstr "\"安静！\""

#: data/json/speech.json
msgid "\"Look out!\""
msgstr "\"小心！\""

#: data/json/speech.json
msgid "\"Run!\""
msgstr "\"跑！\""

#: data/json/speech.json
msgid "\"Hurry!\""
msgstr "\"快点！\""

#: data/json/speech.json
msgid "\"No!\""
msgstr "\"不！\""

#: data/json/speech.json
msgid "\"I'll never forget you.\""
msgstr "\"我永远不会忘记你的。\""

#: data/json/speech.json
msgid "\"Take his gun, we're going to need it.\""
msgstr "\"拿着这把枪，我们可能会用到。\""

#: data/json/speech.json
msgid "\"How do we get out of here?\""
msgstr "\"我们怎么出去？\""

#: data/json/speech.json
msgid "\"This place is like a maze.\""
msgstr "\"这地方像个迷宫。\""

#: data/json/speech.json
msgid "\"Oh God, I'm the only one left.\""
msgstr "\"天哪！我是唯一剩下的。\""

#: data/json/speech.json
msgid "\"Please, I don't want to die.\""
msgstr "\"求求你，我不想死。\""

#: data/json/speech.json
msgid "\"Mom.\""
msgstr "\"妈妈。\""

#: data/json/speech.json
msgid "\"Mom, I miss you.\""
msgstr "\"妈妈，我想你。\""

#: data/json/speech.json
msgid "\"Me go, you stay.\""
msgstr "\"我走，你留。\""

#: data/json/speech.json
msgid "\"Please, God.\""
msgstr "\"求你了，上帝啊。\""

#: data/json/speech.json
msgid "a gurgling sound."
msgstr "潺潺的水声。"

#: data/json/speech.json
