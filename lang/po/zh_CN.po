#: data/mods/MagicalNights/items/black_dragon_items.json
msgid "pair of black dragonscale gauntlets"
msgid_plural "pairs of black dragonscale gauntlets"
msgstr[0] "黑龙鳞护手"

#. ~ Description for {'str': 'pair of black dragonscale gauntlets', 'str_pl':
