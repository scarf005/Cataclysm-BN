msgstr "%sを食べた。"

#: src/consumption.cpp
msgid "The shadows are getting ever closer."
msgstr "影がどんどん近づいてきた。"

#: src/consumption.cpp
msgid "You have a bad feeling about this."
msgstr "嫌な気分になった。"

