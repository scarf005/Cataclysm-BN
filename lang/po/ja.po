#: src/monattack.cpp
#, c-format
msgid "The %1$s's head hits <npcname>'s %2$s, but glances off armor!"
msgstr "%1$sが<npcname>の頭の%2$sを攻撃したが、跳ね返された！"

#: src/monattack.cpp
msgid "He's brandishing a knife!"
msgstr "彼が刀を振るう！"

#: src/monattack.cpp
msgid "Quiet, quiet"
msgstr "静かに、静かに"

#: src/monattack.cpp
msgid "a terrifying roar!"
msgstr "恐ろしい咆哮！"

#: src/monattack.cpp
#, c-format
msgid "%1$s swings a massive claw at %2$s!"
msgstr "%1$sが%2$sに向かって巨大な爪を振り下ろす！"

#. ~ 1$s is bodypart name, 2$d is damage value.
#: src/monattack.cpp
#, c-format
