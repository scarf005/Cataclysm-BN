#: data/json/items/comestibles/mushroom.json
#: data/json/items/comestibles/seed.json data/json/obsoletion/items.json
msgid "mushroom"
msgid_plural "mushrooms"
msgstr[0] "キノコ"

#. ~ Description for mushroom
