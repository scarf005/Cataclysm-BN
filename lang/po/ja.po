msgid "World Mods"
msgstr "世界Mod"

#: src/worldfactory.cpp
msgid "World Options"
msgstr "世界の設定"

#: src/worldfactory.cpp
msgid "Finalize World"
msgstr "世界を確定する"

#: src/worldfactory.cpp
msgid "World name cannot be empty!"
msgstr "世界名を空白にできない！"

#: src/worldfactory.cpp
#, c-format
msgid "%s is a reserved name!"
msgstr "%s は予約済みの名前！"

#: src/worldfactory.cpp
#, c-format
msgid "A world named %s already exists!"
msgstr "%s の世界はすでに存在する！"

