#. ~ Description for {'str': 'wool pillow'}
#: data/json/items/generic.json
msgid ""
"A pillow to rest your head on when sleeping.  This one is made entirely of "
"fluffy wool!"
msgstr "睡眠時に頭を乗せる枕。すべてがふわふわのウールでできている！"

#: data/json/items/generic.json
msgid "Kevlar plate"
msgid_plural "Kevlar plates"
msgstr[0] "ケブラー補強板"

#. ~ Description for {'str': 'Kevlar plate'}
#: data/json/items/generic.json
