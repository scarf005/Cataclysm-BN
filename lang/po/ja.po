#. ~ Name for scenario 'Challenge - Abandoned' for a male character
#: data/json/scenarios.json
msgctxt "scenario_male"
msgid "Challenge - Abandoned"
msgstr "挑戦 - 置いてけぼり"

#. ~ Name for scenario 'Challenge - Abandoned' for a female character
