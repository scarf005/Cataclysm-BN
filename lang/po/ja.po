msgid_plural "sword canes"
msgstr[0] "杖剣"

#. ~ Description for {'str': 'sword cane'}
#: data/json/items/melee/swords_and_blades.json
msgid "A sword with a thin blade designed to be hidden inside a hollow cane."
msgstr "杖の内部を空洞化し、薄い刃を隠し持ったもの。"

#: data/json/items/melee/swords_and_blades.json
msgid "broadsword"
msgid_plural "broadswords"
msgstr[0] "ブロードソード"

#. ~ Description for {'str': 'broadsword'}
#: data/json/items/melee/swords_and_blades.json
msgid ""
"This is an early modern sword seeing use in the 16th, 17th, and 18th "
"centuries.  Called 'broad' to contrast with the slimmer rapiers."
