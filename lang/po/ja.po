msgid_plural "shady allosaurus zombies"
msgstr[0] "冥暗ゾンビアロサウルス"

#. ~ Description for {'str': 'shady allosaurus zombie'}
#. ~ Description for {'str': 'shady acrocanthosaurus zombie'}
#. ~ Description for {'str': 'shady siats zombie'}
#. ~ Description for {'str_sp': 'acrocanthosaurus nightstalker'}
#: data/mods/DinoMod/monsters/zinosaur_upgrade.json
msgid ""
