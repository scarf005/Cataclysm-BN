msgstr "設定したターン数後に、サイドバーログからメッセージが削除される。「0」に設定すると無効になる。"

#: src/options.cpp
msgid "Message cooldown"
msgstr "メッセージクールタイム"

#: src/options.cpp
msgid ""
"Number of turns during which similar messages are hidden.  '0' disables this"
