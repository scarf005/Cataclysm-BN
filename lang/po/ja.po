#: src/monattack.cpp
#, c-format
msgid "The %1$s lunges at <npcname>'s %2$s, battering it for %3$d damage!"
msgstr "%1$sが<npcname>の%2$sに飛びかかり、強い衝撃を受け%3$dのダメージを負った！"

#: src/monattack.cpp
#, c-format
msgid "The %1$s lunges at your %2$s, but your armor prevents injury!"
msgstr "%1$sが%2$sに飛びかかったが、跳ね返された！"

#: src/monattack.cpp
#, c-format
msgid "The %1$s lunges at <npcname>'s %2$s, but their armor prevents injury!"
msgstr "%1$sが<npcname>の%2$sに飛びかかったが、跳ね返された！"

#: src/monattack.cpp
#, c-format
msgid "The %1$s thrusts a claw at you, but it bounces off the %2$s!"
msgstr "%1$sが爪で突いたが、%2$sに弾かれた！"

#: src/monattack.cpp
#, c-format
msgid "The %1$s thrusts a claw at <npcname>, but it bounces off the %2$s!"
msgstr "%1$sが爪で<npcname>を突いたが、%2$sに弾かれた！"

#: src/monattack.cpp
#, c-format
msgid "The %s thrusts a claw at you, but you evade it!"
msgstr "%sが爪で突いたが、かわされた！"

#: src/monattack.cpp
#, c-format
msgid "The %s thrusts a claw at <npcname>, but they evade it!"
msgstr "%sが爪で<npcname>を突いたが、かわされた！"

#. ~ 1$s is bodypart name, 2$d is damage value.
#: src/monattack.cpp
#, c-format
msgid "The %1$s thrusts a claw at your %2$s, slashing it for %3$d damage!"
msgstr "%1$sが%2$sを爪で突き、%3$dのダメージを与えた！"

#. ~ 1$s is bodypart name, 2$d is damage value.
#: src/monattack.cpp
#, c-format
msgid ""
"The %1$s thrusts a claw at <npcname>'s %2$s, slashing it for %3$d damage!"
msgstr "%1$sが<npcname>の%2$sを爪で突き、%3$dのダメージを与えた！"

#: src/monattack.cpp
#, c-format
msgid "The %1$s thrusts a claw at your %2$s, but glances off your armor!"
msgstr "%1$sが%2$sを爪で突いたが、跳ね返された！"

#: src/monattack.cpp
#, c-format
msgid "The %1$s thrusts a claw at <npcname>'s %2$s, but glances off armor!"
