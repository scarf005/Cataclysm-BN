#: data/json/speech.json
msgid "Are you my mommy?"
msgstr "あなたが、お母さんなの？"

#: data/json/speech.json
msgid "Oh, how fun!"
msgstr "あぁ、楽しい！"

#: data/json/speech.json
msgid "You're my best friend!"
msgstr "君はいちばんの友達！"

#: data/json/speech.json
msgid "Heehee!"
msgstr "へへへっ！"

#: data/json/speech.json
msgid "Let's have fun!"
msgstr "楽しくいこう！"

#: data/json/speech.json
msgid "Let's have a tea party!"
msgstr "お茶会をしよう！"

#: data/json/speech.json
msgid "You're the best!"
msgstr "あなたが、いちばんいいの！"

#: data/json/speech.json
msgid "You shouldn't have done that."
