#: data/json/professions.json
msgctxt "profession_male"
msgid "Electrician"
msgstr "配線工"

#: data/json/professions.json
msgctxt "profession_female"
msgid "Electrician"
msgstr "配線工"

#. ~ Profession (male Electrician) description
#: data/json/professions.json
msgctxt "prof_desc_male"
msgid ""
"You used to work for some small-time business owners doing minor electrical "
"work, and were on your way to another trivial job when the Cataclysm struck."
"  The power's out, but if you survive long enough you might be able to "
"improvise."
msgstr ""
"以前、小さな事業主のもとで軽い電気工事をしていた。大災厄が起きたときも、別の些細な仕事に向かう途中だった。電気は止まっているが、長く生き延びられれば、何とか工夫できるかもしれない。"

#. ~ Profession (female Electrician) description
#: data/json/professions.json
msgctxt "prof_desc_female"
msgid ""
"You used to work for some small-time business owners doing minor electrical "
"work, and were on your way to another trivial job when the Cataclysm struck."
"  The power's out, but if you survive long enough you might be able to "
"improvise."
msgstr ""
