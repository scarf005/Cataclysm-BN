#: data/mods/DinoMod/monsters/zinosaur_upgrade.json
msgid "shady dryptosaurus zombie"
msgid_plural "shady dryptosaurus zombies"
msgstr[0] "冥暗ゾンビドリプトサウルス"

#. ~ Description for {'str': 'shady dryptosaurus zombie'}
#: data/mods/DinoMod/monsters/zinosaur_upgrade.json
msgid ""
"An uncanny shadow envelops this creature.  You can make out the outline of a"
