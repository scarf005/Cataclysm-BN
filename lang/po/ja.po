msgstr "自動メモ"

#: src/options.cpp
msgid "If true, automatically sets notes"
msgstr "この設定を有効にすると、地図に自動的にメモを残す。"

#: src/options.cpp
msgid "Auto notes (stairs)"
msgstr "自動メモ (階段)"

#: src/options.cpp
msgid ""
"If true, automatically sets notes on places that have stairs that go up or "
"down"
msgstr "この設定を有効にすると、階段がある場所に自動的にメモを残す。"

#: src/options.cpp
msgid "Auto notes (map extras)"
msgstr "自動メモ (特異な地域)"

