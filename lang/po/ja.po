#: data/mods/rpg_system/main.lua
msgid ""
"Affects class bonuses and periodic effects. Things that don't scale with "
"level are unaffected."
msgstr "クラスボーナスや定期的な効果に影響を与える。レベルに応じてスケールしないものには影響しない。"

#: data/mods/rpg_system/main.lua
msgid "Does not affect assigned stats."
msgstr "割り当て済みのステータスには影響しない。"

#: data/mods/rpg_system/main.lua
#, c-format
msgid "0% (Disable scaling)"
msgstr "0% (倍率を無効化)"

#: data/mods/rpg_system/main.lua
msgid "Disables all level-based class bonuses and periodic effects."
msgstr "レベルに基づくクラスボーナスと定期的な効果をすべて無効にする。"

#: data/mods/rpg_system/main.lua
#, c-format
msgid "50% (Half power)"
msgstr "50% (半分)"

#: data/mods/rpg_system/main.lua
msgid "Half effectiveness for balanced gameplay."
msgstr "バランスの取れたゲームプレイのために効果が半減される。"

#: data/mods/rpg_system/main.lua
#, c-format
msgid "100% (Full power)"
msgstr "100% (最大)"

#: data/mods/rpg_system/main.lua
msgid "Default intended [System] experience."
msgstr "初期設定[システム]経験値。"

#: data/mods/rpg_system/main.lua
