msgstr "肌の色:薄め"

#. ~ Description for {'str': 'Skin tone: light'}
#: data/json/mutations/mutation_appearance.json
msgid "You have a light peach skin tone."
msgstr "肌の色は薄い桃色だ。"

#: data/json/mutations/mutation_appearance.json
msgid "Skin tone: light brown"
