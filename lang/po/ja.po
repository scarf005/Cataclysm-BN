#: data/json/professions.json
msgctxt "profession_male"
msgid "Boxer"
msgstr "ボクサー"

#: data/json/professions.json
msgctxt "profession_female"
msgid "Boxer"
msgstr "ボクサー"

#. ~ Profession (male Boxer) description
#: data/json/professions.json
msgctxt "prof_desc_male"
msgid ""
"You were training for the fight of your life before the Cataclysm struck.  "
"Now you fight just to keep yourself alive."
msgstr "大災厄が起きる前、人生最大の戦いに備えて訓練を重ねてきた。今、あなたが戦うのは、ただ生き延びるためだけだ。"

#. ~ Profession (female Boxer) description
#: data/json/professions.json
