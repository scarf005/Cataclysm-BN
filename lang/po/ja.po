msgid "whirrrrrclick."
msgstr "ウィーーーーーンカチッ。"

#: src/monattack.cpp
msgid "clank!"
msgstr "ガチャン！"

#: src/monattack.cpp
#, c-format
msgid "The %s's 120mm cannon fires!"
msgstr "%sが120mm砲を発射した！"

#: src/monattack.cpp
#, c-format
msgid "The tongue of flame hits the %s!"
msgstr "炎の渦が%sを飲み込む！"

#: src/monattack.cpp
msgid "a robotic voice boom, \"Citizen, Halt!\""
msgstr "[機械音声]「止まれ、市民！」"

#: src/monattack.cpp
msgid "a robotic voice boom, \"Please put down your weapon.\""
msgstr "[機械音声]「手にある武器を捨てろ。」"

#: src/monattack.cpp
msgid "a robotic voice boom, \"Come out with your hands up!\""
msgstr "[機械音声]「手を上げて、こちらへ出てこい！」"

#: src/monattack.cpp
msgid "a police siren, whoop WHOOP"
msgstr "[警察のサイレン] ウィーッ ウィーッ"

#: src/monattack.cpp
msgid "\"YOU… ARE FILTH…\""
msgstr "「お前は…ゴミだ…」"

#: src/monattack.cpp
msgid "\"VERMIN… YOU ARE VERMIN…\""
msgstr "「害虫…害虫よ.」"

#: src/monattack.cpp
msgid "\"LEAVE NOW…\""
msgstr "「すぐに立ち去れ…」"

#: src/monattack.cpp
msgid "\"WE… WILL FEAST… UPON YOU…\""
msgstr "「我々は…お前を…喰らい尽くす…」"

#: src/monattack.cpp
msgid "\"FOUL INTERLOPER…\""
msgstr "「汚らわしき侵入者よ…」"

#. ~ %1$s is the name of the zombie upgrading the other, %2$s is the zombie
#. being upgraded.
#: src/monattack.cpp
#, c-format
msgid "A black mist floats from the %1$s around the %2$s."
msgstr "%1$sから漏れ出た黒い霧が%2$sを包み込む。"

#: src/monattack.cpp
#, c-format
msgid "A black mist floats from the %s."
msgstr "%sから黒い霧が流れ出る。"

#. ~ %1$s is the pre-upgrade monster, %2$s is the post-upgrade monster.
#: src/monattack.cpp
#, c-format
msgid "The %1$s becomes a %2$s!"
msgstr "%1$sは%2$sへと変化した！"

#: src/monattack.cpp
#, c-format
msgid "The %s vanishes!"
msgstr "%sが消えた！"

#: src/monattack.cpp
#, c-format
msgid "A %s appears!"
msgstr "%sが現れた！"

#: src/monattack.cpp src/turret.cpp
#, c-format
msgid "%s points in your direction."
msgstr "%sがあなたを見つめる。"

#: src/monattack.cpp src/mondefense.cpp
msgid "You feel intensely hated for a moment."
msgstr "一瞬、憎まれているような気がする。"

#: src/monattack.cpp src/mondefense.cpp
msgid "You feel an angry presence."
msgstr "怒りに満ちた存在感が感じ取れる。"

#: src/monattack.cpp
#, c-format
msgid "The %1$s stretches its head at you, but bounces off the %2$s"
msgstr "%1$sが頭を伸ばして攻撃したが、%2$sに弾かれた。"

#: src/monattack.cpp
#, c-format
msgid "The %1$s stretches its head at <npcname>, but bounces off the %2$s"
msgstr "%1$sが頭を伸ばして <npcname>,を攻撃したが、%2$sに弾かれた。"

#: src/monattack.cpp
#, c-format
msgid ""
"The %s's head extends to bite you, but you dodge and the head sails past!"
msgstr "%sの頭が伸びて噛みつかんとしたが、かわしてやり過ごした！"

#: src/monattack.cpp
#, c-format
msgid ""
"The %s's head extends to bite <npcname>, but they dodge and the head sails "
"past!"
msgstr "%sの頭が伸びて<npcname>を噛みつかんとしたが、かわしてやり過ごした！"

#. ~ 1$s is monster name, 2$s bodypart in accusative
#: src/monattack.cpp
#, c-format
msgid "The %1$s's teeth sink into your %2$s!"
msgstr "%1$sの歯が%2$sに食い込む！"

#. ~ 1$s is monster name, 2$s bodypart in accusative
#: src/monattack.cpp
#, c-format
msgid "The %1$s's teeth sink into <npcname>'s %2$s!"
