"    <color_light_green>%s</color> takes you to the next tab.\n"
"    <color_light_green>%s</color> returns you to the main menu."
msgstr ""
"    <color_light_green>%s</color>/ <color_light_green>%s</color>キーで能力値を選択する。\n"
"    <color_light_green>%s</color>キーで能力値を上げる。\n"
