msgid "abstract electric well pump"
msgstr ""

#: data/json/furniture_and_terrain/furniture-plumbing.json
msgid "electric well pump (off)"
msgstr ""

#. ~ Description for electric well pump (off)
#: data/json/furniture_and_terrain/furniture-plumbing.json
msgid "An electric well pump connected to a fluid grid.  It is switched off."
msgstr ""

#: data/json/furniture_and_terrain/furniture-plumbing.json
msgid "Switch on the electric well pump."
msgstr ""

#. ~ Message for furniture 'electric well pump (off)'
#: data/json/furniture_and_terrain/furniture-plumbing.json
msgid "You switch on the electric well pump."
