msgid_plural "The window will be %d pixels wide with the selected value."
msgstr[0] "ウィンドウの選択された値の幅が %d ピクセルになる。"

#: src/options.cpp
#, c-format
msgid "The window will be %d pixel tall with the selected value."
msgid_plural "The window will be %d pixels tall with the selected value."
msgstr[0] "ウィンドウの選択された値の高さが %d になる。"

