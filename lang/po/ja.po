#: src/worldfactory.cpp
msgid "________NO NAME ENTERED!________"
msgstr "______名前が入力されていない！______"

#: src/worldfactory.cpp
msgid "Are you SURE you're finished?  World name will be randomly generated."
msgstr "本当に終わるか？世界名はランダムに生成される。"

#: src/worldfactory.cpp
#, c-format
msgid ""
"[<color_yellow>%s</color>] = save <color_cyan>Mod Load Order</color> as "
"default"
msgstr "[<color_yellow>%s</color>] = <color_cyan>Mod読み込み順 をデフォルトとして保存</color>"

#: src/worldfactory.cpp
#, c-format
msgid "[<color_yellow>%s</color>/<color_yellow>%s</color>] = switch Main-Tab"
msgstr "[<color_yellow>%s</color>/<color_yellow>%s</color>] = メインタブを切り替え"

#: src/worldfactory.cpp
#, c-format
msgid ""
"[<color_yellow>%s</color>/<color_yellow>%s</color>] = switch <color_cyan>Mod"
" List</color> and <color_cyan>Mod Load Order</color>"
msgstr ""
"[<color_yellow>%s</color>/<color_yellow>%s</color>] = "
"<color_cyan>Modリスト</color> と <color_cyan>Mod読み込み順 を切り替え</color>"

#: src/worldfactory.cpp
#, c-format
msgid ""
"[<color_yellow>%s</color>/<color_yellow>%s</color>] = switch <color_cyan>Mod"
" List</color> Tab"
msgstr ""
"[<color_yellow>%s</color>/<color_yellow>%s</color>] = <color_cyan>Mod一覧 "
"タブを切り替え</color>"

#: src/worldfactory.cpp
#, c-format
msgid "[<color_yellow>%s</color>] = keybindings"
msgstr "[<color_yellow>%s</color>] = キー割当設定"

