#: data/json/npcs/talk_tags.json
msgid "It can't follow all of us.  I'll run this way, you go there!"
msgstr "そいつは全員を追えない。俺はこっちに走る、お前はあっちに行け！"

#: data/json/npcs/talk_tags.json
msgid "Me go, you stay."
msgstr "俺は行く、お前はここにいろ。"

#: data/json/npcs/talk_tags.json
msgid "Not that way!  Go left!"
msgstr "そっちじゃない！左に行け！"

#: data/json/npcs/talk_tags.json
msgid "<move>!"
msgstr "<move>！"

#: data/json/npcs/talk_tags.json
msgid "Retreat!  Retreat!"
msgstr "退却！退却！"

#: data/json/npcs/talk_tags.json
msgid "Book it!"
msgstr "走れ！"

#: data/json/npcs/talk_tags.json
msgid "Leg it!"
msgstr "逃げろ！"

#: data/json/npcs/talk_tags.json
msgid "Thank fuck for all the cardio!"
msgstr "有酸素運動してて助かった！"

#: data/json/npcs/talk_tags.json
msgid "I can't outrun it!  I'm going to kill it!"
msgstr "逃げ切れない！こうなったら殺してやる！"

#: data/json/npcs/talk_tags.json
msgid "<swear>!  Die, you <name_b>!  I want to live!"
msgstr "<swear>！くたばれ、この<name_b>め！生きてやるんだ！"

#: data/json/npcs/talk_tags.json
msgid "My feet failed me!  Arms, don't fail me!"
msgstr "足が駄目だ！腕よ、動いてくれ！"

#: data/json/npcs/talk_tags.json
msgid "Can't run!  Have to fight!"
msgstr "逃げられない！戦うしかない！"

#: data/json/npcs/talk_tags.json
msgid "If I die, I'm taking you all with me!"
msgstr "死ぬならお前ら全員、道連れにしてやる！"

#: data/json/npcs/talk_tags.json
msgid "Can't clear a path, holding the line!"
msgstr "道は開けない。ここで踏みとどまるぞ！"

#: data/json/npcs/talk_tags.json
msgid "I'm pinned down here!"
msgstr "ここで動けなくなった！"

#: data/json/npcs/talk_tags.json
msgid "Call the fire department!  Wait, they're dead!  Run away!"
msgstr "消防署に通報だ！いや、死んでるか！逃げよう！"

#: data/json/npcs/talk_tags.json
msgid "This place is on fire.  I'm leaving."
msgstr "ここは燃えている。俺は離れるぞ。"

#: data/json/npcs/talk_tags.json
msgid "Put the fire out!  Put it out!"
msgstr "火を消せ！消すんだ！"

#: data/json/npcs/talk_tags.json
msgid "Fire bad!  <move>!"
msgstr "火はまずいぞ！<move>！"

#: data/json/npcs/talk_tags.json
msgid "We need to put this fire out!"
msgstr "この火を消さないと！"

#: data/json/npcs/talk_tags.json
msgid "Somebody get some water!"
msgstr "誰か水を持ってきてくれ！"

#: data/json/npcs/talk_tags.json
msgid "Fire, fire, FIRE!"
msgstr "火事だ、火事だ、火事だ！"

#: data/json/npcs/talk_tags.json
msgid "Get an extinguisher!"
msgstr "消火器を取ってこい！"

#: data/json/npcs/talk_tags.json
msgid "Danger hot!"
msgstr "熱い、危ない！"

#: data/json/npcs/talk_tags.json
msgid "Is it getting hot in here or is it just me?  Oh, fire!"
msgstr "ここ、なんか暑くないか？……ああ、火事か！"

#: data/json/npcs/talk_tags.json
msgid "This place is toast, <move>!"
msgstr "ここはもうお終いだ、<move>！"

#: data/json/npcs/talk_tags.json
msgid "I've done so much for you, and you can't even keep me fed!"
msgstr "色々と尽くしてきたのに、飯すらまともに食わせてもらえないのか！"

#: data/json/npcs/talk_tags.json
msgid "You are the worst person in the world!"
msgstr "お前は世界で一番のクズだ！"

#: data/json/npcs/talk_tags.json
msgid "Why are you such a horrible leader?"
msgstr "どうしてこんな奴がリーダーなんだ？"

#: data/json/npcs/talk_tags.json
msgid "I trusted you, and you can't even provide food!"
msgstr "あんたを信じていたのに、食い物すら満足に提供できないとはな！"

#: data/json/npcs/talk_tags.json
msgid ""
"I don't have to take this abuse from you, there are plenty of people to "
"abuse me!"
msgstr "お前からまでこんな目に遭う筋合いはないんだ。俺をひどい目に遭わせたい奴なら、他にいくらでもいるんだからな！"

#: data/json/npcs/talk_tags.json
msgid "You said you would keep me safe, and you haven't!"
msgstr "護衛してくれるって言ったじゃないか、嘘つき！"

#: data/json/npcs/talk_tags.json
msgid ""
"There's only a couple hundred people left in the world, and I relied on the "
"dumbest one!"
msgstr "世界に数百人しか残ってないのに、よりによって一番のバカを頼ってしまった！"

#: data/json/npcs/talk_tags.json
msgid "You're a monster!"
msgstr "お前は怪物だ！"

#: data/json/npcs/talk_tags.json
msgid "You call this safe?  You're crazy and incompetent!"
msgstr "これが安全だと？正気か、この無能が！"

#: data/json/npcs/talk_tags.json
msgid "That was the last straw!  I'm not following your orders anymore!"
msgstr "我慢の限界だ！もうお前の命令なんか聞くもんか！"

#: data/json/npcs/talk_tags.json
msgid "I've had enough of your bullshit!"
msgstr "お前のデタラメにはもううんざりだ！"

#: data/json/npcs/talk_tags.json
msgid "Look at me.  I am the captain now."
msgstr "俺を見ろ。これからは俺が隊長だ。"

#: data/json/npcs/talk_tags.json
msgid "child"
msgstr "君"

#: data/json/npcs/talk_tags.json
msgid "my child"
msgstr "私の子"

#: data/json/npcs/talk_tags.json
msgid "dear"
msgstr "愛しい人"

#: data/json/npcs/talk_tags.json
msgid "my dear"
msgstr "愛しい我が君"

#: data/json/npcs/talk_tags.json
msgid "survivor"
msgstr "生存者"

#: data/json/npcs/talk_tags.json
msgid "little one"
msgstr "小さな子"

#: data/json/npcs/talk_tags.json
msgid "darling"
msgstr "ダーリン"

#: data/json/npcs/talk_tags.json
msgid "sweetie"
msgstr "スウィーティー"

#: data/json/npcs/talk_tags.json
msgid "right on top of us!"
msgstr "真上だ！"

#: data/json/npcs/talk_tags.json
msgid "right there!"
msgstr "そこだ！"

#: data/json/npcs/talk_tags.json
msgid "danger close!"
msgstr "近い！"

#: data/json/npcs/talk_tags.json
msgid "almost in melee range!"
msgstr "もうすぐ肉薄する！"

#: data/json/npcs/talk_tags.json
msgid "too close for comfort!"
msgstr "近すぎる、マズい！"

#: data/json/npcs/talk_tags.json
msgid "in our faces!"
msgstr "目の前だ！"

#: data/json/npcs/talk_tags.json
msgid "within shooting range."
msgstr "射程距離内だ。"

#: data/json/npcs/talk_tags.json
msgid "only a couple of seconds' away."
msgstr "あと数秒だ。"

#: data/json/npcs/talk_tags.json
msgid "just a bit away."
msgstr "すぐそこだ。"

#: data/json/npcs/talk_tags.json
msgid "closer than I'd like."
msgstr "思ったより近くに来たな。"

#: data/json/npcs/talk_tags.json
msgid "bit too close."
msgstr "少し近すぎる。"

#: data/json/npcs/talk_tags.json
msgid "nearby."
msgstr "近くにいる。"

#: data/json/npcs/talk_tags.json
msgid "near enough to see us."
msgstr "奴らから見える距離にいる。"

#: data/json/npcs/talk_tags.json
msgid "quite a bit away."
msgstr "かなり遠くにいるな。"

#: data/json/npcs/talk_tags.json
msgid "maybe within shooting range."
msgstr "射程距離に入ったかもしれない。"

#: data/json/npcs/talk_tags.json
msgid "at a good distance."
msgstr "ちょうどいい距離だ。"

#: data/json/npcs/talk_tags.json
msgid "just close enough to worry about."
msgstr "心配になるくらい近いな。"

#: data/json/npcs/talk_tags.json
msgid "close enough we should be careful."
msgstr "警戒した方がいい距離だ。"

#: data/json/npcs/talk_tags.json
msgid "far enough away that we could make sneak away."
msgstr "十分に離れている。こっそり離れられそうだ。"

#: data/json/npcs/talk_tags.json
msgid "out on the horizon, so don't worry much."
msgstr "地平線の向こうだ。さほど心配しなくていい。"

#: data/json/npcs/talk_tags.json
msgid "at a long distance."
msgstr "遠くにいる。"

#: data/json/npcs/talk_tags.json
msgid "just in sight."
msgstr "ちょうど視界に入ったところだ。"

#: data/json/npcs/talk_tags.json
msgid "hopefully a safe distance away."
msgstr "安全な距離だといいんだがな。"

#: data/json/npcs/talk_tags.json
msgid "<mypronoun> will use ranged weapons."
msgstr "<mypronoun>は遠距離武器を使う。"

#: data/json/npcs/talk_tags.json
