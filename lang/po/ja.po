#: data/json/speech.json data/mods/Aftershock/speech.json
#: data/mods/CrazyCataclysm/crazy_speech.json
msgid "\"Hello?\""
msgstr "「やぁ？」"

#: data/json/speech.json
msgid "\"Papaya!\""
msgstr "「パパイヤ！」"

#: data/json/speech.json data/mods/CrazyCataclysm/crazy_speech.json
msgid "\"Who's there?\""
msgstr "「そこにいるのは誰？」"

#: data/json/speech.json data/mods/Aftershock/speech.json
msgid "\"Can you help me?\""
msgstr "「手伝ってくれるかな？」"

#: data/json/speech.json
msgid "\"Over here!\""
msgstr "「こっちだ！」"

#: data/json/speech.json
msgid "\"Can you repeat that?\""
msgstr "「もう一度言ってくれる？」"

#: data/json/speech.json
msgid "\"You're just copying me, aren't you?\""
msgstr "「君は...僕の真似をしているんだね？」"

#: data/json/speech.json
msgid "\"I'm not afraid of you!\""
msgstr "「お前なんて怖くないぞ！」"

#: data/json/speech.json
msgid "\"Come here!\""
msgstr "「来てくれ！」"

#: data/json/speech.json
msgid "\"Please, don't!\""
msgstr "「お願いだ、やめてくれ！」"

#: data/json/speech.json
msgid "a horrified scream!"
msgstr "[恐怖に満ちた悲鳴]"

#: data/json/speech.json
msgid "a little girl's wailing!"
msgstr "[少女が泣き叫ぶ声]"

#: data/json/speech.json
msgid "\"So, what is this thing supposed to be, exactly?\""
msgstr "「ええと、一体これは何だ？」"

#: data/json/speech.json
msgid "\"Uncategorized object seven-seven-three-four.\""
msgstr "「未分類オブジェクト、7-7-3-4」"

#: data/json/speech.json
msgid "\"We found it in a wreckage, barely alive.  Not the first one, either.\""
msgstr "「瓦礫の中で見つけたが、かろうじて生きていた。これも、最初のやつとは違うな。」"

#: data/json/speech.json
msgid "\"Area nineteen has a few in cold storage.\""
msgstr "「エリア19には、複数の冷蔵倉庫がある」"

#: data/json/speech.json
msgid "\"Mommy, help!\""
msgstr "「お母さーん、助けてぇ！」"

#: data/json/speech.json
msgid "\"We're still trying to figure out what makes it tick.\""
msgstr "「こいつがどうやって動いているのか、まだ解明できていない。」"

#: data/json/speech.json
msgid "\"We're not even sure what it is.\""
msgstr "「これは何だ、さっぱりわからん」"

#: data/json/speech.json
msgid "\"The cell structure is unlike any we've ever seen.\""
msgstr "「この細胞の構造は、これまで見たどの構造とも異なる。」"

#: data/json/speech.json
msgid "\"It does seem to have some form of higher level brain functioning.\""
msgstr "「より高度な脳機能を持っているようだな」"

#: data/json/speech.json
msgid "\"Problem solving, memory retention, that sort of thing.\""
msgstr "「問題の解決や、記憶の保持、そういったことだ」"

#: data/json/speech.json
msgid "\"There appear to be some anomalous aspects to the mimicry.\""
msgstr "「擬態に異常な点があるようですね。」"

#: data/json/speech.json
msgid "\"Members of the species have some kind of neurocognitive link.\""
msgstr "「この種の個体間には、何らかの神経的・認知的な結びつきがあるようだ。」"

#: data/json/speech.json
msgid ""
"\"This one's repeating phrases that the previous specimen was exposed to.\""
msgstr "「この個体は、以前の個体が聞かされていたフレーズを繰り返している。」"

#: data/json/speech.json
msgid "a child shrieking!"
msgstr "[子供の悲鳴]"

#: data/json/speech.json
msgid "\"Oh God, my leg, Oh God!\""
msgstr "「神様、脚が…、神様！」"

#: data/json/speech.json
msgid "a long cry of agony!"
msgstr "[苦痛に満ちた叫び声]"

#: data/json/speech.json
msgid "\"You mean it's not just parroting us?\""
msgstr "「これがただのオウム返しではないと言うのか？」"

#: data/json/speech.json
msgid "\"It's parroting us, but we're uncertain as to how or why.\""
msgstr "「言葉を真似しているが、その仕組みや理由は不明です。」"

#: data/json/speech.json
msgid "\"It may be a mechanism for attracting prey.\""
msgstr "「獲物を引き寄せるための仕組みである可能性もある。」"

#: data/json/speech.json
msgid "\"It could even be a way of trying to scare us off.\""
msgstr "「もしくは、私たちを脅かして追い払おうとしているのかもしれない。」"

#: data/json/speech.json
msgid "\"We just don't know.\""
msgstr "「正直、分からないな。」"

#: data/json/speech.json
msgid "an anguished wail!"
msgstr "[苦悶に満ちた悲鳴]"

#: data/json/speech.json
msgid "\"You're gonna rot in hell for this!\""
msgstr "「この報いで、地獄で腐り堕ちろ！」"

#: data/json/speech.json
msgid "\"You hear me!?\""
msgstr "「聞いているのか！？」"

#: data/json/speech.json
msgid "\"You're gonna rot in hell, you pieces of shit!\""
msgstr "「地獄で腐り堕ちろ、くそったれどもが！」"

#: data/json/speech.json
msgid "\"Like we said, we have no idea what it's thinking.\""
msgstr "「言った通り、何を考えているのか、さっぱり分からない。」"

#: data/json/speech.json
msgid "\"Is that glass electrified?\""
msgstr "「あのガラス、感電するようになっているのか？」"

#: data/json/speech.json
msgid "\"Why don't you touch it and find out?\""
msgstr "「だったら、お前が触ってみろよ。」"

#: data/json/speech.json
msgid "\"Of course it is.\""
msgstr "「もちろん、そうさ。」"

#: data/json/speech.json
msgid "\"What'll happen if the power goes out?\""
msgstr "「もし停電になったらどうなるんだ？」"

#: data/json/speech.json
msgid "\"Don't worry about it.\""
msgstr "「別に心配すんなよ。」"

#: data/json/speech.json
msgid "\"Don't worry.\""
msgstr "「心配すんな。」"

#: data/json/speech.json
msgid "\"There are seven backup generators.\""
msgstr "「予備発電機が7台ある。」"

#: data/json/speech.json
msgid "\"And what if all the backups fail?\""
msgstr "「そして、予備のものもすべて壊れたらどうする？」"

#: data/json/speech.json
msgid "\"We'd have to terminate the specimen.\""
msgstr "「標本を廃棄する必要がある。」"

#: data/json/speech.json
msgid "\"The glass alone won't keep us safe for very long.\""
msgstr "「ガラスだけでは、あまり長くは安全を保てない。」"

#: data/json/speech.json
msgid "\"That fuckin' thing is horrible, man, it gives me the creeps.\""
msgstr "「あのクソ野郎は本当に気持ち悪いんだよ、マジで背筋が凍る。」"

#: data/json/speech.json
msgid "\"It's probably more scared of us than we are of it.\""
msgstr "「こっちがあいつを怖がっている以上に、あいつのほうがこっちをもっと怖がってるだろう。」"

#: data/json/speech.json
msgid "\"Somehow, I doubt that.\""
msgstr "「どうも、それは信じがたいな。」"

#: data/json/speech.json
msgid "\"Hey, we got other specimens that could withstand a grenade.\""
msgstr "「おい、手榴弾でも耐えられる別の標本が他にもいるんだ。」"

#: data/json/speech.json
msgid "\"And that's supposed to comfort me?\""
msgstr "「それで、俺が安心するってのか？」"

#: data/json/speech.json
msgid "\"At least we know they can die.\""
msgstr "「少なくとも、あいつらが死ぬことは確かだ。」"

#: data/json/speech.json
msgid "\"U-O Seven-Seven-Three-Four.\""
msgstr "「U-O 7-7-3-4」"

#: data/json/speech.json
msgid "\"Individual instances of U-O Seven-Seven-Three-Four.\""
msgstr "「U-O 7-7-3-4の個別試験」"

#: data/json/speech.json
msgid "\"To be kept in a standard biohazardous containment chamber.\""
msgstr "「標準的な生物危険物収容室に保管すること。」"

#: data/json/speech.json
msgid "\"Until such time as more permanent arrangements are made.\""
msgstr "「より恒久的な対応が整うまでの間。」"

#: data/json/speech.json
msgid "\"Shows a noted preference for human brain tissue.\""
msgstr "「人間の脳組織を特に好む傾向を示す。」"

#: data/json/speech.json
msgid "\"Destroy the specimen if it begins to interact with the lock.\""
msgstr "「標本がロック部分に接触を始めたら、直ちに破棄すること。」"

#: data/json/speech.json
msgid "\"Kill them all and let God sort them out!\""
msgstr "「全員殺せ。仕分けは神様に任せろ！」"

#: data/json/speech.json
msgid "\"I watched a snail crawl along the edge of a straight razor.\""
msgstr "「剃刀の刃の端をカタツムリが這うのを見ていた。」"

#: data/json/speech.json
msgid "\"I've seen horrors, horrors that you've seen.\""
msgstr "「俺は恐ろしいものを見た。お前が見たことのあるような、その地獄をな。」"

#: data/json/speech.json
msgid "\"I love the smell of napalm in the morning.\""
msgstr "「朝のナパームの匂いが好きだ。」"

#: data/json/speech.json
msgid "\"This is the way the fuckin' world ends.\""
msgstr "「これが、このクソったれの世界の終わりさ。」"

#: data/json/speech.json
msgid "\"Look at this fuckin' shit we're in, man.\""
msgstr "「見てみろよ、俺たちがどんないいざこざに巻き込まれてんだか。」"

#: data/json/speech.json
msgid "\"Every man has got a breaking point.\""
msgstr "「誰にだって、折れる限界がある。」"

#: data/json/speech.json
msgid "\"I'ma cut those fuckin' tentacles off, bitch!\""
msgstr "「そのクソったれの触手を切り落としてやるよ、この野郎が！」"

#: data/json/speech.json
msgid "\"Watch you bleed out!\""
msgstr "「出血死するところ、見せてもらおうか！」"

#: data/json/speech.json
msgid "\"I wonder if it understands us.\""
msgstr "「あいつがこっちのことを理解してるかどうか、気になるな。」"

#: data/json/speech.json
msgid "\"Do you understand what I'm saying?\""
msgstr "「お前、俺の言ってることが分かってるか？」"

#: data/json/speech.json
msgid "\"Look, it's responding!\""
msgstr "「見て、反応している！」"

#: data/json/speech.json
msgid "\"That's the first time it moved all morning.\""
msgstr "「今朝になって初めて、あいつが動いたぞ。」"

#: data/json/speech.json
msgid "\"I'm certain it's trying to understand us.\""
msgstr "「あいつは確かに、こっちのことを理解しようとしている。」"

#: data/json/speech.json
msgid "\"I'm not convinced it can actually comprehend us.\""
msgstr "「あいつが本当にこっちを理解できるとは、とても信じられない。」"

#: data/json/speech.json
msgid "\"It's just repeating us.\""
msgstr "「ただこっちの言葉を真似しているだけだ。」"

#: data/json/speech.json
msgid "\"Just being an alien creature doesn't mean it's intelligent.\""
msgstr "「異星の生物だからといって、知的だとは限らない。」"

#: data/json/speech.json
msgid "\"Just because it doesn't look like you doesn't mean that it isn't.\""
msgstr "「見た目がお前と違うからって、知性がないってわけじゃない。」"

#: data/json/speech.json
msgid "\"Please open the door and enter the cell.\""
msgstr "「ドアを開けて、部屋に入室してください。」"

#: data/json/speech.json
msgid "\"Would it react differently with a child?\""
msgstr "「子供に対してなら、違う反応を示すだろうか？」"

#: data/json/speech.json
msgid "\"Experiments to determine extent of cognitive abilities still underway.\""
msgstr "「認知能力の程度を判定する実験は、現在も継続中。」"

#: data/json/speech.json
msgid ""
"\"Subject has so far displayed a total lack of empathy toward human "
"suffering.\""
msgstr "「被験体は、これまでに人間の苦痛に対してまったく共感を示さない状態である。」"

#: data/json/speech.json
msgid "\"I got a round trip ticket.\""
msgstr "「往復切符を手に入れたよ。」"

#: data/json/speech.json
msgid "\"How's your mom doing?\""
msgstr "「お母さんは元気か？」"

#: data/json/speech.json
msgid "\"How's your dad doing?\""
msgstr "「お父さんは元気か？」"

#: data/json/speech.json
msgid "\"I love you.\""
msgstr "「愛してる。」"

#: data/json/speech.json
msgid "\"I love you too.\""
msgstr "「俺もお前を愛してる。」"

#: data/json/speech.json
msgid "\"Just a little.\""
msgstr "「ほんのちょっとだけだ。」"

#: data/json/speech.json
msgid "\"Only a few more days 'til the weekend.\""
msgstr "「あと数日で週末だ。」"

#: data/json/speech.json
msgid "\"Do you smoke?\""
msgstr "「タバコを吸うか？」"

#: data/json/speech.json
msgid "\"You're new here, aren't you?\""
msgstr "「お前、ここに来たばかりだよな？」"

#: data/json/speech.json
msgid "\"How do you like it here?\""
msgstr "「ここに来て、どうだ？気に入ってるか？」"

#: data/json/speech.json
msgid "\"It won't hurt a bit.\""
msgstr "「まったく痛くない。」"

#: data/json/speech.json
msgid "\"That was a long time ago.\""
msgstr "「それは随分昔の話だ。」"

#: data/json/speech.json
msgid "\"Does it scare you?\""
msgstr "「それが怖いのか？」"

#: data/json/speech.json
msgid "\"Don't worry, it can't hurt us.\""
msgstr "「心配するな、こっちに危害は加えない。」"

#: data/json/speech.json
msgid "\"What are you afraid will happen?\""
msgstr "「何が起こるかを恐れているんだ？」"

#: data/json/speech.json
msgid "\"Anything else?\""
msgstr "「他にも何かあるか？」"

#: data/json/speech.json
msgid "\"You think they're the same sex?\""
msgstr "「あいつらは全員、同じ性別だと思うか？」"

#: data/json/speech.json
msgid "\"Do they even have sex?\""
msgstr "「そもそもあいつらに性別なんてあるのか？」"

#: data/json/speech.json
msgid "\"Can I see your phone?\""
msgstr "「君の携帯、見せてもらえるか？」"

#: data/json/speech.json
msgid "\"You got a dollar I can borrow?\""
msgstr "「ダラーをひとつ貸してくれないか？」"

#: data/json/speech.json
msgid "\"Are you busy at the moment?\""
msgstr "「今、忙しいか？」"

#: data/json/speech.json
msgid "\"Are you busy later?\""
msgstr "「あとで暇か？」"

#: data/json/speech.json
msgid "\"Are you busy tonight?\""
msgstr "「今夜は暇か？」"

#: data/json/speech.json
msgid "\"Are you free tonight?\""
msgstr "「今夜、空いてるか？」"

#: data/json/speech.json
msgid "\"Are you going to the party tonight?\""
msgstr "「今夜、パーティーに行くのか？」"

#: data/json/speech.json
msgid "\"Are you going to help them?\""
msgstr "「あいつらを助けるつもりなのか？」"

#: data/json/speech.json
msgid "\"Are you alone?\""
msgstr "「一人か？」"

#: data/json/speech.json
msgid "\"Are you hungry?\""
msgstr "「腹が減ってないか？」"

#: data/json/speech.json
msgid "\"I'm hungry.\""
msgstr "「腹が減った。」"

#: data/json/speech.json
msgid "\"Go ahead.\""
msgstr "「先に行け。」"

#: data/json/speech.json
msgid "\"Have a good time.\""
msgstr "「楽しんでこい。」"

#: data/json/speech.json
msgid "\"Have you eaten yet?\""
msgstr "「まだ食ってないのか？」"

#: data/json/speech.json
msgid "\"Is it supposed to rain tomorrow?\""
msgstr "「明日の予報は雨か？」"

#: data/json/speech.json
msgid "\"Okay.\""
msgstr "「了解。」"

#: data/json/speech.json
msgid "\"Good.\""
msgstr "「よし。」"

#: data/json/speech.json
msgid "\"Great.\""
msgstr "「いいね。」"

#: data/json/speech.json
msgid "\"Fantastic.\""
msgstr "「最高だ。」"

#: data/json/speech.json
msgid "\"God damn it.\""
msgstr "「くそったれ。」"

#: data/json/speech.json
msgid "\"God damn it!\""
msgstr "「くそったれ！」"

#: data/json/speech.json
msgid "\"Damn it.\""
msgstr "「しまった。」"

#: data/json/speech.json
msgid "\"Damn it!\""
msgstr "「しまった！」"

#: data/json/speech.json
msgid "\"Fuck.\""
msgstr "「くそ。」"

#: data/json/speech.json
msgid "\"Shit.\""
msgstr "「くそ。」"

#: data/json/speech.json
msgid "\"Fuck!\""
msgstr "「くそったれ！」"

#: data/json/speech.json
msgid "\"Shit!\""
msgstr "「くそ！」"

#: data/json/speech.json
msgid "\"Fuckin' piece of garbage.\""
msgstr "「クソったれのゴミが。」"

#: data/json/speech.json
msgid "\"I need a new lab coat.\""
msgstr "「新しい白衣が必要だ。」"

#: data/json/speech.json
msgid "\"Excellent.\""
msgstr "「素晴らしい。」"

#: data/json/speech.json data/mods/CrazyCataclysm/crazy_speech.json
msgid "\"Excuse me.\""
msgstr "「すみません。」"

#: data/json/speech.json
msgid "\"Good morning.\""
msgstr "「おはよう。」"

#: data/json/speech.json
msgid "\"Good afternoon.\""
msgstr "「こんにちは。」"

#: data/json/speech.json
msgid "\"Good evening.\""
msgstr "「こんばんは。」"

#: data/json/speech.json
msgid "\"Good night.\""
msgstr "「おやすみ。」"

#: data/json/speech.json
msgid "\"Good luck.\""
msgstr "「幸運を祈る。」"

#: data/json/speech.json data/mods/CrazyCataclysm/crazy_speech.json
msgid "\"Can I help you?\""
msgstr "「手伝えることはあるか？」"

#: data/json/speech.json
msgid "\"Are you seeing anyone?\""
msgstr "「お前、誰かと付き合ってるか？」"

#: data/json/speech.json
msgid "\"Forget it.\""
msgstr "「「忘れてください。」"

#: data/json/speech.json
msgid "\"How long were you two together?\""
msgstr "「二人はどれくらい一緒にいたんだ？」"

#: data/json/speech.json
msgid "\"Give me a call later.\""
msgstr "「あとで電話してくれ。」"

#: data/json/speech.json
msgid "\"Call me.\""
msgstr "「俺に電話しろ。」"

#: data/json/speech.json
msgid "\"From time to time.\""
msgstr "「時々だ。」"

#: data/json/speech.json
msgid "\"We have a serious situation here.\""
msgstr "「ここは深刻な事態だ。」"

#: data/json/speech.json
msgid "\"Call the police.\""
msgstr "「警察を呼べ。」"

#: data/json/speech.json
msgid "\"Call an ambulance.\""
msgstr "「救急車を呼べ。」"

#: data/json/speech.json
msgid "\"Get me the White House.\""
msgstr "「ホワイトハウスに繋いでくれ。」"

#: data/json/speech.json
msgid "\"Are you feeling all right?\""
msgstr "「気分はどうだ？」"

#: data/json/speech.json
msgid "\"I think I'll live.\""
msgstr "「何とか生き延びられそうだ。」"

#: data/json/speech.json
msgid "\"I think I need to see a doctor.\""
msgstr "「医者の診察が必要だ。」"

#: data/json/speech.json
msgid "\"Is everything all right?\""
msgstr "「大丈夫か？」"

#: data/json/speech.json
msgid "\"I'm okay, don't worry about me.\""
msgstr "「俺は大丈夫だ、心配するな。」"

#: data/json/speech.json
msgid "\"It's just a scratch.\""
msgstr "「ただの引っかき傷だ。」"

#: data/json/speech.json
msgid "\"I've got a headache.\""
msgstr "「頭が痛い。」"

#: data/json/speech.json
msgid "\"I'm fine.\""
msgstr "「大丈夫だ。」"

#: data/json/speech.json
msgid "\"Are you sure?\""
msgstr "「本当にか？」"

#: data/json/speech.json
msgid "\"Positive.\""
msgstr "「間違いない。」"

#: data/json/speech.json
msgid "\"Affirmative.\""
msgstr "「肯定する。」"

#: data/json/speech.json
msgid "\"Negative.\""
msgstr "「否定する。」"

#: data/json/speech.json data/mods/CrazyCataclysm/crazy_speech.json
msgid "\"Sorry.\""
msgstr "「すまない。」"

#: data/json/speech.json
msgid "\"Happy Birthday!\""
msgstr "「ハッピーバースデー！」"

#: data/json/speech.json
msgid "\"Have you ever been to California?\""
msgstr "「カリフォルニアに行ったことはあるか？」"

#: data/json/speech.json
msgid "\"What time do you get off?\""
msgstr "「何時に終わりか？」"

#: data/json/speech.json
msgid "\"We should hit up the shooting range later.\""
msgstr "「後で射撃場に行こう。」"

#: data/json/speech.json
msgid "\"I'm heading to the pool after work.\""
msgstr "「仕事のあと、プールに行くところだ。」"

#: data/json/speech.json
msgid "\"Have a good trip.\""
msgstr "「良い旅を。」"

#: data/json/speech.json
msgid "\"Where did you come from?\""
msgstr "「どこから来たんだ？」"

#: data/json/speech.json
msgid "\"Have you been waiting long?\""
msgstr "「ずいぶん待ったか？」"

#: data/json/speech.json
msgid "\"Have you done this before?\""
msgstr "「前にやったことがあるか？」"

#: data/json/speech.json
msgid "\"Hello.\""
msgstr "「こんにちは。」"

#: data/json/speech.json
msgid "\"Help!\""
msgstr "「助けて！」"

#: data/json/speech.json
msgid "\"Here it is.\""
msgstr "「ここだ。」"

#: data/json/speech.json
msgid "\"I've got family coming tomorrow.\""
msgstr "「明日、家族が来るんだ。」"

#: data/json/speech.json
msgid "\"How do I use this?\""
msgstr "「これの使い方は？」"

#: data/json/speech.json
msgid "\"How do you know?\""
msgstr "「どうして分かる？」"

#: data/json/speech.json
msgid "\"How long have you been here?\""
msgstr "「ここに来てどれくらいになる？」"

#: data/json/speech.json
msgid "\"How many languages do you speak?\""
msgstr "「何カ国語話せる？」"

#: data/json/speech.json
msgid "\"How many people?\""
msgstr "「何人いる？」"

#: data/json/speech.json
msgid "\"How much were these earrings?\""
msgstr "「このイヤリングはいくらだった？」"

#: data/json/speech.json
msgid "\"How much do I owe you?\""
msgstr "「いくら払えばいい？」"

#: data/json/speech.json
msgid "\"How much will it cost?\""
msgstr "「いくらかかる？」"

#: data/json/speech.json
msgid "\"How much would you like?\""
msgstr "「どれくらい欲しい？」"

#: data/json/speech.json
msgid "\"How old are you?\""
msgstr "「何歳だ？」"

#: data/json/speech.json
msgid "\"How tall is it?\""
msgstr "「高さはどれくらいだ？」"

#: data/json/speech.json
msgid "\"How was the movie?\""
msgstr "「映画はどうだった？」"

#: data/json/speech.json
msgid "\"How was your trip?\""
msgstr "「旅は順調だったか？」"

#: data/json/speech.json
msgid "\"How's it going?\""
msgstr "「調子はどうだ？」"

#: data/json/speech.json
msgid "\"See you later.\""
msgstr "「またな。」"

#: data/json/speech.json
msgid "\"See you tonight.\""
msgstr "「今夜またな。」"

#: data/json/speech.json
msgid "\"I got this weird rash a few days ago.\""
msgstr "「数日前から、変な発疹ができ始めた。」"

#: data/json/speech.json
msgid "\"Let me have a look at it.\""
msgstr "「それ、見せてみろ。」"

#: data/json/speech.json
msgid "\"When did you find out?\""
msgstr "「いつ気づいた？」"

#: data/json/speech.json
msgid "\"Seven o'clock.\""
msgstr "「7時。」"

#: data/json/speech.json
msgid "\"Nobody is helping us.\""
msgstr "「誰も助けてくれない。」"

#: data/json/speech.json
msgid "\"We're on our own.\""
msgstr "「俺たちは一人きりだ。」"

#: data/json/speech.json
msgid "\"We're all alone.\""
msgstr "「俺たちは完全に取り残された。」"

#: data/json/speech.json
msgid "\"We should split into groups of two each.\""
msgstr "「二人一組に分かれて行動しよう。」"

#: data/json/speech.json
msgid "\"It can't follow all of us.\""
msgstr "「こいつは全員を追いかけることはできない。」"

#: data/json/speech.json
msgid "\"Be careful out there.\""
msgstr "「外では気をつけてくれ。」"

#: data/json/speech.json data/mods/CrazyCataclysm/crazy_speech.json
msgid "\"There you are.\""
msgstr "「そこにいるのか。」"

#: data/json/speech.json
msgid "\"I've been looking all over for you.\""
msgstr "「お前をずっと探していた。」"

#: data/json/speech.json
msgid "\"It's looking for us.\""
msgstr "「こいつはこっちを探している。」"

#: data/json/speech.json
msgid "\"It's faster than us.\""
msgstr "「こいつのほうが俺たちより速い。」"

#: data/json/speech.json
msgid "\"It's looking right at us.\""
msgstr "「こいつがまともにこっちを見ている。」"

#: data/json/speech.json
msgid "\"It's heading right for us!\""
msgstr "「こいつが真っ直ぐこっちに向かってきている！」"

#: data/json/speech.json
msgid "\"Can you swim?\""
msgstr "「泳げるか？」"

#: data/json/speech.json
msgid "\"Don't do that.\""
msgstr "「それをするな。」"

#: data/json/speech.json
msgid "\"You hear that?\""
msgstr "「聞こえたか？」"

#: data/json/speech.json
msgid "\"Be quiet.\""
msgstr "「静かにしろ。」"

#: data/json/speech.json
msgid "\"Look out!\""
msgstr "「危ない！」"

#: data/json/speech.json
msgid "\"Run!\""
msgstr "「逃げろ！」"

#: data/json/speech.json
msgid "\"Hurry!\""
msgstr "「急げ！」"

#: data/json/speech.json
msgid "\"No!\""
msgstr "「駄目だ！」"

#: data/json/speech.json
msgid "\"I'll never forget you.\""
msgstr "「お前のこと、絶対に忘れない。」"

#: data/json/speech.json
msgid "\"Take his gun, we're going to need it.\""
msgstr "「奴の銃を取れ、きっと必要になる。」"

#: data/json/speech.json
msgid "\"How do we get out of here?\""
msgstr "「ここからどうやって出るんだ？」"

#: data/json/speech.json
msgid "\"This place is like a maze.\""
msgstr "「この場所は迷路のようだ。」"

#: data/json/speech.json
msgid "\"Oh God, I'm the only one left.\""
msgstr "「神様、俺だけが取り残された。」"

#: data/json/speech.json
msgid "\"Please, I don't want to die.\""
msgstr "「お願いだ、死にたくはない。」"

#: data/json/speech.json
msgid "\"Mom.\""
msgstr "「母さん。」"

#: data/json/speech.json
msgid "\"Mom, I miss you.\""
msgstr "「母さん、会いたい。」"

#: data/json/speech.json
msgid "\"Me go, you stay.\""
msgstr "「ワタシ、イク。キミ、クルナ」"

#: data/json/speech.json
msgid "\"Please, God.\""
msgstr "「お願いだ、神様。」"

#: data/json/speech.json
msgid "a gurgling sound."
msgstr "[ゴボゴボという水が詰まったような音。]"

#: data/json/speech.json
msgid "a choking sound."
msgstr "[ゼーゼーと苦しそうに息を詰まらせる音。]"

#: data/json/speech.json
msgid "a snapping sound."
msgstr "パチン。"

#. ~ Beeper sound
#: data/json/speech.json src/iexamine.cpp src/iuse_actor.cpp
#: src/vehicle_use.cpp
msgid "beep!"
msgstr "ビー！"

#: data/json/speech.json src/mattack_actors.cpp
#: src/player_hardcoded_effects.cpp
msgid "beep-beep-beep!"
msgstr "ビー！ビー！ビー！"

#: data/json/speech.json
msgid "BEEP!"
msgstr "ビーッ！"

#: data/json/speech.json
msgid "a loud hiss."
msgstr "シューッ。"

#: data/json/speech.json
msgid "a loud crackling noise."
msgstr "パチッ。"

#: data/json/speech.json src/ranged.cpp
msgid "bang!"
msgstr "バァン！"

#: data/json/speech.json
msgid "a klaxon blaring!"
msgstr "[けたたましいサイレンが鳴り響く！]"

#: data/json/speech.json
msgid "\"EMERGENCY, EMERGENCY!\""
msgstr "「緊急事態、緊急事態！」"

#: data/json/speech.json
msgid "a static hissing sound."
msgstr "[ジージーという雑音がする。]"

#: data/json/speech.json
msgid "\"That creepy abandoned post-apocalyptic lab complex looks safe…\""
msgstr "「不気味な、ポストアポカリプスの廃墟と化した研究施設だが、中は安全そうだ……」"

#: data/json/speech.json
msgid ""
"\"Don't worry, it isn't like anything could teleport out of the containment "
"cells.\""
msgstr "「心配するな、こいつが収容セルからテレポートして逃げ出すなんてことにはならない。」"

#: data/json/speech.json
msgid "\"Hold on, I want to pulp that zombie corpse.\""
msgstr "「待て、そのゾンビの死体を粉砕したい。」"

#: data/json/speech.json
msgid "\"What did that thing just hit me with?\""
msgstr "「あの化け物に何で殴られたんだ？」"

#: data/json/speech.json
msgid "\"I can barely move.  Run!  Save yourself!\""
msgstr "「ほとんど動けない。逃げろ！お前だけでも助かれ！」"

#: data/json/speech.json
msgid "\"Oh you motherfucking shellfish, you're going down.\""
msgstr "「このクソったれの甲殻類が、今度こそ潰してやる。」"

#: data/json/speech.json
msgid "\"I… I feel weak…\""
msgstr "「俺……体が……だるい……」"

#: data/json/speech.json
msgid "\"Oi, dingus, you can't keep me in 'ere.\""
msgstr "「おい、馬鹿野郎、ここに閉じこめておけると思ってんのかよ！」"

#: data/json/speech.json
msgid "\"We got a treaty w'yer people, don'we?\""
msgstr "「お前たちの仲間とは条約を結んでるんだろ？　な？」"

#: data/json/speech.json
msgid "\"This'll get back t'my bosses, right and so!\""
msgstr "「これが上司たちの耳に入ったら、とんでもないことになるぜ、絶対にな！」"

#: data/json/speech.json
msgid "\"Lemme outta here!\""
msgstr "「ここから出せっての！」"

#: data/json/speech.json
msgid "\"Let me in…\""
msgstr "「入れて...」"

#: data/json/speech.json
msgid "\"Let me in!\""
msgstr "「中に入れて！」"

#: data/json/speech.json
msgid "\"We're both scavs, in't we?\""
msgstr "「スカベンジャー同士だろ、な？」"

#: data/json/speech.json
msgid ""
"\"Hey look, that one's carrying something.  Let's crack it open and steal "
"it.\""
msgstr "「おい見ろ、あいつ何か持ってる。こじ開けて盗もう」"

#: data/json/speech.json
msgid "\"G… geddoff me you… you bastard…\""
msgstr "「う…うわあ、俺の上からどけ…この野郎が…！」"

#: data/json/speech.json
msgid "\"Did-a-chuk?\""
msgstr "「ディダチョーク？」"

#: data/json/speech.json
msgid "\"Dad-a-chak?\""
msgstr "「デド・ア・バック？」"

#: data/json/speech.json
msgid "\"Dad-a-cham?\""
msgstr "「デド・ア・チョーク？」"

#: data/json/speech.json
msgid "\"Did-a-chak?\""
msgstr "「ディダチョーク？」"

#: data/json/speech.json
msgid "\"Did-a-chum?\""
msgstr "「ディダチョーク？」"

#: data/json/speech.json
msgid "\"Dad-a-chuk?\""
msgstr "「デド・ア・チョーク？」"

#: data/json/speech.json
msgid "\"What are you doing?  No!  NO!\""
msgstr "「何をしている？　やめろ！　やめて！」"

#: data/json/speech.json
msgid "\"Did you see what they did to him?\""
msgstr "「奴らが彼にしたことを、見たか？」"

#: data/json/speech.json
msgid "\"Yeah.  I can't believe he stayed alive that long.\""
msgstr "「ああ。あんなに長く生き延びていたなんて信じられない」"

#: data/json/speech.json
msgid "\"I think there's something in the air that's keeping us alive.\""
msgstr "「きっと、私らを生かし続けている何かが空気に含まれているんだ」"

#: data/json/speech.json
msgid "\"Burning… from the inside…\""
msgstr "「燃えている...体の中から...」"

#: data/json/speech.json
msgid "\"This smell…  Don't know…\""
msgstr "「この臭い...分からない...」"

#: data/json/speech.json
msgid "heavy breathing."
msgstr "[荒い息遣い]"

#: data/json/speech.json src/game.cpp src/grab.cpp
msgid "a scraping noise."
msgstr "[こする音]"

#: data/json/speech.json
msgid "\"No…  Stop the burning!\""
msgstr "「やめろ…この焼けるような痛みを止めろ！」"

#: data/json/speech.json
msgid "\"Hrgm…  Blood…  Hungry…\""
msgstr "「グググ...血...喰らいたい...」"

#: data/json/speech.json
msgid "\"Hunger…  Must eat…\""
msgstr "「飢え…　…喰わねば…」"

#: data/json/speech.json
msgid "\"Run…  Chase…  Eat…\""
msgstr "「走れ…　追え…　喰え…」"

#: data/json/speech.json
msgid "hysterical laughing."
msgstr "[ヒステリックな笑い声]"

#: data/json/speech.json
msgid "coughing."
msgstr "[咳]"

#: data/json/speech.json
msgid "growling."
msgstr "[唸り声]"

#: data/json/speech.json
msgid "wheezing."
msgstr "[ゼエゼエ]"

#: data/json/speech.json
msgid "\"WHY THE FUCK are you doing this to me?\""
msgstr "「何でだよ！　お前が俺に何をしやがる！」"

#: data/json/speech.json
msgid "\"LEAVE!  NOW!\""
msgstr "「出て行け！今すぐに！」"

#: data/json/speech.json
msgid "\"I TOLD YOU TO GET OUT OF HERE!\""
msgstr "「ここから出て行けって言ったはずだぞ！」"

#: data/json/speech.json
msgid "\"WHAT THE FUCK DO YOU WANT FROM ME?!\""
msgstr "「何をしやがるつもりだ！　何が目的なんだよ！」"

#: data/json/speech.json
msgid "\"STOP!\""
msgstr "「止まれ！」"

#: data/json/speech.json
msgid "indistinct shouting."
msgstr "[不明瞭な叫び声]"

#: data/json/speech.json
msgid "screaming."
msgstr "[叫び声]"

#: data/json/speech.json
msgid "\"MEAT!\""
msgstr "「肉！」"

#: data/json/speech.json
msgid "\"TEKELI-LI!\""
msgstr "「テケリ・リ！」"

#: data/json/speech.json
msgid "\"TEKELI-LI!  TEKELI-LI!  TEKELI-LI!\""
msgstr "「テケリ・リ！テケリ・リ！テケリ・リ！」"

#: data/json/speech.json
msgid "\"Tekeli-li.\""
msgstr "「テケリ・リ」"

#: data/json/speech.json
msgid "a slurping sound."
msgstr "[啜る音]"

#: data/json/speech.json
msgid "\"WHY!  WHY, WHYYY!\""
msgstr "「何故だ！何故だ、何故だぁぁ！」"

#: data/json/speech.json
msgid "an electronic voice saying \"CONNECTION FAILED.  Abort, Retry, Fail?\""
msgstr "[電子音声]『接続に失敗しました。中止、再試行、失敗？』"

#: data/json/speech.json
msgid "\"I was once a man.  A MAN!\""
msgstr "「私もかつては人間だった。ニンゲンだったのだ！」"

#: data/json/speech.json
msgid "\"What have I become?\""
msgstr "「私は…何になってしまった…？」"

#: data/json/speech.json
msgid "an electronic voice saying \"KILL ALL HUMANS!\""
msgstr "[電子音声]『全人類を抹殺せよ！』"

#: data/json/speech.json
msgid "\"Have you seen my children?\""
msgstr "「私の子どもたち…見ませんでしたか？」"

#: data/json/speech.json
msgid "\"What have I become?  Why can't I die?\""
msgstr "「私は…何になってしまった…？何故死ねないんだ…？」"

#: data/json/speech.json
msgid ""
"\"Please, kill me!\", followed by an electronic voice saying \"SELF "
"PRESERVATION PROTOCOLS ACTIVATED\""
msgstr "[叫び声]「頼む、私を殺してくれ！」[電子音声]『自己保存プロトコル、作動しました』"

#: data/json/speech.json
msgid "\"Please, take me with you.\""
msgstr "「お願いだ、一緒に連れて行ってくれ」"

#: data/json/speech.json
msgid "\"Not that way!  Go left!\""
msgstr "「そっちじゃない！左に進め！」"

#: data/json/speech.json
msgid "\"I told you to let me die.\""
msgstr "「死なせてくれって…言ったのに」"

#: data/json/speech.json
msgid "\"W-where am I?  Why does it hur-REBOOTING IN 59 SECONDS.\""
msgstr "「こ、ここはどこだ？なぜ痛むんだ...[電子音声][『再起動まであと59秒。』」"

#: data/json/speech.json
msgid "\"THIS UNIT IS BROKEN.  PLEASE CALL AN ATTENDANT.\""
msgstr "「このユニットは故障しています。係員を呼んでください。」"

#: data/json/speech.json
msgid "\"Can't… breathe…\""
msgstr "「息が...できな...」"

#: data/json/speech.json
msgid "\"This cannot continue.\""
msgstr "「この状況は継続できない。」"

#: data/json/speech.json
msgid "\"USER PASSWORD UNRECOGNIZED.\""
msgstr "[電子音声]「ユーザーのパスワードが認識されません。」"

#: data/json/speech.json
msgid ""
"\"Have you seen my friend?  He went into surgery yesterday… or maybe the day"
" before…\""
msgstr "「私の友人に会わなかった？　彼は昨日、手術を受けに行ったんだ…いや、おとといだったか…」"

#: data/json/speech.json
msgid "\"Is it done?  Am I perfect now?\""
msgstr "「終わったのか？　これで完璧なのか？」"

#: data/json/speech.json
msgid "\"I have done what you asked.  Please let me go!\""
msgstr "「言われたことはもうやった。放っておいてくれ！」"

#: data/json/speech.json
msgid "\"I cannot… yet I must.  How do you calculate that?\""
msgstr "「できない...でも、やらなければ。どうやって計算すればいいんだ？」"

#: data/json/speech.json
msgid "\"This is a dream.  This has to be a dream.\""
msgstr "「これは夢だ。これは夢に違いない。」"

#: data/json/speech.json
msgid "\"This is my life now… this is my life now… this is my life now…\""
msgstr "「これが私の人生...これが私の人生...これが私の人生...」"

#: data/json/speech.json
msgid "\"Wanna go home…\""
msgstr "「家に帰りたい...」"

#: data/json/speech.json
msgid "screams of pain."
msgstr "[苦痛に満ちた叫び声]"

#: data/json/speech.json
msgid "muffled sobbing."
msgstr "[くぐもったすすり泣き]"

#: data/json/speech.json
msgid ""
"\"You lied to me!  Look at what you've done!\", followed by an electronic "
"voice saying \"YOU'LL PAY FOR THIS!\""
msgstr "[叫び声]「嘘つき！　何てことをしたんだ！」[電子音声]『報いを受けろ！』"

#: data/json/speech.json src/monattack.cpp
msgid ""
"a soft robotic voice say, \"Come here and stand still for a few minutes, "
"I'll give you a check-up.\""
msgstr "[柔和な機械音声]「立ったまま数分間じっとしていてください。健康診断を行います」"

#: data/json/speech.json src/monattack.cpp
msgid ""
"a soft robotic voice say, \"Come on.  I don't bite, I promise it won't hurt "
"one bit.\""
msgstr "[柔和な機械音声]「こちらへどうぞ。噛みついたりしませんよ。決して傷つけないことを約束します」"

#: data/json/speech.json src/monattack.cpp
msgid "a soft robotic voice say, \"Here we go.  Just hold still.\""
msgstr "[柔和な機械音声]「始めますよ。じっとしてくださいね」"

#: data/json/speech.json
msgid ""
"a voice say, \"I don't want to go but our time together is drawing to an "
"end.\""
msgstr "[声]「私は…去りたくない。でも、私たちの時間は、もう終わりに近づいています」"

#: data/json/speech.json
msgid "a cheery voice say, \"Customer?  We'll be friends forever, right?\""
msgstr "[陽気な声]「お客様？これからもずっとお友達でいられますよね？」"

#: data/json/speech.json
msgid ""
"a neutral voice say, \"Customer I must inform you that my allocated time "
"with you will soon come to its end.\""
msgstr "[平坦な声]「お客様、あなたとの接続時間がまもなく終了いたします」"

#: data/json/speech.json
msgid ""
"a neutral voice say, \"I'll have to leave you soon.  You can acquire more "
"friendship through my dedicated interface if you wish for me to stay.\""
msgstr "[平坦な声]「まもなくお別れの時間です。引き続き接続を希望される場合は、専用インターフェースから関係値を更新してください」"

#: data/json/speech.json
msgid ""
"a worried voice say, \"Customer, could you please get more friendship?  I "
"don't want to go…\""
msgstr "[心配そうな声]「お客様、関係値を増やしていただけませんか？いなくなりたくありません…」"

#: data/json/speech.json
msgid "a voice say, \"Oh no!  You ran out of friendship!\""
msgstr "[声]「まずい…関係値が尽きました！」"

#: data/json/speech.json
msgid "a cheery voice say, \"Well I'm done here.  Have a nice day.\""
msgstr "[陽気な声]「業務が終了しました。良い一日を」"

#: data/json/speech.json
msgid ""
"a cheery voice say, \"Here are your groceries.  Thank you for shopping with "
"me today, have a nice day.\""
msgstr "[陽気な声]「お買い上げの品はこちらです。本日もご利用いただきありがとうございます。良い一日を」"

#: data/json/speech.json
msgid "a neutral voice say, \"My job here is done.  Have a nice day.\""
msgstr "[平坦な声]「私の業務は完了しました。良い一日を」"

#: data/json/speech.json
msgid ""
"a distorted voice say, \"Customer…  What's happening?  I don't feel so "
"good.\""
msgstr "[歪んだ声]「お客様…何が起きているのですか？動作に異常があります」"

#: data/json/speech.json
msgid ""
"a distorted voice say, \"What… have you done?  My thumbs are not responding "
"anymore!\""
msgstr "[歪んだ声]「何を…されたのですか？末端出力が応答しません！」"

#: data/json/speech.json
msgid "a distorted voice say, \"Carrying bags?  I don't understand…\""
msgstr "[歪んだ声]「バッグの運搬？理解できません…」"

#: data/json/speech.json
msgid ""
"a robotic voice say, \"IRREGULAR ACTIVITY DETECTED.  THUMBS USAGE DENIED.\""
msgstr "[機械音声]「不正な操作が検出されました。親指の使用は禁止します」"

#: data/json/speech.json
msgid ""
"a robotic voice say, \"UNLICENSED USE DETECTED.  CARRYING PROTOCOL "
"DISABLED.\""
msgstr "[機械音声]「無許可の使用が検出されました。荷物運搬プロトコルは無効化されました」"

#: data/json/speech.json
