msgid "This is a contaminant.  We reject it from the Mycus."
msgstr "これは汚染物質。私たちはこれをマイカスから拒絶する。"

#: src/mutation.cpp
msgid "We decontaminate it with spores."
msgstr "我々は胞子によって浄化される。"

#: src/mutation.cpp
msgctxt "memorial_male"
msgid "Destroyed a harmful invader."
msgstr "有害な侵入者を排除した。"

#: src/mutation.cpp
msgctxt "memorial_female"
