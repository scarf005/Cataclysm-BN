msgstr "%1$sに強い衝撃を受け、%2$dのダメージを負った！"

#: src/monattack.cpp
#, c-format
msgid "The %1$s quivers hungrily in the direction of the %2$s."
msgstr "%1$s は飢えたように %2$s の方向に震える。"

#: src/monattack.cpp
#, c-format
msgid "The %1$s absorbs the %2$s, growing larger."
msgstr "%1$sが%2$sを吸収し、さらに巨大化する。"

#: src/monattack.cpp
#, c-format
