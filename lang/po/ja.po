#: data/json/speech.json
msgid "Die for me!"
msgstr "私のために死ね！"

#: data/json/speech.json
msgid "Why won't you die?"
msgstr "なぜ死なないの？"

#: data/json/speech.json
msgid "Blood…  Delicious."
msgstr "血…おいしい。"

#: data/json/speech.json
msgid "See you… IN HELL!"
msgstr "また会おう…地獄でな！"

#: data/json/speech.json
