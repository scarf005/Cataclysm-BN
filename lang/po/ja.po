msgid "Biker"
msgstr "バイク乗り"

#: data/json/professions.json
msgctxt "profession_female"
msgid "Biker"
msgstr "バイク乗り"

#. ~ Profession (male Biker) description
#: data/json/professions.json
msgctxt "prof_desc_male"
msgid ""
"You spent most of your life on a Harley, out on the open road with your "
"club.  Now they're all dead.  Time to ride or die."
msgstr "人生のほとんどをハーレーにまたがり、クラブとともに果てしない道を走ってきた。今は全員死んだ。走るか、死ぬか。それだけだ。"

