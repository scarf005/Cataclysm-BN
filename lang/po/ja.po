msgstr "運搬用に丸められた大型スリーピングバッグ。持ち運び用のストラップ付き。"

#: data/json/items/armor/misc.json
msgid "fur sleeping bag"
msgid_plural "fur sleeping bags"
msgstr[0] "ファースリーピングバッグ"

#. ~ Use action msg for {'str': 'fur sleeping bag'}.
#: data/json/items/armor/misc.json
msgid "You roll up the fur sleeping bag, preparing it for transport."
msgstr "ファースリーピングバッグを丸め、運搬の準備をした。"

#. ~ Description for {'str': 'fur sleeping bag'}
#: data/json/items/armor/misc.json
