#. ~ Use action bury_question for {'str': 'bear trap'}.
#: data/json/items/tool/traps.json
msgid "Bury the beartrap?"
msgstr "¿Quieres enterrar la trampa para oso?"

#. ~ Use action done_message for {'str': 'bear trap'}.
#: data/json/items/tool/traps.json
msgid "You set the beartrap."
msgstr "Pones la trampa para osos."

#. ~ Use action done_message for {'str': 'bear trap'}.
#: data/json/items/tool/traps.json
msgid "You bury the beartrap."
msgstr "Entierras la trampa para osos."

#. ~ Description for {'str': 'bear trap'}
#: data/json/items/tool/traps.json
msgid ""
"This is a spring-loaded pair of steel jaws connected to a sensitive pressure"
" plate.  Use it to set it on the ground, creating a trap that will ensnare "
"and damage anything that steps on it.  If you are carrying a shovel, you "
"will have the option of burying it."
msgstr ""
"Es como una mandíbula de acero conectada a una placa de presión sensitiva. "
"Usala para ponerla en el suelo, creando una trampa que va a capturar y dañar"
" cualquier cosa que la pise. Si tienes una pala, vas a tener la opción de "
"enterrarla."

#: data/json/items/tool/traps.json
