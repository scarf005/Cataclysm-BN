#: data/json/professions.json
msgctxt "profession_male"
msgid "Defective Cyborg"
msgstr ""

#: data/json/professions.json
msgctxt "profession_female"
msgid "Defective Cyborg"
msgstr ""

#. ~ Profession (male Defective Cyborg) description
#: data/json/professions.json
msgctxt "prof_desc_male"
msgid ""
"You were normal once.  Before the tests, before the procedures, before they "
"stripped away every outward sign of your humanity.  You're more machine than"
" man now, but that might prove an advantage against the horrors that await."
msgstr ""
"Alguna vez fuiste normal. Antes de las pruebas, antes de los procedimientos,"
" antes de que ellos te quitaran cada uno de tus signos de humanidad. Ahora, "
"eres más máquina que hombre, pero eso puede ser una ventaja contra los "
"horrores que te esperan."

#. ~ Profession (female Defective Cyborg) description
#: data/json/professions.json
msgctxt "prof_desc_female"
msgid ""
"You were normal once.  Before the tests, before the procedures, before they "
"stripped away every outward sign of your humanity.  You're more machine than"
