#: data/json/speech.json data/mods/Aftershock/speech.json
#: data/mods/CrazyCataclysm/crazy_speech.json
msgid "\"Hello?\""
msgstr "\"¿Hola?\""

#: data/json/speech.json
msgid "\"Papaya!\""
msgstr "\"Papaya!\""

#: data/json/speech.json data/mods/CrazyCataclysm/crazy_speech.json
msgid "\"Who's there?\""
msgstr "\"¿Quién está ahí?\""

#: data/json/speech.json data/mods/Aftershock/speech.json
msgid "\"Can you help me?\""
msgstr "\"¿Me puedes ayudar\"?"

#: data/json/speech.json
msgid "\"Over here!\""
msgstr "\"¡Aquí!\""

#: data/json/speech.json
msgid "\"Can you repeat that?\""
msgstr "\"¿Me puedes repetir eso?\""

#: data/json/speech.json
msgid "\"You're just copying me, aren't you?\""
msgstr "\"¿Me estás haciendo burla, no?\""

#: data/json/speech.json
msgid "\"I'm not afraid of you!\""
msgstr "\"¡No te tengo miedo!\""

#: data/json/speech.json
msgid "\"Come here!\""
msgstr "\"¡Vení aquí!\""

#: data/json/speech.json
msgid "\"Please, don't!\""
msgstr "\"Por favor, ¡no!\""

#: data/json/speech.json
msgid "a horrified scream!"
msgstr "¡un grito aterrador!"

#: data/json/speech.json
msgid "a little girl's wailing!"
msgstr "¡el lamento de una niña!"

#: data/json/speech.json
msgid "\"So, what is this thing supposed to be, exactly?\""
msgstr "\"Así que, ¿qué se supone que es esta cosa, exactamente?\""

#: data/json/speech.json
msgid "\"Uncategorized object seven-seven-three-four.\""
msgstr "\"Objeto no categorizado siete-siete-tres-cuatro.\""

#: data/json/speech.json
msgid "\"We found it in a wreckage, barely alive.  Not the first one, either.\""
msgstr ""

#: data/json/speech.json
msgid "\"Area nineteen has a few in cold storage.\""
msgstr ""

#: data/json/speech.json
msgid "\"Mommy, help!\""
msgstr "\"¡Mamá, ayudame!\""

#: data/json/speech.json
msgid "\"We're still trying to figure out what makes it tick.\""
msgstr "\"Todavía estamos intentando darnos cuenta de por qué hace tictac.\""

#: data/json/speech.json
msgid "\"We're not even sure what it is.\""
msgstr "\"Ni siquiera estamos seguro de lo que es esto.\""

#: data/json/speech.json
msgid "\"The cell structure is unlike any we've ever seen.\""
msgstr ""
"\"La estructura de la célula no se parece a nada que hayamos visto antes.\""

#: data/json/speech.json
msgid "\"It does seem to have some form of higher level brain functioning.\""
msgstr "\"Sí parece tener alguna clase de funcionalidad cerebral de alto nivel.\""

#: data/json/speech.json
msgid "\"Problem solving, memory retention, that sort of thing.\""
msgstr "\"Resolver problemas, retener la memoria, esa clase de cosas.\""

#: data/json/speech.json
msgid "\"There appear to be some anomalous aspects to the mimicry.\""
msgstr "\"Parece haber alguna clase de aspecto anómalo en el mimetismo.\""

#: data/json/speech.json
msgid "\"Members of the species have some kind of neurocognitive link.\""
msgstr ""
"\"Los miembros de la especie tienen alguna clase de conexión "
"neurocognitiva.\""

#: data/json/speech.json
msgid ""
"\"This one's repeating phrases that the previous specimen was exposed to.\""
msgstr ""
"\"Este está repitiendo frases a las que el espécimen anterior estuvo "
"expuesto.\""

#: data/json/speech.json
msgid "a child shrieking!"
msgstr "¡un niño chillando!"

#: data/json/speech.json
msgid "\"Oh God, my leg, Oh God!\""
msgstr "\"Oh, por dios, ¡mi pierna, por dios!\""

#: data/json/speech.json
msgid "a long cry of agony!"
msgstr "¡un grito largo de agonía!"

#: data/json/speech.json
msgid "\"You mean it's not just parroting us?\""
msgstr "\"¿Me estás diciendo que no está repitiendo como un loro?\""

#: data/json/speech.json
msgid "\"It's parroting us, but we're uncertain as to how or why.\""
msgstr ""
"\"Está repitiendo lo que decimos como un loro, pero no sabemos exactamente "
"cómo o por qué.\""

#: data/json/speech.json
msgid "\"It may be a mechanism for attracting prey.\""
msgstr "\"Puede ser un mecanismo para atraer a las presas.\""

#: data/json/speech.json
msgid "\"It could even be a way of trying to scare us off.\""
msgstr "\"También pudo haber sido una manera de intentar asustarnos.\""

#: data/json/speech.json
msgid "\"We just don't know.\""
msgstr "\"La verdad es que no sabemos.\""

#: data/json/speech.json
msgid "an anguished wail!"
msgstr "¡un llanto de angustia!"

#: data/json/speech.json
msgid "\"You're gonna rot in hell for this!\""
msgstr "\"¡Te vas a pudrir en el infierno por esto!\""

#: data/json/speech.json
msgid "\"You hear me!?\""
msgstr "\"¿¡Me escuchas!?\""

#: data/json/speech.json
msgid "\"You're gonna rot in hell, you pieces of shit!\""
msgstr "\"¡Se van a pudrir en el infierno, hijos de puta!\""

#: data/json/speech.json
msgid "\"Like we said, we have no idea what it's thinking.\""
msgstr "\"Como dijimos, no tenemos ni idea de lo que está pensando.\""

#: data/json/speech.json
msgid "\"Is that glass electrified?\""
msgstr "\"¿Ese cristal está electrificado?\""

#: data/json/speech.json
msgid "\"Why don't you touch it and find out?\""
msgstr "\"¿Por qué no lo tocas y lo averiguás?\""

#: data/json/speech.json
msgid "\"Of course it is.\""
msgstr "\"Por supuesto que lo está.\""

#: data/json/speech.json
msgid "\"What'll happen if the power goes out?\""
msgstr "\"¿Qué pasa si se queda sin electricidad?\""

#: data/json/speech.json
msgid "\"Don't worry about it.\""
msgstr "\"No te preocupes por eso.\""

#: data/json/speech.json
msgid "\"Don't worry.\""
msgstr "\"No te preocupes.\""

#: data/json/speech.json
msgid "\"There are seven backup generators.\""
msgstr "\"Tiene siete generadores de respaldo.\""

#: data/json/speech.json
msgid "\"And what if all the backups fail?\""
msgstr "\"¿Y qué pasa si fallan todos los de respaldo?\""

#: data/json/speech.json
msgid "\"We'd have to terminate the specimen.\""
msgstr "\"Tenemos que eliminar el espécimen.\""

#: data/json/speech.json
msgid "\"The glass alone won't keep us safe for very long.\""
msgstr "\"El cristal solo no nos mantendrá a salvo por mucho tiempo.\""

#: data/json/speech.json
msgid "\"That fuckin' thing is horrible, man, it gives me the creeps.\""
msgstr "\"Esa cosa de mierda es horrible, tío, me da escalofríos.\""

#: data/json/speech.json
msgid "\"It's probably more scared of us than we are of it.\""
msgstr "\"Probablemente, tenga más miedo de nosotros que nosotros.\""

#: data/json/speech.json
msgid "\"Somehow, I doubt that.\""
msgstr "\"De alguna manera, me parece que no.\""

#: data/json/speech.json
msgid "\"Hey, we got other specimens that could withstand a grenade.\""
msgstr "\"Hey, tenemos otros especímenes que pueden soportar una granada.\""

#: data/json/speech.json
msgid "\"And that's supposed to comfort me?\""
msgstr "\"¿Y se supone que eso tiene que tranquilizarme?\""

#: data/json/speech.json
msgid "\"At least we know they can die.\""
msgstr "\"Por lo menos sabemos que pueden morir.\""

#: data/json/speech.json
msgid "\"U-O Seven-Seven-Three-Four.\""
msgstr "\"U-O Siete-Siete-Tres-Cuatro.\""

#: data/json/speech.json
msgid "\"Individual instances of U-O Seven-Seven-Three-Four.\""
msgstr "\"Instancias individuales de U-O Siete-Siete-Tres-Cuatro.\""

#: data/json/speech.json
msgid "\"To be kept in a standard biohazardous containment chamber.\""
msgstr ""
"\"Para ser guardado en una cámara estándar de contención de riesgos "
"biológicos.\""

#: data/json/speech.json
msgid "\"Until such time as more permanent arrangements are made.\""
msgstr "\"Hasta el momento en que se hagan arreglos más permanentes.\""

#: data/json/speech.json
msgid "\"Shows a noted preference for human brain tissue.\""
msgstr "\"Muestra una notoria preferencia por el tejido cerebral humano.\""

#: data/json/speech.json
msgid "\"Destroy the specimen if it begins to interact with the lock.\""
msgstr "\"Destruir el espécimen si comienza a interactuar con la cerradura.\""

#: data/json/speech.json
msgid "\"Kill them all and let God sort them out!\""
msgstr "\"¡Mátenlos a todos y dejen que Dios disponga!\""

#: data/json/speech.json
msgid "\"I watched a snail crawl along the edge of a straight razor.\""
msgstr ""
"\"He visto a un caracol arrastrarse por el filo de una cuchilla de "
"afeitar.\""

#: data/json/speech.json
msgid "\"I've seen horrors, horrors that you've seen.\""
msgstr "\"He visto horrores, horrores que ya viste.\""

#: data/json/speech.json
msgid "\"I love the smell of napalm in the morning.\""
msgstr "\"Me encanta el olor del napalm a la mañana.\""

#: data/json/speech.json
msgid "\"This is the way the fuckin' world ends.\""
msgstr "\"Esta es la manera en que este mundo de mierda se termina.\""

#: data/json/speech.json
msgid "\"Look at this fuckin' shit we're in, man.\""
msgstr "\"Mira en la mierda que estamos metidos, tío.\""

#: data/json/speech.json
msgid "\"Every man has got a breaking point.\""
msgstr "\"Todos los hombres tienen un punto de ruptura.\""

#: data/json/speech.json
msgid "\"I'ma cut those fuckin' tentacles off, bitch!\""
msgstr "\"¡Te voy a cortar esos tentáculos de mierda, hijo de puta!\""

#: data/json/speech.json
msgid "\"Watch you bleed out!\""
msgstr "\"¡Cuidado que te desangrás!\""

#: data/json/speech.json
msgid "\"I wonder if it understands us.\""
msgstr "\"Me pregunto si puede entendernos.\""

#: data/json/speech.json
msgid "\"Do you understand what I'm saying?\""
msgstr "\"¿Entiendes lo que te estoy diciendo?\""

#: data/json/speech.json
msgid "\"Look, it's responding!\""
msgstr "\"Mira, ¡está reaccionando!\""

#: data/json/speech.json
msgid "\"That's the first time it moved all morning.\""
msgstr "\"Esa es la primera vez que se mueve en toda la mañana.\""

#: data/json/speech.json
msgid "\"I'm certain it's trying to understand us.\""
msgstr "\"Estoy seguro de que está tratando de entendernos.\""

#: data/json/speech.json
msgid "\"I'm not convinced it can actually comprehend us.\""
msgstr "\"No creo que pueda comprender lo que decimos.\""

#: data/json/speech.json
msgid "\"It's just repeating us.\""
msgstr "\"Sólo está repitiendo lo que decimos.\""

#: data/json/speech.json
msgid "\"Just being an alien creature doesn't mean it's intelligent.\""
msgstr ""
"\"Solo por ser una criatura alienígena no significa que sea inteligente.\""

#: data/json/speech.json
msgid "\"Just because it doesn't look like you doesn't mean that it isn't.\""
msgstr "\"Solo porque no se parece a ti no significa que no sea como tú.\""

#: data/json/speech.json
msgid "\"Please open the door and enter the cell.\""
msgstr "\"Por favor, abrir la puerta y entra en la celda.\""

#: data/json/speech.json
msgid "\"Would it react differently with a child?\""
msgstr "\"¿Reaccionará diferente con un niño?\""

#: data/json/speech.json
msgid "\"Experiments to determine extent of cognitive abilities still underway.\""
msgstr ""
"\"Los experimentos para determinar el alcance de las habilidades cognitivas "
"todavía está en desarrollo.\""

#: data/json/speech.json
msgid ""
"\"Subject has so far displayed a total lack of empathy toward human "
"suffering.\""
msgstr ""
"\"Hasta el momento, el sujeto ha mostrado una total falta de empatía hacia "
"el sufrimiento humano.\""

#: data/json/speech.json
msgid "\"I got a round trip ticket.\""
msgstr "\"Tengo un pasaje de ida y vuelta.\""

#: data/json/speech.json
msgid "\"How's your mom doing?\""
msgstr "\"¿Cómo está tu madre?\""

#: data/json/speech.json
msgid "\"How's your dad doing?\""
msgstr "\"¿Cómo está tu padre?\""

#: data/json/speech.json
msgid "\"I love you.\""
msgstr "\"Te amo.\""

#: data/json/speech.json
msgid "\"I love you too.\""
msgstr "\"Yo también te amo.\""

#: data/json/speech.json
msgid "\"Just a little.\""
msgstr "\"Solo un poco.\""

#: data/json/speech.json
msgid "\"Only a few more days 'til the weekend.\""
msgstr "\"Solo faltan unos pocos días hasta el fin de semana.\""

#: data/json/speech.json
msgid "\"Do you smoke?\""
msgstr "\"¿Fumás?\""

#: data/json/speech.json
msgid "\"You're new here, aren't you?\""
msgstr "\"Eres nuevo aquí, ¿verdad?\""

#: data/json/speech.json
msgid "\"How do you like it here?\""
msgstr "\"¿Te gusta estar aquí?\""

#: data/json/speech.json
msgid "\"It won't hurt a bit.\""
msgstr "\"No te va a doler ni un poquito.\""

#: data/json/speech.json
msgid "\"That was a long time ago.\""
msgstr "\"Eso fue hace mucho tiempo.\""

#: data/json/speech.json
msgid "\"Does it scare you?\""
msgstr "\"¿Te da miedo?\""

#: data/json/speech.json
msgid "\"Don't worry, it can't hurt us.\""
msgstr "\"No te preocupes, no nos puede lastimar.\""

#: data/json/speech.json
msgid "\"What are you afraid will happen?\""
msgstr "\"¿Qué tienes miedo que pase?\""

#: data/json/speech.json
