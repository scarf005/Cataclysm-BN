msgstr[2] "radios (encendidas)"

#. ~ Description for {'str': 'radio (on)', 'str_pl': 'radios (on)'}
#: data/json/items/tool/radio_tools.json
msgid ""
"This portable radio is turned on, and continually draining its batteries.  "
"It is playing the broadcast being sent from any nearby radio towers."
msgstr ""
"Esta radio portátil está encendida, y está consumiendo gradualmente sus "
"baterías. Está transmitiendo una señal enviada por alguna de las torres de "
"radio cercanas."

#: data/json/items/tool/radio_tools.json
