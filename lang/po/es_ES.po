#: data/json/professions.json
msgctxt "profession_male"
msgid "Paperboy"
msgstr "Repartidor de periódicos"

#: data/json/professions.json
msgctxt "profession_female"
msgid "Papergirl"
msgstr "Repartidora de periódicos"

#. ~ Profession (male Paperboy) description
#: data/json/professions.json
msgctxt "prof_desc_male"
msgid ""
"You were delivering the morning paper along your usual route when the "
"Cataclysm struck.  The undead hordes don't seem to value the latest news, "
"but at least your trusty bicycle is still in working order."
msgstr ""
"Estabas entregando el diario matutino por tu ruta diaria, cuando el "
"cataclismo ocurrió. Las hordas de muertos vivientes no parecen valorar las "
"noticias, pero al menos tu querida bicicleta todavía funciona."

#. ~ Profession (female Papergirl) description
#: data/json/professions.json
msgctxt "prof_desc_female"
msgid ""
"You were delivering the morning paper along your usual route when the "
