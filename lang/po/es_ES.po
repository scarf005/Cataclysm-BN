#: data/help/texts.json
msgid ""
"<color_red>^>v<</color>        Gun store - Firearms and ammunition are very "
"valuable."
msgstr ""
"<color_red>^>v<</color>        Armería - Las armas de fuego y la munición "
"son muy valiosas. "

#: data/help/texts.json
msgid ""
"<color_blue>^>v<</color>        Clothing store - High-capacity clothing, "
"some light armor."
msgstr ""
"<color_blue>^>v<</color>        Tienda de ropa - Ropa de buena calidad, "
"alguna armadura ligera. "

#: data/help/texts.json
msgid ""
"<color_brown>^>v<</color>        Library - Home to books, both entertaining "
"and informative."
msgstr ""
"<color_brown>^>v<</color>         Librería - Hogar de los libros, para "
