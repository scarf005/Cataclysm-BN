msgstr[2] "spezis"

#. ~ Description for spezi
#: data/json/items/comestibles/drink.json
msgid ""
"Originating in Germany almost a century ago, this mix of cola and orange "
"soda tastes great."
msgstr ""
"Originaria de Alemania hace más de un siglo atrás, esta mezcla de refresco "
"cola y naranja tiene muy rico gusto."

#: data/json/items/comestibles/drink.json
msgid "sports drink"
msgid_plural "sports drinks"
msgstr[0] "bebida para deportistas"
msgstr[1] "bebidas para deportistas"
msgstr[2] "bebidas para deportistas"

#. ~ Description for sports drink
#: data/json/items/comestibles/drink.json
msgid ""
"Consisting of a special blend of electrolytes and simple sugars, this "
"beverage tastes like bottled sweat but rehydrates the body faster than "
"water."
msgstr ""
"Consiste en una mezcla especial de electrolitos y azúcares simples, esta "
"bebida tiene gusto a transpiración en botella pero rehidrata el cuerpo más "
"rápido que el agua."

#: data/json/items/comestibles/drink.json
msgid "spurge tea"
