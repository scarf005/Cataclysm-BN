#: src/player_hardcoded_effects.cpp
msgid "You feel a little strange."
msgstr "Te sientes un poco extraño."

#: src/player_hardcoded_effects.cpp
msgid "The world takes on a dreamlike quality."
msgstr "El mundo adopta una similitud a los sueños."

#: src/player_hardcoded_effects.cpp
msgid "You have a sudden nostalgic feeling."
msgstr "De repente, te asalta un sentimiento de nostalgia."

#: src/player_hardcoded_effects.cpp
msgid "Everything around you is starting to breathe."
msgstr "Todo empieza a respirar alrededor tuyo."

#: src/player_hardcoded_effects.cpp
msgid "Something feels very, very wrong."
msgstr "Algo parece estar mal, muy mal."

#: src/player_hardcoded_effects.cpp
msgid "You feel sick to your stomach."
msgstr "Te sientes mal del estómago."

#: src/player_hardcoded_effects.cpp
msgid "\"I think it's starting to kick in.\""
msgstr "\"Creo que está empezando a hacer efecto.\""

#: src/player_hardcoded_effects.cpp
msgid "\"Oh God, what's happening?\""
msgstr "\"Oh Dios, ¿qué está pasando?\""

#: src/player_hardcoded_effects.cpp
msgid "\"Of course… it's all fractals!\""
msgstr "\"Por supuesto... ¡son todos fractales!\""

#: src/player_hardcoded_effects.cpp
msgid "\"Huh?  What was that?\""
msgstr "\"¿Eh? ¿Qué fue eso?\""

#: src/player_hardcoded_effects.cpp
msgid "Fractal patterns dance across your vision."
msgstr "Adelante de tus ojos, comienzan a bailar estructuras fractales."

#: src/player_hardcoded_effects.cpp
msgid "Dancing fractals distract you."
msgstr "Fractales danzantes te distraen."

#: src/player_hardcoded_effects.cpp
msgid "Everything looks SO boring now."
msgstr "Ahora todo parece MUY aburrido."

#: src/player_hardcoded_effects.cpp
msgid "Things are returning to normal."
msgstr "Las cosas vuelven a la normalidad."

#: src/player_hardcoded_effects.cpp
msgid "Your thoughts are unclear."
msgstr "Tus pensamientos están nublados."

#: src/player_hardcoded_effects.cpp
msgid "Your face is stiff from the cold."
msgstr "Tienes la cara dura de frío."

#: src/player_hardcoded_effects.cpp
msgid "You quiver from the cold."
msgstr "Estás temblando de frío."

#: src/player_hardcoded_effects.cpp
msgid "Your torso is freezing cold.  You should put on a few more layers."
msgstr "Tu torso está helado. Deberías ponerte unas pocas capas más."

#: src/player_hardcoded_effects.cpp
msgid "Your shivering makes you unsteady."
msgstr "Los escalofríos te hacen temblar."

#: src/player_hardcoded_effects.cpp
msgid "Your left arm is shivering."
msgstr "Te tiembla el brazo izquierdo."

#: src/player_hardcoded_effects.cpp
msgid "Your left arm trembles from the cold."
msgstr "Tu brazo izquierdo se estremece por el frío."

#: src/player_hardcoded_effects.cpp
msgid "Your right arm is shivering."
msgstr "Te tiembla el brazo derecho."

#: src/player_hardcoded_effects.cpp
msgid "Your right arm trembles from the cold."
msgstr "Tu brazo derecho se estremece por el frío."

#: src/player_hardcoded_effects.cpp
msgid "Your left hand feels like ice."
msgstr "Tienes la mano izquierda helada."

#: src/player_hardcoded_effects.cpp
msgid "Your left hand quivers in the cold."
msgstr "Tu mano izquierda tiembla por el frío."

#: src/player_hardcoded_effects.cpp
msgid "Your right hand feels like ice."
msgstr "Tienes la mano derecha helada."

#: src/player_hardcoded_effects.cpp
msgid "Your right hand quivers in the cold."
msgstr "Tu mano derecha se estremece por el frío."

#: src/player_hardcoded_effects.cpp
