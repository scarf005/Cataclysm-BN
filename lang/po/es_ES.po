#: data/json/professions.json
msgctxt "profession_male"
msgid "Bionic Agent"
msgstr "Agente Biónico"

#: data/json/professions.json
msgctxt "profession_female"
msgid "Bionic Agent"
msgstr "Agente Biónica"

#. ~ Profession (male Bionic Agent) description
#: data/json/professions.json
msgctxt "prof_desc_male"
msgid ""
"Your body has several bionics worth millions of dollars, paid for by public "
"taxes.  The government has turned you into an infiltration and recon "
"specialist: you have night vision, an alarm, an infolink, lock picking "
"capabilities and a hacking module."
msgstr ""
"Tu cuerpo tiene varios biónicos valorados en millones de dólares, pagados "
"con impuestos públicos.  El gobierno te ha convertido en un especialista en "
"infiltración y reconocimiento: tienes visión nocturna, una alarma, un enlace"
" de información, capacidades para abrir cerraduras y un módulo de hackeo."

#. ~ Profession (female Bionic Agent) description
#: data/json/professions.json
msgctxt "prof_desc_female"
msgid ""
"Your body has several bionics worth millions of dollars, paid for by public "
"taxes.  The government has turned you into an infiltration and recon "
"specialist: you have night vision, an alarm, an infolink, lock picking "
"capabilities and a hacking module."
msgstr ""
"Tu cuerpo tiene varios biónicos valorados en millones de dólares, pagados "
"con impuestos públicos.  El gobierno te ha convertido en una especialista en"
