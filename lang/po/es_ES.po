#: data/json/professions.json
msgctxt "profession_male"
msgid "Cyberjunkie"
msgstr "Ciberadicto"

#: data/json/professions.json
msgctxt "profession_female"
msgid "Cyberjunkie"
msgstr "Ciberadicta"

#. ~ Profession (male Cyberjunkie) description
#: data/json/professions.json
msgctxt "prof_desc_male"
msgid ""
"Long ago your lifelong infatuation with bionic enhancement lead you into a "
"shady world of back-alley bionic clinics and self-installed secondhand CBMs."
"  The world has moved on but your posthuman hunger still cries out to be "
"fed; where will you get your bionic fix now?"
msgstr ""
"Hace mucho, tu capricho con las mejoras biónicas te llevó a un mundo oscuro "
"de clínicas biónicas en callejones perdidos y auto-instalaciones de MCB "
"usados. El mundo cambió pero tu hambre posthumana todavía grita por ser "
"satisfecha. ¿Dónde conseguirás ahora ese repuesto biónico?"

#. ~ Profession (female Cyberjunkie) description
#: data/json/professions.json
msgctxt "prof_desc_female"
msgid ""
"Long ago your lifelong infatuation with bionic enhancement lead you into a "
"shady world of back-alley bionic clinics and self-installed secondhand CBMs."
"  The world has moved on but your posthuman hunger still cries out to be "
"fed; where will you get your bionic fix now?"
msgstr ""
