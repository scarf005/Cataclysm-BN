msgid "Improved Critical"
msgstr ""

#. ~ Description of buff 'Improved Critical' for martial art '{'str': 'Tiger
#. Claw'}'
#: data/mods/MMA/martialarts.json
msgid ""
"Always strike with full force.  Never hold back anything unless you want to die.\n"
"\n"
"+2 Accuracy, n+15 speed, +25% damage."
msgstr ""

