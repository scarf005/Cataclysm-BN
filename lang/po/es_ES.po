#: src/player_hardcoded_effects.cpp src/trapfunc.cpp
msgid "VRMMMMMM"
msgstr "VRMMMMMM"

#: src/player_hardcoded_effects.cpp
msgid "Your asthma attack stops."
msgstr "Dejas de tener un ataque de asma."

#: src/player_hardcoded_effects.cpp
msgid ""
"Your asthma overcomes you.\n"
"You asphyxiate."
msgstr ""
"Tu asma se vuelve incontrolable.\n"
"Te asfixiaste."

#: src/player_hardcoded_effects.cpp
msgid "You wheeze and gasp for air."
msgstr "Resoplas y jadeas intentando respirar."

#: src/player_hardcoded_effects.cpp
msgid "Your head aches faintly."
msgstr "Te duele ligeramente la cabeza."

#: src/player_hardcoded_effects.cpp
msgid "Your vision is getting fuzzy."
msgstr "Tu vista se está haciendo borrosa."

#: src/player_hardcoded_effects.cpp
msgid "Your vision goes black!"
msgstr "¡No ves nada más que negro!"

#: src/player_hardcoded_effects.cpp
msgid "Your bowels ache."
msgstr "Te duelen los intestinos."

#: src/player_hardcoded_effects.cpp
msgid "Your veins itch."
msgstr "Te pican las venas."

#: src/player_hardcoded_effects.cpp
msgid "Your muscles feel like they're knotted and tired."
msgstr "Sientes tus músculos como si estuvieran atados y cansados."

#: src/player_hardcoded_effects.cpp
msgid ""
"You're experiencing loss of basic motor skills and blurred vision.  Your "
"mind recoils in horror, unable to communicate with your spinal column."
msgstr ""
"Estás sintiendo una pérdida de tus habilidades motoras básicas, y visión "
"borrosa. Tu mente retrocede espantada, incapaz de comunicarse con tu columna"
" vertebral."

#: src/player_hardcoded_effects.cpp
msgid "You stagger and fall!"
msgstr "¡Te tambaleas y te caes!"

#: src/player_hardcoded_effects.cpp
msgid "There's some kind of big machine in the sky."
msgstr "Hay una especie de máquina grande en el cielo."

#: src/player_hardcoded_effects.cpp
msgid "It's some kind of electric snake, coming right at you!"
msgstr "Es como una serpiente eléctrica, ¡que viene hacia ti!"

#: src/player_hardcoded_effects.cpp
msgid ""
"Order us some golf shoes, otherwise we'll never get out of this place alive."
msgstr "Pídenos unos zapatos de golf, o nunca saldremos vivos de aquí."

#: src/player_hardcoded_effects.cpp
msgid "The possibility of physical and mental collapse is now very real."
msgstr "Ahora te parece muy real la posibilidad del colapso físico y mental."

#: src/player_hardcoded_effects.cpp
msgid "No one should be asked to handle this trip."
msgstr "No se le tendría que pedir a nadie que haga este viaje."

#: src/player_hardcoded_effects.cpp
msgid ""
"Your heart spasms painfully and stops, dragging you back to reality as you "
"die."
msgstr ""
"Sientes espasmos dolorosos en tu corazón, y se detiene, arrastrándote hacia "
"la realidad mientras te mueres."

#: src/player_hardcoded_effects.cpp
msgid ""
"You dissolve into beautiful paroxysms of energy.  Life fades from your "
"nebulae and you are no more."
msgstr ""
"Te disuelves en hermosos paroxismos de energía. La vida se desvanece de tu "
"nebulosa y ya no existes más."

