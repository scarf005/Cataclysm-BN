#: data/json/professions.json
msgctxt "profession_male"
msgid "Meth Cook"
msgstr "Cocinero de anfeta"

#: data/json/professions.json
msgctxt "profession_female"
msgid "Meth Cook"
msgstr "Cocinera de anfeta"

#. ~ Profession (male Meth Cook) description
#: data/json/professions.json
msgctxt "prof_desc_male"
msgid ""
"You clawed your way out of poverty by selling products everyone wanted, and "
"they had the nerve to put you in jail for it.  Too bad you can't sell drugs "
"to zombies or aliens."
msgstr ""
"Te esforzaste por salir de la pobreza vendiendo productos que todos querían,"
" y tuvieron la osadía de meterte en la cárcel por eso.  Lástima que no "
"puedas venderle drogas a los zombis o extraterrestres."

#. ~ Profession (female Meth Cook) description
#: data/json/professions.json
