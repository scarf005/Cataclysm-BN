#: data/json/items/ammo.json data/mods/Aftershock/items/item_overrides.json
msgid "battery"
msgid_plural "batteries"
msgstr[0] "batería"
msgstr[1] "baterías"
msgstr[2] "baterías"

#. ~ Description for {'str': 'battery', 'str_pl': 'batteries'}
#: data/json/items/ammo.json
msgid ""
"Some free-floating battery charge.  This can be reloaded into rechargable "
"battery cells, but can never be unloaded."
msgstr ""
"Una carga de batería flotante. Se puede recargar en celdas de batería "
"recargables, pero nunca se puede descargar."

#: data/json/items/ammo.json
msgid "radioisotope thermoelectric generator"
msgid_plural "radioisotope thermoelectric generators"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""

#. ~ Description for {'str': 'radioisotope thermoelectric generator'}
#: data/json/items/ammo.json
msgid ""
"Did your neighbors brag about their cool beta-decay powered nightlights?  Do"
" them one better!  The CuppaTech 4 radioisotope thermoelectric generator is "
"a three kilogram chunk of metal - mostly lead - with a slug of curium-244 "
"encased within.  It is capable of generating somewhere between 100-150 Watts"
" of thermal energy, although its electrical generation capacity is minimal "
"at only 2 Watts.  Careful!  Curium is great at making heat, and also "
"releases deadly gamma radiation.  Keep away from cellular life forms."
msgstr ""

#: data/json/items/ammo.json
msgid "aluminum foil"
msgid_plural "aluminum foils"
msgstr[0] "papel de aluminio"
msgstr[1] "papeles de aluminio"
msgstr[2] "papeles de aluminio"

#. ~ Description for {'str': 'aluminum foil'}
#: data/json/items/ammo.json
msgid ""
"A thin foil made of aluminum.  Sometimes called 'tin foil' due to being made"
" of tin in the past."
msgstr ""
"Es un papel delgado hecho de aluminio. A veces se lo llama 'papel estaño' "
"debido a que antes se hacía con estaño."

#: data/json/items/ammo.json
msgid "cent"
msgid_plural "cents"
msgstr[0] "centavo"
msgstr[1] "centavos"
msgstr[2] "centavos"

#. ~ Description for {'str': 'cent'}
#. ~ Description for {'str': 'placeholder ammunition'}
#. ~ Description for {'str_sp': 'software'}
#: data/json/items/ammo.json data/json/items/software.json
msgid "IF YOU ARE SEEING THIS IT IS A BUG."
msgstr "SI ESTAS VIENDO ESTO, ES UN BUG."

#: data/json/items/ammo.json data/json/items/ammo_types.json
msgid "thread"
msgid_plural "thread"
msgstr[0] "hilo"
msgstr[1] "hilos"
msgstr[2] "hilos"

#. ~ Description for {'str_sp': 'thread'}
#: data/json/items/ammo.json
msgid "A small quantity of thread that could be used to refill a sewing kit."
msgstr ""
"Una cantidad pequeña de hilo que puede ser usada para rellenar un kit de "
"costura."

#: data/json/items/ammo.json
msgid "sinew"
msgid_plural "sinews"
msgstr[0] "tendón"
msgstr[1] "tendones"
msgstr[2] "tendones"

#. ~ Description for {'str': 'sinew'}
#: data/json/items/ammo.json
msgid "A tough sinew cut from a corpse, usable as thread."
msgstr "Un tendón duro cortado de un cadáver, puede ser usado como hilo."

#: data/json/items/ammo.json
msgid "plant fiber"
msgid_plural "plant fibers"
msgstr[0] "fibra vegetal"
msgstr[1] "fibras vegetales"
msgstr[2] "fibras vegetales"

#. ~ Description for {'str': 'plant fiber'}
#: data/json/items/ammo.json
msgid "Tough thin fiber, taken from a plant.  Can be used as thread."
msgstr ""
"Son fibras finas y resistentes, sacadas de una planta. Pueden utilizarse "
"como hilo."

#: data/json/items/ammo.json
msgid "yarn"
msgid_plural "yarn"
msgstr[0] "hilo de lana"
msgstr[1] "hilos de lana"
msgstr[2] "hilos de lana"

#. ~ Description for {'str_sp': 'yarn'}
#: data/json/items/ammo.json
msgid "Wool yarn, could be used to knit wool clothing."
msgstr "Es hilo de lana, puede ser utilizado para tejer ropa de lana."

#: data/json/items/ammo.json
msgid "soap bar"
msgid_plural "soap bars"
msgstr[0] "pastilla de jabón"
msgstr[1] "pastillas de jabón"
msgstr[2] "pastillas de jabón"

#. ~ Description for {'str': 'soap bar'}
#: data/json/items/ammo.json
msgid "A cleansing agent made into bars."
msgstr "Es un agente limpiador hecho pastillas."

#: data/json/items/ammo.json data/json/items/ammo_types.json
msgid "duct tape"
msgid_plural "duct tapes"
msgstr[0] "cinta adhesiva"
msgstr[1] "cintas adhesivas"
msgstr[2] "cintas adhesivas"

#. ~ Description for {'str': 'duct tape'}
#: data/json/items/ammo.json
msgid "A roll of incredibly strong tape.  Its uses are innumerable."
msgstr ""
"Es un rollo de cinta adhesiva muy resistente. Se utiliza para muchísimas "
"cosas."

#: data/json/items/ammo.json
msgid "rolling paper"
msgid_plural "rolling papers"
msgstr[0] "papel de liar"
msgstr[1] "papeles de liar"
msgstr[2] "papeles de liar"

#. ~ Description for {'str': 'rolling paper'}
#: data/json/items/ammo.json
msgid "These are thin paper strips intended for the rolling of cigarettes."
msgstr "Son tiras de papel fino para liarse unos cigarrillos."

#: data/json/items/ammo.json
msgid "copper wire"
msgid_plural "copper wires"
msgstr[0] "cable de cobre"
msgstr[1] "cables de cobre"
msgstr[2] "cables de cobre"

#. ~ Description for {'str': 'copper wire'}
#: data/json/items/ammo.json
msgid "Plastic jacketed copper cable of the type used in small electronics."
msgstr ""
"Cable de cobre aislado del que se usa en dispositivos electrónicos pequeños."

#: data/json/items/ammo.json data/mods/Aftershock/items/item_overrides.json
msgid "plutonium fuel cell"
msgid_plural "plutonium fuel cells"
msgstr[0] "celda de combustible de plutonio"
msgstr[1] "celdas de combustible de plutonio"
msgstr[2] "celdas de combustible de plutonio"

#. ~ Description for {'str': 'plutonium fuel cell'}
#: data/json/items/ammo.json
msgid ""
"This power cell was designed to store enormous amounts of power, using "
"plutonium-244 and now-irreplaceable compounds to make compact reactors more "
"practical than ever.  Unfortunately it cannot be recharged by conventional "
"means: expended cells had to be sent to a central reprocessing facility that"
" almost certainly doesn't exist anymore."
msgstr ""
"Esta celda de energía fue diseñada para almacenar enormes cantidades de "
"energía, utilizando plutonio-244 y compuestos ahora insustituibles para "
"hacer los reactores compactos más prácticos que nunca.  Lamentablemente, no "
"puede recargarse por medios convencionales: las celdas agotadas debían ser "
"enviadas a una instalación central de reprocesamiento que casi con certeza "
"ya no existe."

#: data/json/items/ammo.json data/json/items/ammo_types.json
msgid "plutonium slurry"
msgid_plural "plutonium slurry"
msgstr[0] "pulpa de plutonio"
msgstr[1] "pulpa de plutonio"
msgstr[2] "pulpa de plutonio"

#. ~ Description for {'str_sp': 'plutonium slurry'}
#. ~ Description for {'str_sp': 'watery plutonium slurry'}
#: data/json/items/ammo.json
msgid ""
"Highly radioactive slurry.  It is probably best to get far away from this."
msgstr ""
"Es una solución acuosa densa altamente radiactiva. Probablemente, lo mejor "
"sea estar muy lejos de esto."

#: data/json/items/ammo.json
msgid "watery plutonium slurry"
msgid_plural "watery plutonium slurry"
msgstr[0] "pulpa acuosa de plutonio"
msgstr[1] "pulpa acuosa de plutonio"
msgstr[2] "pulpa acuosa de plutonio"

