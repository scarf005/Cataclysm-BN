msgstr[0] "radio bidireccional"
msgstr[1] "radios bidireccionales"
msgstr[2] "radios bidireccionales"

#. ~ Description for {'str': 'two-way radio'}
#: data/json/items/tool/radio_tools.json
msgid ""
"This is a radio with a transmitting unit.  You could use it to contact "
"someone who also has one.  Unfortunately no one seems to use those nowadays…"
msgstr ""
"Es una radio con una unidad transmisora. Puedes usarla para contactar con "
"alguien que también tenga una. Desafortunadamente nadie parece usarlas hoy "
"en día..."

#: data/json/items/tool/radio_tools.json
msgid "remote vehicle controller"
msgid_plural "remote vehicle controllers"
msgstr[0] "controlador remoto de vehículo"
msgstr[1] "controladores remotos de vehículo"
msgstr[2] "controladores remotos de vehículo"

#. ~ Description for {'str': 'remote vehicle controller'}
#: data/json/items/tool/radio_tools.json
msgid ""
"A remote controller for real cars.  Can turn onboard devices on and off.  "
"Some cars can be driven remotely."
msgstr ""
"Es un controlador remoto para coches verdaderos. Puede encender o apagar los"
" dispositivos del coche. Algunos coches pueden ser manejados de manera "
"remota."

#. ~ Use action done_message for {'str': 'birchbark funnel'}.
#: data/json/items/tool/raincatchers.json
msgid "You place the birchbark funnel, waiting to collect rain."
