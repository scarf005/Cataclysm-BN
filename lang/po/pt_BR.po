#: data/json/speech.json data/mods/Aftershock/speech.json
#: data/mods/CrazyCataclysm/crazy_speech.json
msgid "\"Hello?\""
msgstr "\"Olá?\""

#: data/json/speech.json
msgid "\"Papaya!\""
msgstr ""

#: data/json/speech.json data/mods/CrazyCataclysm/crazy_speech.json
msgid "\"Who's there?\""
msgstr "\"Quem está aí?\""

#: data/json/speech.json data/mods/Aftershock/speech.json
msgid "\"Can you help me?\""
msgstr "\"Pode me ajudar?\""

#: data/json/speech.json
msgid "\"Over here!\""
msgstr "\"Por aqui!\""

#: data/json/speech.json
msgid "\"Can you repeat that?\""
msgstr "\"Você pode repetir isso?\""

#: data/json/speech.json
msgid "\"You're just copying me, aren't you?\""
msgstr "\"Você tá só me copiando, não é?'"

#: data/json/speech.json
msgid "\"I'm not afraid of you!\""
msgstr "\"Eu não tenho medo de você!\""

#: data/json/speech.json
msgid "\"Come here!\""
msgstr "\"Vem aqui!\""

#: data/json/speech.json
msgid "\"Please, don't!\""
msgstr "\"Por favor não!\""

#: data/json/speech.json
msgid "a horrified scream!"
msgstr "um grito horrorizado!"

#: data/json/speech.json
msgid "a little girl's wailing!"
msgstr "uma garotinha está chorando!"

#: data/json/speech.json
msgid "\"So, what is this thing supposed to be, exactly?\""
msgstr "\"Então, o que essa coisa deveria ser, exatamente?'"

#: data/json/speech.json
msgid "\"Uncategorized object seven-seven-three-four.\""
msgstr "\"Objeto não categorizado sete-sete-três-quatro. \""

#: data/json/speech.json
msgid "\"We found it in a wreckage, barely alive.  Not the first one, either.\""
msgstr "\"Achamos isso num destroço, quase vivo. Também não era o primeiro\"."

#: data/json/speech.json
msgid "\"Area nineteen has a few in cold storage.\""
msgstr "\"Área dezenove tem alguns congelados.\""

#: data/json/speech.json
msgid "\"Mommy, help!\""
msgstr "\"Mamãe, ajuda!\""

#: data/json/speech.json
msgid "\"We're still trying to figure out what makes it tick.\""
msgstr "\"Ainda estamos tentando descobrir o que faz isso funcionar. \""

#: data/json/speech.json
msgid "\"We're not even sure what it is.\""
msgstr "\"Nós não temos nem certeza do que é.\""

#: data/json/speech.json
msgid "\"The cell structure is unlike any we've ever seen.\""
msgstr "\"A estrutura da célula é diferente de tudo que já vimos. \""

#: data/json/speech.json
msgid "\"It does seem to have some form of higher level brain functioning.\""
msgstr "\"Parece que tem alguma forma de funcionamento cerebral de alto nível.\""

#: data/json/speech.json
msgid "\"Problem solving, memory retention, that sort of thing.\""
msgstr "\"Resolução de problemas, retenção de memória, esse tipo de coisa. \""

#: data/json/speech.json
msgid "\"There appear to be some anomalous aspects to the mimicry.\""
msgstr "\"Parece haver alguns aspectos anômalos no mimetismo.\""

#: data/json/speech.json
msgid "\"Members of the species have some kind of neurocognitive link.\""
msgstr "\"Membros da espécie possuem algum tipo de ligação neurocognitiva. \""

#: data/json/speech.json
msgid ""
"\"This one's repeating phrases that the previous specimen was exposed to.\""
msgstr "\"Este está repetindo frases que o espécime anterior foi exposto a. \""

#: data/json/speech.json
msgid "a child shrieking!"
msgstr "uma criança berrando!"

#: data/json/speech.json
msgid "\"Oh God, my leg, Oh God!\""
msgstr "\"Meu Deus, minha perna, meu Deus!\""

#: data/json/speech.json
msgid "a long cry of agony!"
msgstr "um longo grito de agonia!"

#: data/json/speech.json
msgid "\"You mean it's not just parroting us?\""
msgstr "'Você quer dizer que não tá só imitando a gente?\""

#: data/json/speech.json
msgid "\"It's parroting us, but we're uncertain as to how or why.\""
msgstr "\"Está nos imitando, mas não temos certeza de como ou por que. \""

#: data/json/speech.json
msgid "\"It may be a mechanism for attracting prey.\""
msgstr "\"Pode ser um mecanismo para atrair presas.\""

#: data/json/speech.json
msgid "\"It could even be a way of trying to scare us off.\""
msgstr "\"Pode até ser uma maneira de tentar nos assustar.\""

#: data/json/speech.json
msgid "\"We just don't know.\""
msgstr "\"Nós simplesmente não sabemos.\""

#: data/json/speech.json
msgid "an anguished wail!"
msgstr "um grito angustiado!"

#: data/json/speech.json
msgid "\"You're gonna rot in hell for this!\""
msgstr "\"Você vai queimar no inferno por isso!\""

#: data/json/speech.json
msgid "\"You hear me!?\""
msgstr "\"Tá me escutando!?\""

#: data/json/speech.json
msgid "\"You're gonna rot in hell, you pieces of shit!\""
msgstr "\"Vocês vão queimar no inferno, seus merdas!\""

#: data/json/speech.json
msgid "\"Like we said, we have no idea what it's thinking.\""
msgstr "\"Como dissemos, não temos ideia do que está pensando.\""

#: data/json/speech.json
msgid "\"Is that glass electrified?\""
msgstr "\"Esse vidro é eletrificado?\""

#: data/json/speech.json
msgid "\"Why don't you touch it and find out?\""
msgstr "\"Por que você não toca e descobre?'"

#: data/json/speech.json
msgid "\"Of course it is.\""
msgstr "\"Claro que é.\""

#: data/json/speech.json
msgid "\"What'll happen if the power goes out?\""
msgstr "\"O que acontecerá se a energia acabar?\""

#: data/json/speech.json
msgid "\"Don't worry about it.\""
msgstr "\"Não se preocupe com isso.\""

#: data/json/speech.json
msgid "\"Don't worry.\""
msgstr "\"Não se preocupe.\""

#: data/json/speech.json
msgid "\"There are seven backup generators.\""
msgstr "\"Existem sete geradores de backup. \""

#: data/json/speech.json
msgid "\"And what if all the backups fail?\""
msgstr "\"E se todos os backups falharem?\""

#: data/json/speech.json
msgid "\"We'd have to terminate the specimen.\""
msgstr "\"Teríamos que sacrificar o espécime.\""

#: data/json/speech.json
msgid "\"The glass alone won't keep us safe for very long.\""
msgstr "\"O vidro sozinho não nos manterá seguros por muito tempo.\""

#: data/json/speech.json
msgid "\"That fuckin' thing is horrible, man, it gives me the creeps.\""
msgstr "\"Essa porra é horrível, cara, isso me dá arrepios.\""

#: data/json/speech.json
msgid "\"It's probably more scared of us than we are of it.\""
msgstr "\"Aquilo provavelmente tem mais medo de nós do que nós dele.\""

#: data/json/speech.json
msgid "\"Somehow, I doubt that.\""
msgstr "\"De alguma forma, duvido disso.\""

#: data/json/speech.json
msgid "\"Hey, we got other specimens that could withstand a grenade.\""
msgstr ""
"\"Ei, nós temos outros espécimes que poderiam levar uma granada na cara.\""

#: data/json/speech.json
msgid "\"And that's supposed to comfort me?\""
msgstr "\"E isso era pra me deixar mais calmo?\""

#: data/json/speech.json
msgid "\"At least we know they can die.\""
msgstr "\"Pelo menos sabemos que eles podem morrer.\""

#: data/json/speech.json
msgid "\"U-O Seven-Seven-Three-Four.\""
msgstr "\"UO sete-sete-três-quatro. \""

#: data/json/speech.json
msgid "\"Individual instances of U-O Seven-Seven-Three-Four.\""
msgstr "\"Instâncias individuais de UO sete-sete-três-quatro. \""

#: data/json/speech.json
msgid "\"To be kept in a standard biohazardous containment chamber.\""
msgstr ""
"\"Para ser mantido em uma câmara de contenção de risco biológico padrão. \""

#: data/json/speech.json
msgid "\"Until such time as more permanent arrangements are made.\""
msgstr "\"Até que arranjos mais permanentes sejam feitos.\""

#: data/json/speech.json
msgid "\"Shows a noted preference for human brain tissue.\""
msgstr "\"Mostra uma preferência notável pelo tecido cerebral humano.\""

#: data/json/speech.json
msgid "\"Destroy the specimen if it begins to interact with the lock.\""
msgstr "\"Destrua a amostra se ela começar a interagir com a tranca.\""

#: data/json/speech.json
msgid "\"Kill them all and let God sort them out!\""
msgstr "\"Mate todos eles e deixe que Deus os resolva!\""

#: data/json/speech.json
msgid "\"I watched a snail crawl along the edge of a straight razor.\""
msgstr "\"Eu assisti um caracol rastejar ao longo da borda de uma navalha.\""

#: data/json/speech.json
msgid "\"I've seen horrors, horrors that you've seen.\""
msgstr "\"Eu vi horrores, horrores que você também viu.\""

#: data/json/speech.json
msgid "\"I love the smell of napalm in the morning.\""
msgstr "\"Eu amo o cheiro de napalm pela manhã.\""

#: data/json/speech.json
msgid "\"This is the way the fuckin' world ends.\""
msgstr "\"Este é o jeito que a porra do mundo acaba.\""

#: data/json/speech.json
msgid "\"Look at this fuckin' shit we're in, man.\""
msgstr "\"Olha pra essa porra de merda que a gente tá, cara.\""

#: data/json/speech.json
msgid "\"Every man has got a breaking point.\""
msgstr "\"Todo homem quebra uma hora.\""

#: data/json/speech.json
msgid "\"I'ma cut those fuckin' tentacles off, bitch!\""
msgstr "\"Eu vou cortar esses tentáculos, vagabunda!\""

#: data/json/speech.json
msgid "\"Watch you bleed out!\""
msgstr "\"Sangre!\""

#: data/json/speech.json
msgid "\"I wonder if it understands us.\""
msgstr "\"Eu me pergunto se isso aí nos entende.\""

#: data/json/speech.json
msgid "\"Do you understand what I'm saying?\""
msgstr "\"Você entende o que eu estou dizendo?\""

#: data/json/speech.json
msgid "\"Look, it's responding!\""
msgstr "\"Olha, está respondendo!\""

#: data/json/speech.json
msgid "\"That's the first time it moved all morning.\""
msgstr "\"Essa é a primeira vez que se move toda a manhã."

#: data/json/speech.json
msgid "\"I'm certain it's trying to understand us.\""
msgstr "\"Estou tenho certeza que está tentando nos entender.\""

#: data/json/speech.json
msgid "\"I'm not convinced it can actually comprehend us.\""
msgstr "\"Eu não estou convencido de que possa realmente nos compreender.\""

#: data/json/speech.json
msgid "\"It's just repeating us.\""
msgstr "\"Está apenas repetindo o que a gente faz. \""

#: data/json/speech.json
msgid "\"Just being an alien creature doesn't mean it's intelligent.\""
msgstr ""
"\"Só porque é uma criatura alienígena não significa que ela seja "
"inteligente.\""

#: data/json/speech.json
msgid "\"Just because it doesn't look like you doesn't mean that it isn't.\""
msgstr "\"Só porque não se parece com você, não significa que não é.\""

#: data/json/speech.json
msgid "\"Please open the door and enter the cell.\""
msgstr "\"Por favor, abra a porta e entre na cela. \""

#: data/json/speech.json
msgid "\"Would it react differently with a child?\""
msgstr "\"Reagiria diferentemente com uma criança?\""

#: data/json/speech.json
msgid "\"Experiments to determine extent of cognitive abilities still underway.\""
msgstr ""
"\"Experimentos para determinar a extensão das habilidades cognitivas ainda "
"em andamento. \""

#: data/json/speech.json
msgid ""
"\"Subject has so far displayed a total lack of empathy toward human "
"suffering.\""
msgstr ""
"\"O espécime até agora demonstrou total falta de empatia pelo sofrimento "
"humano.\""

#: data/json/speech.json
msgid "\"I got a round trip ticket.\""
msgstr "\"Eu tenho um bilhete de ida e volta.\""

#: data/json/speech.json
msgid "\"How's your mom doing?\""
msgstr "\"Como está sua mãe?\""

#: data/json/speech.json
msgid "\"How's your dad doing?\""
msgstr "\"Como está seu pai?\""

#: data/json/speech.json
msgid "\"I love you.\""
msgstr "\"Eu te amo.\""

#: data/json/speech.json
msgid "\"I love you too.\""
msgstr "\"Eu te amo também.\""

#: data/json/speech.json
msgid "\"Just a little.\""
msgstr "\"Só um pouquinho.\""

#: data/json/speech.json
msgid "\"Only a few more days 'til the weekend.\""
msgstr "\"Apenas mais alguns dias até o fim de semana.\""

#: data/json/speech.json
msgid "\"Do you smoke?\""
msgstr "\"Você fuma?\""

#: data/json/speech.json
msgid "\"You're new here, aren't you?\""
msgstr "\"Você é novo aqui, né?\""

#: data/json/speech.json
msgid "\"How do you like it here?\""
msgstr "\"Gosta daqui? De que jeito?\""

#: data/json/speech.json
msgid "\"It won't hurt a bit.\""
msgstr "\"Não vai doer nada.\""

#: data/json/speech.json
msgid "\"That was a long time ago.\""
msgstr "\"Isso foi há muito tempo atrás.\""

#: data/json/speech.json
msgid "\"Does it scare you?\""
msgstr "\"Isso te assusta?\""

#: data/json/speech.json
msgid "\"Don't worry, it can't hurt us.\""
msgstr "\"Não se preocupe, não pode nos machucar.\""

#: data/json/speech.json
msgid "\"What are you afraid will happen?\""
msgstr "\"O que você tem medo que aconteça?\""

#: data/json/speech.json
msgid "\"Anything else?\""
msgstr "\"Algo mais?\""

#: data/json/speech.json
msgid "\"You think they're the same sex?\""
msgstr "\"Você acha que eles são do mesmo sexo?\""

#: data/json/speech.json
msgid "\"Do they even have sex?\""
msgstr "\"Será que eles têm sexo?\""

#: data/json/speech.json
msgid "\"Can I see your phone?\""
msgstr "\"Posso ver seu telefone?\""

#: data/json/speech.json
msgid "\"You got a dollar I can borrow?\""
msgstr "\"Você tem um dólar pra eu pegar emprestado?\""

#: data/json/speech.json
msgid "\"Are you busy at the moment?\""
msgstr "\"Você está ocupado agora?\""

#: data/json/speech.json
msgid "\"Are you busy later?\""
msgstr "\"Você estará ocupado mais tarde?\""

#: data/json/speech.json
msgid "\"Are you busy tonight?\""
msgstr "\"Você está ocupado esta noite?\""

#: data/json/speech.json
msgid "\"Are you free tonight?\""
msgstr "\"Você está livre hoje à noite?\""

#: data/json/speech.json
msgid "\"Are you going to the party tonight?\""
msgstr "\"Você vai para a festa hoje à noite?\""

#: data/json/speech.json
msgid "\"Are you going to help them?\""
msgstr "\"Você vai ajudá-los?\""

#: data/json/speech.json
msgid "\"Are you alone?\""
msgstr "\"Você está sozinho?\""

#: data/json/speech.json
msgid "\"Are you hungry?\""
msgstr "\"Está com fome?\""

#: data/json/speech.json
msgid "\"I'm hungry.\""
msgstr "\"Eu estou com fome.\""

#: data/json/speech.json
msgid "\"Go ahead.\""
msgstr "\"Continue.\""

#: data/json/speech.json
msgid "\"Have a good time.\""
msgstr "\"Divirta-se.\""

#: data/json/speech.json
msgid "\"Have you eaten yet?\""
msgstr "\"Você já comeu?\""

#: data/json/speech.json
msgid "\"Is it supposed to rain tomorrow?\""
