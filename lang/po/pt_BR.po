msgstr ""
" Este é um tubo de vidro fino com uma lâmpada com uma tigela "
"emumaextremidade. É usado para compartilhar certas substâncias ilícitas."

#: data/json/items/tool/smoking.json
msgid "glass pipe"
msgid_plural "glass pipes"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""

#. ~ Description for {'str': 'glass pipe'}
#: data/json/items/tool/smoking.json
msgid ""
"This is a hand-blown glass pipe.  It's of the type most commonly used to "
"smoke recreational substances."
msgstr ""
" tubo de vidroEste é um tubo de vidro soprado à mão. É do tipo "
"maiscomumenteusado para fumar substâncias recreativas."

#: data/json/items/tool/smoking.json
msgid "glass bong"
msgid_plural "glass bongs"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""

#. ~ Description for {'str': 'glass bong'}
#: data/json/items/tool/smoking.json
msgid ""
"This is a hand-blown glass beaker bong.  Easy to clean, hard to tip over, "
"and functional even after society collapses."
msgstr ""

#: data/json/items/tool/smoking.json
msgid "tobacco pipe"
msgid_plural "tobacco pipes"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""

#. ~ Description for {'str': 'tobacco pipe'}
#: data/json/items/tool/smoking.json
msgid ""
"This is a hand-carved wooden smoking pipe.  It's designed to facilitate "
"consumption of fire cured tobacco leaves."
msgstr ""
" cachimbo de tabacoEste é um cachimbo de madeira entalhado à mão. "
"Eleéprojetado para facilitar o consumo de folhas de tabaco curadas pelo "
"fogo."

#. ~ Use action activation_message for {'str': 'dab pen'}.
#: data/json/items/tool/smoking.json
msgid "You hit your dab pen. Sooooo smooth..."
msgstr ""

#. ~ Description for {'str': 'dab pen'}
#: data/json/items/tool/smoking.json
msgid ""
"This is a dab pen for vaporizing cannabis.  Now all you need is 'thc "
"distillate' and you're ready to rock and roll."
msgstr ""

#: data/json/items/tool/smoking.json
msgid "disposable dab pen"
msgid_plural "disposable dab pens"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""

#. ~ Use action activation_message for {'str': 'disposable dab pen'}.
#: data/json/items/tool/smoking.json
msgid "You hit your disposable dab pen. Sooooo smooth..."
msgstr ""

#. ~ Description for {'str': 'disposable dab pen'}
#: data/json/items/tool/smoking.json
msgid ""
"This is a disposable dab pen for vaporizing cannabis.  This one is already "
"filled with distillate for your convenience, but can't be recharged."
msgstr ""

#: data/json/items/tool/smoking.json
msgid "nectar collector"
msgid_plural "nectar collectors"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""

#. ~ Use action activation_message for {'str': 'nectar collector'}.
#: data/json/items/tool/smoking.json
msgid "You heat the nectar collector and hit it. Sooooo smooth..."
msgstr ""

#. ~ Description for {'str': 'nectar collector'}
#: data/json/items/tool/smoking.json
msgid ""
"This is a metal and wooden nectar collector.  The top cover can be attached "
"and detached magnetically.  The wood has engravings depicting bees, honey, "
"and flowers.  You need 'thc wax' to use this item."
msgstr ""

#: data/json/items/tool/stationary.json
msgid "stapler"
msgid_plural "staplers"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""

#. ~ Description for {'str': 'stapler'}
#: data/json/items/tool/stationary.json
msgid "A stapler for fastening sheets of paper together."
msgstr ""

#: data/json/items/tool/stationary.json
msgid "pen"
msgid_plural "pens"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""

#. ~ Description for {'str': 'pen'}
#: data/json/items/tool/stationary.json
msgid "A plastic ball point pen."
