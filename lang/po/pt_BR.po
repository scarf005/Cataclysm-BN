msgstr[1] "faunos"
msgstr[2] "faunos"

#. ~ Description for {'str': 'fawn'}
#: data/json/monsters/mammal.json
msgid ""
"A juvenile northern woodland white-tailed deer, a quick and strong grazing "
"animal.  Favored prey of coyotes, wolves, and giant spider mutants."
msgstr ""
" Um cervo branco-atado da floresta do norte juvenil, um animal de pastagem "
"rápido e forte. Presas favorecidas de coiotes, lobos e aranhas gigantes "
"mutantes."

