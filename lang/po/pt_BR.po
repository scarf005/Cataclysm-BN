#: data/json/speech.json
msgid "\"Good night.\""
msgstr "\\'Boa noite.\""

#: data/json/speech.json
msgid "\"Good luck.\""
msgstr "\\'Boa sorte.\""

#: data/json/speech.json data/mods/CrazyCataclysm/crazy_speech.json
msgid "\"Can I help you?\""
msgstr "\\'Posso ajudar?\""

#: data/json/speech.json
msgid "\"Are you seeing anyone?\""
msgstr "\\'Você está vendo alguém?\""

#: data/json/speech.json
msgid "\"Forget it.\""
msgstr "\\'Esqueça.\""

#: data/json/speech.json
msgid "\"How long were you two together?\""
msgstr "'Quanto tempo vocês dois estavam juntos?"

#: data/json/speech.json
msgid "\"Give me a call later.\""
msgstr "\\'Me ligue mais tarde.\""

#: data/json/speech.json
msgid "\"Call me.\""
msgstr "\\'Me liga.\""

#: data/json/speech.json
msgid "\"From time to time.\""
msgstr "\\'De tempos em tempos.\""

#: data/json/speech.json
msgid "\"We have a serious situation here.\""
msgstr "'Nós temos uma situação séria aqui."

#: data/json/speech.json
msgid "\"Call the police.\""
msgstr "\\'Chame a polícia.\""

#: data/json/speech.json
msgid "\"Call an ambulance.\""
msgstr "\\'Chame uma ambulância.\""

#: data/json/speech.json
msgid "\"Get me the White House.\""
msgstr "'Pegue-me a Casa Branca."

#: data/json/speech.json
msgid "\"Are you feeling all right?\""
msgstr "\\'Você está se sentindo bem?\""

#: data/json/speech.json
msgid "\"I think I'll live.\""
msgstr "'Eu acho que vou viver."

#: data/json/speech.json
msgid "\"I think I need to see a doctor.\""
msgstr "'Eu acho que preciso ver um médico."

#: data/json/speech.json
msgid "\"Is everything all right?\""
msgstr "\\'Está tudo bem?\""

#: data/json/speech.json
msgid "\"I'm okay, don't worry about me.\""
msgstr "'Eu estou bem, não se preocupe comigo."

#: data/json/speech.json
msgid "\"It's just a scratch.\""
msgstr "'É apenas um arranhão."

#: data/json/speech.json
msgid "\"I've got a headache.\""
msgstr "\\'Eu estou com dor de cabeça.\""

#: data/json/speech.json
msgid "\"I'm fine.\""
msgstr "\\'Estou bem.\""

#: data/json/speech.json
msgid "\"Are you sure?\""
msgstr "\\'Você tem certeza?\""

#: data/json/speech.json
msgid "\"Positive.\""
msgstr "\\'Positivo.\""

#: data/json/speech.json
msgid "\"Affirmative.\""
msgstr "\\ 'Afirmativo. \""

#: data/json/speech.json
msgid "\"Negative.\""
msgstr "\\'Negativo.\""

#: data/json/speech.json data/mods/CrazyCataclysm/crazy_speech.json
msgid "\"Sorry.\""
