msgstr "하지만 아무 일도 일어나지 않았다."

#: src/monattack.cpp
#, c-format
msgid "The %s takes a powerful swing at you, but you dodge it!"
msgstr "%s(이)가 강력한 공격을 휘둘렀지만, 피했다!"

#: src/monattack.cpp
#, c-format
msgid "The %s takes a powerful swing at <npcname>, who dodges it!"
msgstr "%s(이)가 <npcname>에게 강력한 공격을 휘둘렀지만, 피했다!"

#: src/monattack.cpp
#, c-format
msgid "A blow from %1$s sends %2$s flying!"
msgstr "%1$s(이)가 %2$s(을)를 후려쳐 날려버립니다!"

#: src/monattack.cpp
#, c-format
msgid "A blow from %s sends <npcname> flying!"
msgstr "%s(이)가 <npcname>(을)를 후려쳐 날려버립니다!"

#: src/monattack.cpp
#, c-format
msgid "%1$s fires a shimmering beam towards %2$s!"
msgstr "%1$s(이)가 %2$s(을)를 향해 희미한 광선을 쏘아냅니다!"

#: src/monattack.cpp
msgid "You dodge the beam!"
msgstr "광선을 피했다!"

#: src/monattack.cpp
msgid "<npcname> dodges the beam!"
msgstr "<npcname>(이)가 광선을 피했다!"

#: src/monattack.cpp
msgid "Your armor protects you from the radiation!"
msgstr "갑옷이 방사능을 막아줬다."

#: src/monattack.cpp
msgid "You get pins and needles all over."
msgstr "핀과 바늘이 온몸에 꽂혔다."

#: src/monattack.cpp
#, c-format
msgid "A manhack flies out of one of the holes on the %s!"
msgstr "맨핵이 %s에 난 구멍으로부터 날아오릅니다!"

#: src/monattack.cpp
#, c-format
msgid ""
"The %s shudders, and some sort of caustic fluid leaks from a its damaged "
"shell!"
msgstr "%s(이)가 몸을 떨더니, 손상된 껍질에서 일종의 부식성 액체가 새어 나옵니다!"

#: src/monattack.cpp
#, c-format
msgid "The %s shudders, letting out an eery metallic whining noise!"
msgstr "%s(이)가 섬뜩한 금속성 윙윙 소리를 내며 몸을 떱니다!"

#: src/monattack.cpp
#, c-format
msgid "The %s scratches its long legs along the floor, shooting sparks."
msgstr "%s(이)가 긴 다리로 바닥을 긁으며 불꽃을 일으킵니다."

#: src/monattack.cpp
#, c-format
msgid "The %s bleeps inquiringly and focuses a red camera-eye on you."
msgstr "%s(이)가 미심쩍은듯 삑삑거리며 붉은색 카메라-눈의 초점을 당신에게 맞춥니다."

#: src/monattack.cpp
#, c-format
msgid "The %s's combat arms crackle with electricity."
msgstr "%s의 전투 팔에서 전류가 파직거리고 있다."

#. ~ %s is bodypart name in accusative.
#: src/monattack.cpp
#, c-format
msgid "A tree bursts forth from the earth and pierces your %s!"
msgstr "나뭇가지가 땅속에서 튀어나와 %s(을)를 관통했다!"

#. ~ %s is bodypart name in accusative.
#: src/monattack.cpp
#, c-format
msgid "A tree bursts forth from the earth and pierces <npcname>'s %s!"
msgstr "나뭇가지가 땅속에서 튀어나와 <npcname>의 %s(을)를 관통했다!"

#. ~ %s is bodypart name in accusative.
#: src/monattack.cpp
#, c-format
msgid "The underbrush beneath your feet grows and pierces your %s!"
msgstr "발밑의 덤불이 자라나 %s(을)를 관통했다!"

#. ~ %s is bodypart name in accusative.
#: src/monattack.cpp
#, c-format
msgid "Underbrush grows into a tree, and it pierces <npcname>'s %s!"
msgstr "덤불이 나무로 자라나 <npcname>의 %s(을)를 관통했다!"

#. ~ 1$s monster name(vine), 2$s bodypart in accusative
#: src/monattack.cpp
#, c-format
msgid "The %1$s lashes your %2$s!"
msgstr "%1$s(이)가 %2$s(을)를 묶는다!"

#: src/monattack.cpp
#, c-format
msgid "The %1$s lashes <npcname>'s %2$s!"
msgstr "%1$s(이)가 <npcname>의 %2$s(을)를 후려친다!"

#: src/monattack.cpp
msgid "thu-THUMP."
msgstr "쿠-쿵."

#: src/monattack.cpp
msgid "The root walls creak around you."
msgstr "주위에 있는 식물로 된 벽이 삐걱거린다."

#: src/monattack.cpp
#, c-format
msgid "Spores are released from the %s!"
msgstr "포자가 %s에서 뿜어져 나온다!"

#: src/monattack.cpp
#, c-format
msgid "The %s pulses, and fresh fungal material bursts forth."
msgstr "%s(이)가 맥박 치고 신선한 진균 물질을 뿌립니다."

#: src/monattack.cpp
#, c-format
msgid "The %s suddenly inhales!"
msgstr "%s(은)는 숨을 들이마신다!"

#. ~Sound of a giant fungal blossom inhaling
#: src/monattack.cpp
msgid "WOOOSH!"
msgstr "후우우웁!"

#: src/monattack.cpp
#, c-format
msgid "The %s discharges an immense flow of spores, smothering the flames!"
msgstr "%s는 엄청난 양의 포자를 토해내 불꽃을 막았다!"

#. ~Sound of a giant fungal blossom blowing out the dangerous fire!
#: src/monattack.cpp
msgid "POUFF!"
msgstr "푸와아아아!"

#. ~ That spore sound, much louder
#: src/monattack.cpp
msgid "POUF."
msgstr "푸우우웁."

#: src/monattack.cpp
#, c-format
msgid "The %s pulses, and fresh fungal material bursts forth!"
msgstr "%s(이)가 꿈틀거리더니, 갑자기 새로운 진균 물질을 뿜어냈다!"

#: src/monattack.cpp
#, c-format
msgid "The %s seems to wave you toward the tower…"
msgstr "%s(이)가 당신을 탑을 향해 보내려 합니다..."

#: src/monattack.cpp
#, c-format
msgid "The %s jabs at you with a needlelike point!"
msgstr "%s(은)는 계속 바늘을 찔렀다!"

#. ~ 1$s is monster name, 2$s bodypart in accusative
#: src/monattack.cpp
#, c-format
msgid "The %1$s sinks its point into your %2$s!"
msgstr "%1$s의 바늘이 깊숙히 %2$s를 찔렀다!"

#: src/monattack.cpp
msgid "You feel thousands of live spores pumping into you…"
msgstr "수천은 족히 될 살아있는 포자가 당신의 안으로 밀려들어오는게 느껴집니다..."

#. ~ 1$s is monster name, 2$s bodypart in accusative
#: src/monattack.cpp
#, c-format
msgid "The %1$s strikes your %2$s, but your armor protects you."
msgstr "%1$s(이)가 %2$s(을)를 공격했지만,방어구에 막혔다."

#: src/monattack.cpp
#, c-format
msgid "The %s recedes, as if anticipating your arrival…"
msgstr "%s(이)가 당신이 다다를 것을 예측한듯 물러납니다..."

#: src/monattack.cpp
#, c-format
msgid "%1$s swipes at %2$s with a barbed tendril!"
msgstr "%1$s(이)가 %2$s(을)를 향해 가시 덩굴을 휘두릅니다!"

#. ~ 1$s is monster name, 2$s bodypart in accusative
#: src/monattack.cpp
#, c-format
msgid "The %1$s sinks several needlelike barbs into your %2$s!"
msgstr "%1$s의 가시가 여러가닥%2$s에 박혔다!"

#. ~ 1$s is monster name, 2$s bodypart in accusative
#: src/monattack.cpp
#, c-format
msgid "The %1$s slashes your %2$s, but your armor protects you."
msgstr "%1$s(이)가  %2$s(을)를 베어내려 했지만, 방어구로 막혔다."

#: src/monattack.cpp
#, c-format
msgid "The %s grows into an adult!"
msgstr "%s는 성체로 성장했습니다!"

#: src/monattack.cpp
msgid "You're shoved away as a fungal wall grows!"
msgstr "진균체 벽이 자라나면서, 벽에 떠밀렸습니다!"

#: src/monattack.cpp
#, c-format
msgid "The %s spreads its tendrils.  It seems as though it's expecting you…"
msgstr "%s(이)가 덩굴손을 뻗습니다. 당신을 노리는 것 같습니다..."

#: src/monattack.cpp
msgid ""
"The tower extends and aims several tendrils from its depths.  Hold still?"
msgstr "탑이 심연으로부터 여러 덩굴손을 뻗어 조준해옵니다. 가만히 기다립니까?"

#: src/monattack.cpp
#, c-format
msgid ""
"The %s works several tendrils into your arms, legs, torso, and even neck…"
msgstr "%s(이)가 당신의 팔, 다리, 몸통, 그리고 목까지 여러 덩굴손을 뻗습니다..."

#: src/monattack.cpp
msgid ""
"You see a clear golden liquid pump through the tendrils--and then lose "
"consciousness."
msgstr "덩굴이 맥동하면서 황금빛 액체를 나르는 모습을 보자 실신했다."

#: src/monattack.cpp
msgctxt "memorial_male"
msgid "Was shown to the Marloss Gateway."
msgstr "말로스 관문에 노출되었습니다."

#: src/monattack.cpp
msgctxt "memorial_female"
msgid "Was shown to the Marloss Gateway."
msgstr "말로스 관문에 노출되었습니다."

#. ~ Beginning to hear the Mycus while conscious: this is it speaking
#: src/monattack.cpp
msgid ""
"assistance, on an arduous quest.  unity.  together we have reached the door."
"  now to pass through…"
msgstr "고난한 여정, 도움. 합일. 문에 도달, 함께. 지나갈 때..."

#: src/monattack.cpp
msgid "You're shoved away as a fungal hedgerow grows!"
msgstr "진균체 울타리가 자라나면서, 벽에 떠밀렸습니다!"

#. ~ %s is bodypart name in accusative.
#: src/monattack.cpp
#, c-format
msgid "A fungal tendril bursts forth from the earth and pierces your %s!"
msgstr "진균체 덩굴이 땅속에서 튀어나와 %s(을)를 관통했다!"

#: src/monattack.cpp
msgid "A fungal tendril bursts forth from the earth!"
msgstr "진균체 덩굴이 땅속에서 튀어나옵니다!"

#: src/monattack.cpp
#, c-format
msgid "The %s takes aim, and spears at you with a massive tendril!"
msgstr "%s(은)는 거대한 덩굴손이 찌르는것을 팔로 막았다!"

#: src/monattack.cpp
msgid "You feel millions of live spores pumping into you…"
msgstr "수백만은 족히 될 살아있는 포자가 당신의 안으로 밀려들어오는게 느껴집니다..."

#. ~ 1$s is monster name, 2$s bodypart in accusative
#: src/monattack.cpp
#, c-format
msgid "The %1$s impales your torso!"
msgstr "%1$s(이)가 당신의 몸을 찔렀다!"

#. ~ 1$s is monster name, 2$s bodypart in accusative
#: src/monattack.cpp
#, c-format
msgid "The %1$s impales <npcname>'s torso!"
msgstr "%1$s(이)가 <npcname>의 몸을 찔렀다!"

#: src/monattack.cpp
#, c-format
msgid ""
"The %1$s tries to impale your torso, but fails to penetrate your armor!"
msgstr "%1$s(이)가 당신의 상체를 꿰뚫으려 했으나, 방어구를 뚫지 못했습니다!"

#: src/monattack.cpp
#, c-format
msgid ""
"The %1$s tries to impale <npcname>'s torso, but fails to penetrate their "
"armor!"
msgstr "%1$s(이)가 <npcname>의 상체를 꿰뚫으려 했으나, 방어구를 뚫지 못했습니다!"

#: src/monattack.cpp
#, c-format
msgid "The %s tries to land on you, but you dodge."
msgstr "%s(이)가 몸에 닿을 뻔 했지만, 피했다."

#: src/monattack.cpp
#, c-format
msgid "You swat at the %s with your tail!"
msgstr "꼬리로 %s(을)를 때려잡았다!"

#: src/monattack.cpp
#, c-format
msgid "The %s lands on you, but you swat it off."
msgstr "%s(이)가 몸에 붙었지만, 떼어냈다."

#. ~ 1$s monster name(dermatik), 2$s bodypart name in accusative.
#: src/monattack.cpp
#, c-format
msgid "The %1$s lands on your %2$s, but can't penetrate your armor."
msgstr "%1$s(이)가 %2$s의 몸에 붙었지만,방어구가 막지 못했다."

#. ~ 1$s monster name(dermatik), 2$s bodypart name in accusative.
#: src/monattack.cpp
#, c-format
msgid "The %1$s sinks its ovipositor into your %2$s!"
msgstr "%1$s의 산란관이 %2$s에 파고들었다!"

#: src/monattack.cpp
#, c-format
msgid "The %s dermatik larva grows into an adult!"
msgstr "(%s) 더마틱 유충이 성장했다!"

#: src/monattack.cpp
#, c-format
msgid "The %s takes seed and becomes a young fungaloid!"
msgstr "%s(이)가 씨앗을 들이켜 어린 진균체로 변이됩니다!"

#: src/monattack.cpp
#, c-format
msgid "The %s suddenly splits and bursts!"
msgstr "%s(이)가 느닷없이 갈라지며 터져나옵니다!"

#: src/monattack.cpp
#, c-format
msgid "%s is engulfed by %s!"
msgstr "%s(은)는 %s에 의해 완전히 둘러싸였다!"

#: src/monattack.cpp
#, c-format
msgid "The %s lets out a high-pitched cry!"
msgstr "%s(은)는 높은 고음을 외쳤다!"

#: src/monattack.cpp
#, c-format
msgid "The %s swings its arms from side to side!"
msgstr "%s(은)는 팔을 양쪽으로 흔들었다!"

#: src/monattack.cpp
#, c-format
msgid "The %s does some fancy footwork!"
msgstr "%s(은)는 멋진 풋워크를 하고있다!"

#: src/monattack.cpp
#, c-format
msgid "The %s shrugs its shoulders!"
msgstr "%s(은)는 어깨를 으쓱인다!"

#: src/monattack.cpp
#, c-format
msgid "The %s spins in place!"
msgstr "%s(이)가 제자리에서 빙빙 돕니다!"

#: src/monattack.cpp
#, c-format
msgid "The %s crouches on the ground!"
msgstr "%s(은)는 땅에 누웠다!"

#: src/monattack.cpp
#, c-format
msgid "The %s looks left and right!"
msgstr "%s(은)는 양쪽을 봤다!"

#: src/monattack.cpp
#, c-format
msgid "The %s jumps back and forth!"
msgstr "%s(은)는 앞뒤로 뛰었다!"

#: src/monattack.cpp
#, c-format
msgid "The %s raises its arms in the air!"
msgstr "%s(은)는 공중으로 손을 들어올립니다!"

#: src/monattack.cpp
#, c-format
msgid "The %s swings its hips!"
msgstr "%s(은)는 힘차게 허리를 흔들었다!"

#: src/monattack.cpp
#, c-format
msgid "The %s claps!"
msgstr "%s(이)가 박수를 치다!"

#: src/monattack.cpp
#, c-format
msgid "The %s's head explodes in a mass of roiling tentacles!"
msgstr "%s의 머리에서 촉수들이 터져나와 꿈틀거린다!"

#: src/monattack.cpp
#, c-format
msgid "The %s lashes its tentacle at you!"
msgstr "%s의 촉수가 뻗어옵니다!"

#: src/monattack.cpp
#, c-format
msgid "The %s lashes its tentacle at <npcname>!"
msgstr "%s(이)가 <npcname>에게 촉수를 뻗습니다!"

#. ~ 1$s is bodypart name, 2$d is damage value.
#: src/monattack.cpp
#, c-format
msgid "Your %1$s is hit for %2$d damage!"
msgstr "%1$s에 %2$d 피해를 받습니다!"

#. ~ 1$s is bodypart name, 2$d is damage value.
#: src/monattack.cpp
#, c-format
msgid "<npcname>'s %1$s is hit for %2$d damage!"
msgstr "<npcname>(이)가 %1$s에 %2$d 피해를 받습니다!"

#: src/monattack.cpp
#, c-format
msgid "The %1$s lashes its tentacle at your %2$s, but glances off your armor!"
msgstr "%1$s(이)가 %2$s에 촉수를 뻗어왔지만, 보호구에 막힙니다!"

#: src/monattack.cpp
#, c-format
msgid ""
"The %1$s lashes its tentacle at <npcname>'s %2$s, but glances off their "
"armor!"
msgstr "%1$s(이)가 <npcname>의 %2$s에 촉수를 뻗어왔지만, 보호구에 막힙니다!"

#: src/monattack.cpp
#, c-format
msgid "The %s's arms fly out at you, but you dodge!"
msgstr "%s의 팔이 날아왔지만, 피했다!"

#: src/monattack.cpp
#, c-format
msgid "The %s's arms fly out at <npcname>, but they dodge!"
msgstr "%s의 팔이 날아왔지만 <npcname>(은)는 피했다!"

#: src/monattack.cpp
#, c-format
msgid "%1$s's arms fly out and pull and grab %2$s!"
msgstr "%1$s의 팔이 날아들어 %2$s(을)를 움켜쥡니다!"

#: src/monattack.cpp
#, c-format
msgid "%1$s reaches out and pulls %2$s!"
msgstr "%1$s(이)가 몸을 뻗어 %2$s(을)를 잡아당깁니다!"

#: src/monattack.cpp
#, c-format
msgid "The %s gropes at you, but you dodge!"
msgstr "%s(이)가 잡으려 했지만, 피했다!"

#: src/monattack.cpp
#, c-format
msgid "The %s gropes at <npcname>, but they dodge!"
msgstr "%s(이)가 <npcname>(을)를 잡으려 했지만, 피했다!"

#: src/monattack.cpp
#, c-format
msgid "The %s tries to grab you as well, but you bat it away!"
msgstr "%s(이)가 당신을 붙잡으려 했지만, 쳐내버렸습니다!"

#: src/monattack.cpp
#, c-format
msgid "The %s tries to grab you…"
msgstr "%s(이)가 당신을 붙잡으려고 시도한다..."

#: src/monattack.cpp
#, c-format
msgid "The %s grabs <npcname>!"
msgstr "%s(이)가 <npcname>(을)를 붙잡았다!"

#: src/monattack.cpp
#, c-format
msgid "The %s grabs you!"
msgstr "%s에 붙잡혔다!"

#: src/monattack.cpp
#, c-format
msgid "The %s tries to drag you, but you're securely fastened in the autodoc."
msgstr "%s이 당신을 끌고 가려고 했지만, 오토닥에 단단히 고정되어 있었습니다."

#: src/monattack.cpp
#, c-format
msgid ""
"The %s tries to drag <npcname>, but they're securely fastened in the "
"autodoc."
msgstr "%s이 <npcname>을 끌고 가려고 했지만, 오토닥에 단단히 고정되어 있었습니다."

#: src/monattack.cpp
#, c-format
msgid "You are dragged behind the %s!"
msgstr "%s에게 잡아당겨집니다!"

#: src/monattack.cpp
#, c-format
msgid "<npcname> gets dragged behind the %s!"
msgstr "<npcname>(이)가 %s 에게 끌려갑니다!"

#: src/monattack.cpp
#, c-format
msgid "You resist the %s as it tries to drag you!"
msgstr "%s(이)가 당신을 끌어내려고 했지만 벗어났다!"

#: src/monattack.cpp
#, c-format
msgid "<npcname> resist the %s as it tries to drag them!"
msgstr "%s(이)가 <npcname>(을)를 끌어내려고 했지만 벗어났다!"

#: src/monattack.cpp
msgid "You feel poison enter your body!"
msgstr "몸에 독이 퍼지는 것을 느꼈다!"

#: src/monattack.cpp
#, c-format
msgid "The %s young triffid grows into an adult!"
msgstr "(%s) 어린 트리피드가 성장했다!"

#: src/monattack.cpp
msgid "You feel a strange reverberation across your body."
msgstr "몸 전체에 퍼지는 이상한 전율을 느꼈다."

#: src/monattack.cpp
#, c-format
msgid "The %s stares at you, and you shudder."
msgstr "%s(이)가 당신을 바라보자, 당신의 몸이 떨리기 시작한다."

#: src/monattack.cpp
msgid "You feel like you're being watched, it makes you sick."
msgstr "무언가가 날 바라보는 것 같아 불편한 기분이 든다."

#: src/monattack.cpp
#, c-format
msgid "The %s probes your mind, but is rebuffed!"
msgstr "%s(이)가 당신의 머릿속을 들여다보려 했지만, 실패했습니다!"

#: src/monattack.cpp
#, c-format
msgid "The terrifying visage of the %s paralyzes you."
msgstr "%s의 충격적인 얼굴을 보자 몸이 마비되었습니다."

#: src/monattack.cpp
#, c-format
msgid "You manage to avoid staring at the horrendous %s."
msgstr "끔찍하게 생긴 %s에서 시선을 돌리는데 성공했다."

#: src/monattack.cpp
msgid "You get a medical check-up."
msgstr "건강검진을 받았습니다."

#: src/monattack.cpp
#, c-format
msgid "The %s is scanning its surroundings."
msgstr "%s이 주변을 스캔합니다."

#: src/monattack.cpp
#, c-format
msgid ""
"a soft robotic voice say, \"Welcome doctor %s.  I'll be your assistant "
"today.\""
msgstr "부드러운 로봇 음성이 들립니다. \"환영합니다, %s 선생님, 수술 보조를 도와드리겠습니다.\" "

#: src/monattack.cpp
#, c-format
msgid "The %s doesn't seem to register you as a doctor."
msgstr "%s(이)가 당신을 의사로 보는 것 같지는 않습니다."

