msgstr "\"오 맙소사, 대체 무슨 일이 벌어지고 있는 거야?\""

#: src/player_hardcoded_effects.cpp
msgid "\"Of course… it's all fractals!\""
msgstr "\"당연하지... 전부 프랙탈이야!\""

#: src/player_hardcoded_effects.cpp
msgid "\"Huh?  What was that?\""
msgstr "\"흠? 방금 그게 뭐였지?\""

#: src/player_hardcoded_effects.cpp
msgid "Fractal patterns dance across your vision."
msgstr "눈 앞에 프랙탈 형상이 춤을 춥니다."

#: src/player_hardcoded_effects.cpp
msgid "Dancing fractals distract you."
msgstr "춤추는 프랙탈 형상이 거슬립니다."

#: src/player_hardcoded_effects.cpp
msgid "Everything looks SO boring now."
msgstr "모든 것이 아주 심심하고 뻔해보입니다."

#: src/player_hardcoded_effects.cpp
msgid "Things are returning to normal."
msgstr "뭔가 정상으로 돌아가는 것 같습니다."

#: src/player_hardcoded_effects.cpp
msgid "Your thoughts are unclear."
msgstr "사고력이 흐려집니다."

#: src/player_hardcoded_effects.cpp
msgid "Your face is stiff from the cold."
msgstr "추워서 얼굴이 뻣뻣해졌습니다."

#: src/player_hardcoded_effects.cpp
msgid "You quiver from the cold."
msgstr "추위에 몸이 약간 떨립니다."

#: src/player_hardcoded_effects.cpp
msgid "Your torso is freezing cold.  You should put on a few more layers."
msgstr "몸통이 얼어붙을 것처럼 차갑습니다. 더 걸쳐야 합니다."

#: src/player_hardcoded_effects.cpp
msgid "Your shivering makes you unsteady."
msgstr "몸이 떨려서 가누기 힘듭니다."

#: src/player_hardcoded_effects.cpp
msgid "Your left arm is shivering."
msgstr "왼팔이 떨립니다."

#: src/player_hardcoded_effects.cpp
msgid "Your left arm trembles from the cold."
msgstr "추위에 왼팔이 떨립니다."

#: src/player_hardcoded_effects.cpp
msgid "Your right arm is shivering."
msgstr "오른팔이 떨립니다."

#: src/player_hardcoded_effects.cpp
msgid "Your right arm trembles from the cold."
msgstr "추위에 오른팔이 떨립니다."

#: src/player_hardcoded_effects.cpp
msgid "Your left hand feels like ice."
msgstr "왼손이 얼음장 같습니다."

#: src/player_hardcoded_effects.cpp
msgid "Your left hand quivers in the cold."
msgstr "추위에 왼손이 약간 떨립니다."

#: src/player_hardcoded_effects.cpp
msgid "Your right hand feels like ice."
msgstr "오른손이 얼음장 같습니다."

#: src/player_hardcoded_effects.cpp
msgid "Your right hand quivers in the cold."
msgstr "추위에 오른손이 약간 떨립니다."

#: src/player_hardcoded_effects.cpp
msgid "Your left leg trembles against the relentless cold."
msgstr "냉혹한 추위에 왼다리가 떨립니다."

#: src/player_hardcoded_effects.cpp
msgid "Your legs uncontrollably shake from the cold."
msgstr "추위에 다리가 견딜 수 없이 심하게 떨립니다."

#: src/player_hardcoded_effects.cpp
msgid "Your right leg trembles against the relentless cold."
msgstr "냉혹한 추위에 오릅니다리가 떨립니다."

#: src/player_hardcoded_effects.cpp
msgid "Your left foot feels frigid."
msgstr "왼발이 차갑습니다."

#: src/player_hardcoded_effects.cpp
msgid "Your left foot is as nimble as a block of ice."
msgstr "왼발이 얼음덩이같고 도무지 움직이질 않습니다."

#: src/player_hardcoded_effects.cpp
msgid "Your freezing left foot messes up your balance."
msgstr "왼발이 얼어붙어서 균형을 망칩니다!"

#: src/player_hardcoded_effects.cpp
msgid "Your right foot feels frigid."
msgstr "오른발이 차갑습니다."

#: src/player_hardcoded_effects.cpp
msgid "Your right foot is as nimble as a block of ice."
msgstr "오른발이 얼음덩이같고 도무지 움직이질 않습니다."

#: src/player_hardcoded_effects.cpp
msgid "Your freezing right foot messes up your balance."
msgstr "오른발이 얼어붙어서 균형을 망칩니다!"

#: src/player_hardcoded_effects.cpp
msgid "Your head is pounding from the heat."
msgstr "열기 때문에 머리가 지끈거립니다."

#: src/player_hardcoded_effects.cpp
msgid "You are sweating profusely."
msgstr "땀이 심하게 납니다."

#: src/player_hardcoded_effects.cpp
msgid "Your left hand's too sweaty to grip well."
msgstr "왼손에 땀이 너무 많아서 뭔가를 붙잡기가 어렵습니다."

#: src/player_hardcoded_effects.cpp
msgid "Your right hand's too sweaty to grip well."
msgstr "오른손에 땀이 너무 많아서 뭔가를 붙잡기가 어렵습니다."

#: src/player_hardcoded_effects.cpp
msgid "Your left leg is cramping up."
msgstr "왼 다리에 경련이 오기 시작합니다."

#: src/player_hardcoded_effects.cpp
msgid "Your right leg is cramping up."
msgstr "오른 다리에 경련이 오기 시작합니다."

#: src/player_hardcoded_effects.cpp
msgid "Your left foot is swelling in the heat."
msgstr "열기 때문에 왼발이 부어오릅니다."

#: src/player_hardcoded_effects.cpp
msgid "Your right foot is swelling in the heat."
msgstr "열기 때문에 오른발이 부어오릅니다."

#: src/player_hardcoded_effects.cpp
msgid "The heat is making you see things."
msgstr "열기 때문에 헛것이 보입니다."

#: src/player_hardcoded_effects.cpp
msgid "You have trouble grasping with your numb fingers."
msgstr "손이 얼어있어 붙잡는데 어려움이 있습니다."

#: src/player_hardcoded_effects.cpp
msgid "Your foot has gone numb."
msgstr "발에 감각이 없습니다."

#: src/player_hardcoded_effects.cpp
msgid "Your face feels numb."
msgstr "얼굴에 감각이 없습니다."

#: src/player_hardcoded_effects.cpp
msgid "Your flesh crawls; insects tear through the flesh and begin to emerge!"
msgstr "살이 꿈틀거리더니, 벌레가 살을 찢고 튀어나왔습니다!"

#: src/player_hardcoded_effects.cpp
msgid "Insects begin to emerge from <npcname>'s skin!"
msgstr "벌레가 <npcname>의 살을 찢고 튀어나왔습니다!"

#. ~ %s is bodypart in accusative.
#: src/player_hardcoded_effects.cpp
#, c-format
msgid "You start scratching your %s!"
msgstr "%s(을)를 긁어댑니다!"

#. ~ 1$s is NPC name, 2$s is bodypart in accusative.
#: src/player_hardcoded_effects.cpp
#, c-format
msgid "%1$s starts scratching their %2$s!"
msgstr "%1$s(이)가 %2$s(을)를 긁어댑니다!"

#: src/player_hardcoded_effects.cpp
msgid "Why waste your time on that insignificant speck?"
msgstr "왜 그런 쓸데없는 것에 시간을 낭비합니까?"

#: src/player_hardcoded_effects.cpp
msgid ""
"You feel something reaching out to you, before reality around you frays!"
msgstr "무언가가 당신에게 다가오려 하는 느낌이 들고, 현실이 뒤틀립니다!"

#: src/player_hardcoded_effects.cpp
msgid "You pass out from the strain of something bearing down on your mind."
msgstr "당신의 마음을 짓누르는 구속에 짓눌려 의식을 잃습니다."

#: src/player_hardcoded_effects.cpp
msgid "You feel something probing your mind, but it is rebuffed!"
msgstr "무언가가 당신의 머릿속을 들여다보려 했지만, 실패했습니다!"

#: src/player_hardcoded_effects.cpp
msgid "A terrifying image in the back out your mind paralyzes you."
msgstr "마음속에서 스며나온 끔찍한 광경이 당신을 마비시킵니다."

#: src/player_hardcoded_effects.cpp
msgid "You feel a buzzing in the back of your mind, but it passes."
msgstr "마음 한구석에서 무언가가 웅웅대는게 느껴지지만, 이내 사라집니다."

#: src/player_hardcoded_effects.cpp
msgid "You feel something scream in the back of your mind!"
msgstr "마음 한구석에서 무언가가 비명지르는 것이 느껴집니다!"

#: src/player_hardcoded_effects.cpp
msgid "Your vision is filled with bright lights…"
msgstr "시야가 밝은 빛으로 채워집니다..."

#: src/player_hardcoded_effects.cpp
msgid "A wave of nausea passes over you."
msgstr "참을 수 없는 구역질이 솟구칩니다."

#: src/player_hardcoded_effects.cpp
msgid "Shifting shapes dance on the edge of your vision."
msgstr "시야 끄트머리에서 뭔가가 꾸물거립니다."

#: src/player_hardcoded_effects.cpp
msgid "You feel weird for a moment, but it passes."
msgstr "한순간 위화감을 느끼지만, 이내 사라집니다."

#: src/player_hardcoded_effects.cpp
msgid "Glowing lights surround you, and you teleport."
msgstr "반짝이는 빛에 휩싸이며 순간이동했습니다."

#: src/player_hardcoded_effects.cpp
msgid "You are beset with a vision of a prowling beast."
msgstr "배회하는 짐승의 환영에 사로잡힙니다."

#: src/player_hardcoded_effects.cpp
msgid "Your surroundings are permeated with a foul scent."
msgstr "주변이 더러운 냄새로 스며들고 있습니다."

#: src/player_hardcoded_effects.cpp
msgid "A monster appears nearby!"
msgstr "괴물이 근처에 나타났습니다!"

#: src/player_hardcoded_effects.cpp
msgid "A portal opens nearby, and a monster crawls through!"
msgstr "근처에 포털이 열리더니, 괴물들이 기어나옵니다!"

#: src/player_hardcoded_effects.cpp
msgid "You shudder suddenly."
msgstr "갑자기 몸이 떨려옵니다."

#: src/player_hardcoded_effects.cpp
msgid "You smell mold, and your skin itches."
msgstr "곰팡이 냄새가 나고, 피부가 가렵습니다."

#: src/player_hardcoded_effects.cpp
msgid "We have many colonists awaiting passage."
msgstr "이주를 기다리는 이주민이 많이 있습니다."

#: src/player_hardcoded_effects.cpp
msgid "A blue flash of radiation permeates your vision briefly!"
msgstr "방사능의 푸른 섬광이 한순간 시야에 스며듭니다!"

#: src/player_hardcoded_effects.cpp
msgid "You're suddenly covered in ectoplasm."
msgstr "갑자기 엑토플라즘에 뒤덮였습니다!"

#: src/player_hardcoded_effects.cpp
msgid "A strange sound reverberates around the edges of reality."
msgstr "낯선 소리가 현실의 가장자리를 타고 울려퍼집니다."

#. ~ a humming sound
#: src/player_hardcoded_effects.cpp src/trapfunc.cpp
msgid "hrmmm"
msgstr "흐름름름"

#. ~ a loud humming sound
#: src/player_hardcoded_effects.cpp src/trapfunc.cpp
msgid "HRMMM"
msgstr "흠름름름"

#. ~ a very loud humming sound
#: src/player_hardcoded_effects.cpp src/trapfunc.cpp
msgid "VRMMMMMM"
msgstr "브름름름름름름"

#: src/player_hardcoded_effects.cpp
msgid "Your asthma attack stops."
msgstr "천식 발작이 멈춥니다."

#: src/player_hardcoded_effects.cpp
msgid ""
"Your asthma overcomes you.\n"
"You asphyxiate."
msgstr ""
"천식이 한계를 넘어섰다.\n"
"질식할 것 같습니다."

#: src/player_hardcoded_effects.cpp
msgid "You wheeze and gasp for air."
msgstr "호흡이 힘들어 겨우 숨을 쉬었습니다."

#: src/player_hardcoded_effects.cpp
msgid "Your head aches faintly."
msgstr "머리가 조금 욱신거립니다."

#: src/player_hardcoded_effects.cpp
msgid "Your vision is getting fuzzy."
msgstr "시야가 흐려집니다."

#: src/player_hardcoded_effects.cpp
msgid "Your vision goes black!"
msgstr "시야가 점점 어두워집니다!"

#: src/player_hardcoded_effects.cpp
msgid "Your bowels ache."
msgstr "속이 아픕니다."

#: src/player_hardcoded_effects.cpp
msgid "Your veins itch."
msgstr "정맥이 간질거립니다."

#: src/player_hardcoded_effects.cpp
msgid "Your muscles feel like they're knotted and tired."
msgstr "근육이 땅땅하게 뭉치고 피곤합니다."

#: src/player_hardcoded_effects.cpp
msgid ""
"You're experiencing loss of basic motor skills and blurred vision.  Your "
"mind recoils in horror, unable to communicate with your spinal column."
msgstr "몸을 제대로 움직일 수 없고 시야가 흐려졌습니다. 정신은 공포에 휩싸이고 신체는 전혀 응답하지 않습니다."

#: src/player_hardcoded_effects.cpp
msgid "You stagger and fall!"
msgstr "비틀거리다가 쓰러졌습니다!"

#: src/player_hardcoded_effects.cpp
msgid "There's some kind of big machine in the sky."
msgstr "하늘에 거대한 기계 같은 것이 있습니다."

#: src/player_hardcoded_effects.cpp
msgid "It's some kind of electric snake, coming right at you!"
msgstr "전기로 된 뱀 같은 것이 다가옵니다!"

#: src/player_hardcoded_effects.cpp
msgid ""
"Order us some golf shoes, otherwise we'll never get out of this place alive."
msgstr "우리한테 골프화 좀 사줘, 안 그러면 우린 절대 여기서 살아나가지 못할거야."

#: src/player_hardcoded_effects.cpp
msgid "The possibility of physical and mental collapse is now very real."
msgstr "신체적, 정신적으로 기절할 가능성이 매우 높아졌습니다."

#: src/player_hardcoded_effects.cpp
msgid "No one should be asked to handle this trip."
msgstr "아무도 이 여행을 맡으라고 해서는 안된다."

#: src/player_hardcoded_effects.cpp
msgid ""
"Your heart spasms painfully and stops, dragging you back to reality as you "
"die."
msgstr "심장이 고통스럽게 경련을 일으키더니 멈춥니다."

#: src/player_hardcoded_effects.cpp
msgid ""
"You dissolve into beautiful paroxysms of energy.  Life fades from your "
"nebulae and you are no more."
msgstr "몸이 분해되어 눈부시게 소용돌이치는 에너지로 변했습니다. 생명이 희미해지며 이제 더이상 아무것도 아닌 것이 되었습니다."

#. ~ %s is bodypart name.
#: src/player_hardcoded_effects.cpp
#, c-format
msgid "Your %s wound begins to feel better!"
msgstr "당신의 상처%s(이)가 좋아지기 시작합니다!"

#: src/player_hardcoded_effects.cpp
msgid "You succumb to the infection."
msgstr "감염으로 인해 쓰러졌습니다."

#: src/player_hardcoded_effects.cpp
msgid "You feel well rested."
msgstr "편히 잘 쉰 것 같습니다."

#: src/player_hardcoded_effects.cpp
msgid ""
"You feel physically rested, but you haven't been able to catch up on your "
"missed sleep yet."
msgstr "여러분은 신체적으로 휴식을 취하는 것을 느끼지만, 아직 여러분이 놓친 잠을 따라잡을 수 없었습니다."

#: src/player_hardcoded_effects.cpp
msgid "It's too bright to sleep."
msgstr "너무 밝아서 잘 수가 없습니다."

#: src/player_hardcoded_effects.cpp
#, c-format
msgid "You see %s approaching!"
msgstr "%s 접근중!"

#: src/player_hardcoded_effects.cpp
msgid "You toss and turn trying to keep warm."
msgstr "온기를 보존하려고 몸을 뒤척입니다."

#: src/player_hardcoded_effects.cpp
msgid "It's too cold to sleep."
msgstr "잠을 청하기엔 너무 춥습니다."

#: src/player_hardcoded_effects.cpp
msgid "You toss and turn in the heat."
msgstr "더위 때문에 몸을 뒤척입니다."

#: src/player_hardcoded_effects.cpp
msgid "It's too hot to sleep."
msgstr "잠을 청하기엔 너무 덥습니다."

#: src/player_hardcoded_effects.cpp
msgid "Your internal chronometer went off and you haven't slept a wink."
msgstr "내부 정밀시계가 꺼져서 잠을 잘 못잤습니다."

#: src/player_hardcoded_effects.cpp
msgid "Your internal chronometer finally wakes you up."
msgstr "내부 정밀시계가 마침내 잠을 깨웠습니다."

#: src/player_hardcoded_effects.cpp
msgid "Your internal chronometer wakes you up."
msgstr "내부 정밀시계가 잠을 깨웠습니다."

#: src/player_hardcoded_effects.cpp
msgid "Your alarm is going off."
msgstr "알람이 꺼집니다."

#: src/player_hardcoded_effects.cpp
msgid "Your alarm went off."
msgstr "알람이 꺼졌습니다."

#: src/ranged.cpp
#, c-format
msgid "Your %s misfires with a muffled click!"
msgstr "%s(이)가 찰칵거리는 소리와 함께 불발되었다!"

#: src/ranged.cpp
#, c-format
msgid "<npcname>'s %s misfires with a muffled click!"
msgstr "<npcname>의 %s(이)가 찰칵거리는 소리와 함께 불발되었다!"

#: src/ranged.cpp
#, c-format
msgid "Perhaps taking the ammo out of your %s and reloading will help."
msgstr "%s에서 총알을 빼내고 다시 장전하면 해결될지도 모릅니다."

#: src/ranged.cpp
#, c-format
msgid "Perhaps taking the ammo out of <npcname>'s %s and reloading will help."
msgstr "<npcname>의 %s에서 총알을 빼내고 다시 장전하면 해결될지도 모릅니다."

#: src/ranged.cpp
#, c-format
msgid "Your %s misfires with a wet click!"
msgstr "%s(이)가 습기탓에 불발되었다!"

#: src/ranged.cpp
