#: data/json/obsoletion/uncategorized.json
#: data/mods/MagicalNights/terrain.json data/mods/pride_flags/furniture.json
msgid "whack!"
msgstr "꽝!"

#. ~ Description for mounted wind turbine
#: data/json/furniture_and_terrain/furniture-appliances.json
msgid "A large mounted wind turbine connected to building's electric grid."
msgstr "건물의 전력망에 연결된 대형 풍력발전용 터빈입니다."

#: data/json/furniture_and_terrain/furniture-appliances.json
msgid "mounted water wheel"
msgstr "망 연결된 수력발전기"

#. ~ Description for mounted water wheel
#: data/json/furniture_and_terrain/furniture-appliances.json
msgid "A mounted water wheel connected to building's electric grid."
msgstr "건물의 전력망에 연결된 수력발전기입니다."

#: data/json/furniture_and_terrain/furniture-appliances.json
msgid "mounted large water wheel"
msgstr "망 연결된 대형 수력발전기"

#. ~ Description for mounted large water wheel
#: data/json/furniture_and_terrain/furniture-appliances.json
msgid "A large mounted water wheel connected to building's electric grid."
msgstr "건물의 전력망에 연결된 대형 수력발전기입니다."

#: data/json/furniture_and_terrain/furniture-appliances.json
msgid "mounted solar panel"
msgstr "망 연결된 태양전지판"

#. ~ Description for mounted solar panel
#: data/json/furniture_and_terrain/furniture-appliances.json
msgid "A mounted solar panel connected to building's electric grid."
msgstr "건물의 전력망에 연결된 태양전지판입니다."

#: data/json/furniture_and_terrain/furniture-appliances.json
msgid "mounted upgraded solar panel"
msgstr "망 연결된 개량형 태양 전지판"

#. ~ Description for mounted upgraded solar panel
#: data/json/furniture_and_terrain/furniture-appliances.json
msgid "A mounted upgraded solar panel connected to building's electric grid."
msgstr "건물의 전력망에 연결된 개량형 태양 전지판입니다."

#: data/json/furniture_and_terrain/furniture-appliances.json
msgid "mounted foldable solar panel"
msgstr "망 연결된 접이식 태양 전지판"

#. ~ Description for mounted foldable solar panel
#: data/json/furniture_and_terrain/furniture-appliances.json
msgid "A mounted foldable solar panel connected to building's electric grid."
msgstr "건물의 전력망에 연결된 접이식 태양 전지판입니다."

#: data/json/furniture_and_terrain/furniture-appliances.json
msgid "mounted medium storage battery"
msgstr "망 연결된 중형 축전지"

#. ~ Description for mounted medium storage battery
#: data/json/furniture_and_terrain/furniture-appliances.json
msgid ""
"A storage battery mount salvaged from a vehicle, and connected to building's"
" electric grid."
msgstr "차량에서 떼어낸 대형 축전지로, 건물 전력망에 연결되어 있습니다."

#: data/json/furniture_and_terrain/furniture-appliances.json
msgid "mounted large storage battery"
msgstr "망 연결된 대형 축전지"

#. ~ Description for mounted large storage battery
#: data/json/furniture_and_terrain/furniture-appliances.json
msgid ""
"A large storage battery mount salvaged from a vehicle, and connected to "
"building's electric grid."
msgstr "차량에서 떼어낸 대형 축전지로, 건물 전력망에 연결되어 있습니다."

#: data/json/furniture_and_terrain/furniture-appliances.json
msgid "mounted very large storage battery"
msgstr "망 연결된 특대형 축전지"

#. ~ Description for mounted very large storage battery
#: data/json/furniture_and_terrain/furniture-appliances.json
msgid ""
"A huge storage battery mount salvaged from a vehicle, and connected to "
"building's electric grid."
msgstr "차량에서 떼어낸 특대형 축전지로, 건물 전력망에 연결되어 있습니다."

#: data/json/furniture_and_terrain/furniture-appliances.json
msgid "mounted small storage battery"
msgstr "망 연결된 소형 축전지"

#. ~ Description for mounted small storage battery
#: data/json/furniture_and_terrain/furniture-appliances.json
msgid "A small storage battery, connected to building's electric grid."
msgstr "건물의 전력망에 연결된 소형 축전지입니다."

#: data/json/furniture_and_terrain/furniture-appliances.json
msgid "mounted car battery"
msgstr "망 연결된 차량용 배터리"

#. ~ Description for mounted car battery
#: data/json/furniture_and_terrain/furniture-appliances.json
msgid ""
"A lead-acid battery salvaged from a vehicle and connected to building's "
"electric grid."
msgstr "차량에서 떼어낸 납-산 배터리로, 건물의 전력망에 연결되어 있습니다."

#: data/json/furniture_and_terrain/furniture-appliances.json
msgid "mounted motorbike battery"
msgstr "망 연결된 오토바이 배터리"

#. ~ Description for mounted motorbike battery
#: data/json/furniture_and_terrain/furniture-appliances.json
msgid ""
"A small lead-acid battery salvaged from a vehicle and connected to "
"building's electric grid."
msgstr "오토바이에서 떼어낸 작은 납-산 배터리로, 건물의 전력망에 연결되어 있습니다."

#: data/json/furniture_and_terrain/furniture-appliances.json
msgid "mounted small motorbike battery"
msgstr "망 연결된 소형 오토바이 배터리"

#. ~ Description for mounted small motorbike battery
#: data/json/furniture_and_terrain/furniture-appliances.json
msgid ""
"A tiny lead-acid battery salvaged from a vehicle and connected to building's"
" electric grid.  Better than nothing if you're desperate to turn the lights "
"back on."
msgstr ""
"차량에서 떼어낸 아주 작은 납-산 배터리로, 건물의 전력망에 연결되어 있습니다. 전등을 꼭 켜야 하는 상황이라면 이거라도 있는게 없는 "
"것보다는 나을 것 같습니다."

