#: src/npctalk.cpp
#, c-format
msgid ""
"<color_light_gray>You can add a prefix to your monologue to set the tone or emotion. Valid prefixes are:</color> %s\n"
"\n"
"<color_white>Examples:</color>\n"
"  <color_light_green>good: You feel like it's going to be a good day.</color>\n"
"  <color_light_red>bad: You don't like the look of this place…</color>\n"
"  <color_light_blue>info: The empty house reminds you of old times.</color>\n"
"  <color_yellow>warning: You say 'Stay close, I hear something moving!'</color>\n"
"\n"
"<color_light_gray>Leave off the prefix for a neutral monologue.</color>\n"
msgstr ""
"<color_light_gray>당신의 모놀로그에 접두사를 붙여 톤이나 감정을 설정할 수 있습니다. 유효한 접두사는 다음과 같습니다.</color> %s\n"
"\n"
"<color_white>예시:</color>\n"
"  <color_light_green>좋음(good): 오늘은 좋은 일이 일어날 것 같은 기분이 듭니다.</color>\n"
"  <color_light_red>나쁨(bad): 이곳의 광경이 뭔가 마음에 들지 않습니다...</color>\n"
"  <color_light_blue>정보(info): 빈 집을 보고 있자면 옛 생각이 납니다.</color>\n"
"  <color_yellow>경고(warning): 당신은 '바짝 붙어있어, 뭔가 움직이는 소리가 났어!' 라고 외칩니다.</color>\n"
"\n"
"<color_light_gray>접두사를 설정하지 않으면 중립 상태의 모놀로그가 됩니다.</color>\n"

#: src/npctalk.cpp
#, c-format
msgctxt "message log"
msgid "<color_%s>%s</color>"
msgstr "<color_%s>%s</color>"

#: src/npctalk.cpp
msgid "Who should guard here?"
msgstr "누구를 여기에 경비로 세우겠습니까?"

#: src/npctalk.cpp
msgid "Everyone guard here!"
msgstr "모두 여기를 지켜!"

#: src/npctalk.cpp
#, c-format
msgid "Guard here, %s!"
msgstr "여기를 지켜, %s!"

#: src/npctalk.cpp
msgid "Who should move?"
msgstr "누구를 이동시킬까요?"

#: src/npctalk.cpp
msgid "This destination can't be reached."
msgstr "해당 목적지에 도달할 수 있는 경로가 없습니다."

#: src/npctalk.cpp
msgid "Everyone move there!"
msgstr "다들 움직여!"

#: src/npctalk.cpp
#, c-format
msgid "Move there, %s!"
msgstr "움직여, %s!"

#: src/npctalk.cpp
msgid "Who do you want to control?"
msgstr "누구를 조종합니까?"

#: src/npctalk.cpp
msgid "Who should follow you?"
msgstr "누가 당신을 따르게 하겠습니까?"

#: src/npctalk.cpp
msgid "Everyone follow me!"
msgstr "모두들 따라와!"

#: src/npctalk.cpp
#, c-format
msgid "Follow me, %s!"
msgstr "나를 따라와, %s!"

#: src/npctalk.cpp
msgid "Stay awake!"
msgstr "자지마!"

#: src/npctalk.cpp
msgid "Mount up!"
msgstr "올라타!"

#: src/npctalk.cpp
msgid "Dismount!"
msgstr "내려!"

#: src/npctalk.cpp
msgid ""
"We're in danger.  Stay awake, stay close, don't go wandering off, and don't "
"open any doors."
msgstr "앞에 위협이 있어.  모두들 긴장하고 가까이 붙어있어.  돌아다니지 말고 아무 문도 열지마."

#: src/npctalk.cpp
msgid "As you were."
msgstr "그대로 있어."

#: src/npctalk.cpp
#, c-format
msgid "%s is fleeing from you!"
msgstr "%s(이)가 도망칩니다!"

#: src/npctalk.cpp
#, c-format
msgid "%s talked to you."
msgstr "%s(이)가 이야기를 꺼냅니다."

#: src/npctalk.cpp
#, c-format
msgid "&%s stays silent."
msgstr "&%s(이)가 침묵을 지킵니다."

#: src/npctalk.cpp
msgid "&You can't talk without your face."
msgstr "&얼굴이 없어 대화할 수 없습니다."

#: src/npctalk.cpp
msgid "&You are deaf and can't talk."
msgstr "&귀가 들리지 않고 말을 할 수 없습니다."

#: src/npctalk.cpp
#, c-format
msgid ""
"&You are deaf and can't talk.  When you don't respond, %s becomes angry!"
msgstr ""
"&당신은 귀가 들리지 않고 말을 할 수 없습니다. 대답하지 못하면 자신을 무시하는 것으로 여기고 %s(이)가 화를 낼 것입니다!"

#: src/npctalk.cpp
#, c-format
msgid ""
"%1$s is sedated and can't be moved or woken up until the medication or sedation wears off.\n"
"You estimate it will wear off in %2$s."
msgstr ""
"%1$s(은)는 깊이 잠든 상태이고, 치료 과정이나 진정제의 효과가 종료될 때까지 움직이거나 깨울 수 없습니다.\n"
"아마 %2$s 뒤에 효과가 끝날 것 같습니다."

#: src/npctalk.cpp
msgid "  And I have more I'd like you to do."
msgstr "  네가 해줬으면 하는 일이 좀 더 있는데."

#: src/npctalk.cpp
msgid "  I could use a hand with something else if you are interested."
msgstr "  도와줬으면 하는 일이 있는데, 혹시 생각 있나?"

#: src/npctalk.cpp
msgid "  If you are interested, I have another job for you."
msgstr "  다른 맡길 일이 좀 있는데, 혹시 생각 있나?"

#: src/npctalk.cpp
msgid "Shall we resume?"
msgstr "계속 할까?"

#: src/npctalk.cpp
msgid "Sorry, but it doesn't seem I have anything to teach you."
msgstr "미안, 내가 가르쳐줄수 있는게 없는 것 같아."

#: src/npctalk.cpp
msgid "Here's what I can teach you…"
