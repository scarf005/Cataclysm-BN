#: data/json/npcs/talk_tags.json
msgid "the end of the world"
msgstr "세계의 끝"

#: data/json/npcs/talk_tags.json
msgid "Armageddon"
msgstr "아마겟돈"

#: data/json/npcs/talk_tags.json
msgid "the end of days"
msgstr "세상의 끝"

#: data/json/npcs/talk_tags.json
msgid "Zero Day"
msgstr "제로 데이"

#: data/json/npcs/talk_tags.json
msgid "They'll kill us!  Run away!"
msgstr "놈들이 우릴 죽일거야!  도망쳐!"

#: data/json/npcs/talk_tags.json
msgid "We're going to die!  Fall back!"
msgstr "우린 곧 죽을 거야!  후퇴해!"

#: data/json/npcs/talk_tags.json
msgid "Fall back and regroup!"
msgstr "후퇴해서 재정비해!"

#: data/json/npcs/talk_tags.json
msgid "There's no hope for victory.  I'm running!"
msgstr "이길 수가 없어.  난 도망칠 거야!"

#: data/json/npcs/talk_tags.json
msgid "Feet don't fail me now!"
msgstr "걸음아 나 살려라!"

#: data/json/npcs/talk_tags.json
msgid "I don't have to be faster than them, just faster than you!"
msgstr "놈들보다 빠를 필요는 없지, 너보다만 빠르면 돼!"

#: data/json/npcs/talk_tags.json
msgid "Oh God, my leg, Oh God!"
msgstr "으아악, 내 다리! 으아아악!!"

#: data/json/npcs/talk_tags.json
msgid "We have a serious situation here.  I'm leaving!"
msgstr "심각한 상황이다. 난 간다!"

#: data/json/npcs/talk_tags.json
msgid "It can't follow all of us.  I'll run this way, you go there!"
msgstr "저놈이 우리 모두를 쫓아올 수는 없을거야. 난 이대로 갈테니, 넌 저쪽으로 가!"

#: data/json/npcs/talk_tags.json
msgid "Me go, you stay."
msgstr "난 갈테니 넌 남아."

#: data/json/npcs/talk_tags.json
msgid "Not that way!  Go left!"
msgstr "그쪽이 아니야! 반대쪽으로!"

#: data/json/npcs/talk_tags.json
msgid "<move>!"
msgstr "<move>!"

#: data/json/npcs/talk_tags.json
msgid "Retreat!  Retreat!"
msgstr "후퇴! 후퇴!"

#: data/json/npcs/talk_tags.json
msgid "Book it!"
msgstr "어서 떠나자!"

#: data/json/npcs/talk_tags.json
msgid "Leg it!"
msgstr "도망가!"

#: data/json/npcs/talk_tags.json
msgid "Thank fuck for all the cardio!"
msgstr "씨발 유산소 운동 만세!"

#: data/json/npcs/talk_tags.json
msgid "I can't outrun it!  I'm going to kill it!"
msgstr "도망칠 수가 없어!  이 놈을 죽여야겠어!"

#: data/json/npcs/talk_tags.json
msgid "<swear>!  Die, you <name_b>!  I want to live!"
msgstr "<swear>! 뒈져, 이 <name_b>새끼야! 난 살아야겠어!"

#: data/json/npcs/talk_tags.json
msgid "My feet failed me!  Arms, don't fail me!"
msgstr "다리가 좆됐어! 팔도 좆되면 안되는데!"

#: data/json/npcs/talk_tags.json
msgid "Can't run!  Have to fight!"
msgstr "도망칠수가 없어! 싸워야 해!"

#: data/json/npcs/talk_tags.json
msgid "If I die, I'm taking you all with me!"
msgstr "내가 뒈진다면, 적어도 니들도 같이 뒈져야겠다!"

#: data/json/npcs/talk_tags.json
msgid "Can't clear a path, holding the line!"
msgstr "나아갈 수가 없군, 여길 지켜야 해!"

#: data/json/npcs/talk_tags.json
msgid "I'm pinned down here!"
msgstr "여기서 빠져나갈 수가 없어!"

#: data/json/npcs/talk_tags.json
msgid "Call the fire department!  Wait, they're dead!  Run away!"
msgstr "소방서에 전화해! 잠깐만, 걔들도 죽었겠네! 도망쳐!"

#: data/json/npcs/talk_tags.json
msgid "This place is on fire.  I'm leaving."
msgstr "참 잘도 불타는군. 난 나가야겠어."

#: data/json/npcs/talk_tags.json
msgid "Put the fire out!  Put it out!"
msgstr "불꺼! 씨발, 불끄라고!"

#: data/json/npcs/talk_tags.json
msgid "Fire bad!  <move>!"
msgstr "불이다! <move>!"

#: data/json/npcs/talk_tags.json
msgid "We need to put this fire out!"
msgstr "불을 당장 꺼뜨려야 해!"

#: data/json/npcs/talk_tags.json
msgid "Somebody get some water!"
msgstr "누가 물 좀 가져와!"

#: data/json/npcs/talk_tags.json
msgid "Fire, fire, FIRE!"
msgstr "불이야, 불, 불이라고!"

#: data/json/npcs/talk_tags.json
msgid "Get an extinguisher!"
msgstr "소화기 가져와!"

#: data/json/npcs/talk_tags.json
msgid "Danger hot!"
msgstr "존나 뜨겁네!"

#: data/json/npcs/talk_tags.json
msgid "Is it getting hot in here or is it just me?  Oh, fire!"
msgstr "나만 여기 좀 따뜻하다고 느끼는건가? 아, 불이군!"

#: data/json/npcs/talk_tags.json
msgid "This place is toast, <move>!"
msgstr "여긴 위험해, <move>!"

#: data/json/npcs/talk_tags.json
msgid "I've done so much for you, and you can't even keep me fed!"
msgstr "널 위해서 그렇게 많은 걸 해줬는데도 넌 날 굶기다니!"

#: data/json/npcs/talk_tags.json
msgid "You are the worst person in the world!"
msgstr "세상에서 네가 제일 최악이야!"

#: data/json/npcs/talk_tags.json
msgid "Why are you such a horrible leader?"
msgstr "넌 리더로서 왜 그렇게 끔찍할까?"

#: data/json/npcs/talk_tags.json
msgid "I trusted you, and you can't even provide food!"
msgstr "널 믿었는데 음식조차도 챙겨주질 못하다니!"

#: data/json/npcs/talk_tags.json
msgid ""
"I don't have to take this abuse from you, there are plenty of people to "
"abuse me!"
msgstr "세상에 나한테 좆같게 구는 놈이 얼마나 많은데, 굳이 너까지 나한테 이지랄을 해야겠냐!"

#: data/json/npcs/talk_tags.json
msgid "You said you would keep me safe, and you haven't!"
msgstr "날 안전하게 지켜주겠다더니, 지금 꼴을 봐!"

#: data/json/npcs/talk_tags.json
msgid ""
"There's only a couple hundred people left in the world, and I relied on the "
"dumbest one!"
msgstr "세상에 살아남은 사람이 수백도 안되는데, 하필 내가 그중 최악에 걸렸네!"

#: data/json/npcs/talk_tags.json
msgid "You're a monster!"
msgstr "괴물 자식아!"

#: data/json/npcs/talk_tags.json
msgid "You call this safe?  You're crazy and incompetent!"
msgstr "니가 보기엔 이게 안전해보이냐? 정신나간 무능력자 새끼가!"

#: data/json/npcs/talk_tags.json
msgid "That was the last straw!  I'm not following your orders anymore!"
msgstr "그래, 씨발 기어이 선 넘네! 이제 니가 뭐라하든 좆깔테니 그리 아셔!"

#: data/json/npcs/talk_tags.json
msgid "I've had enough of your bullshit!"
msgstr "니 개소리는 들을만큼 들었어!"

#: data/json/npcs/talk_tags.json
msgid "Look at me.  I am the captain now."
msgstr "날 봐. 이제 내가 대장이다."

