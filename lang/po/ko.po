#, c-format
msgid "Score: %d"
msgstr "점수: %d"

#: src/iuse_software_snake.cpp
#, c-format
msgid "TOTAL SCORE: %d"
msgstr "총합점수: %d"

#: src/iuse_software_snake.cpp
msgid "Press 'q' or ESC to exit."
msgstr "나가시려면 'q'키나 ESC키를 눌러주세요."

