msgstr "<color_magenta>^>v<</color> 주류 판매점 - 술은 화염병을 만들기 좋습니다."

#: data/help/texts.json
msgid ""
"<color_red>^>v<</color>        Gun store - Firearms and ammunition are very "
"valuable."
msgstr "<color_red>^>v<</color>  총포사 - 화기와 탄약은 아주 귀중한 물품이죠."

#: data/help/texts.json
