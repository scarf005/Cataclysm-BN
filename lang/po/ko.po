msgstr "경로에 다른 차량이 있습니다."

#: src/avatar_action.cpp
msgid "That part of the vehicle is currently unsafe."
msgstr "지금 이 부품을 만지는건 별로 안전하지 않을 것 같습니다."

#: src/avatar_action.cpp
#, c-format
msgid "The %s cannot swim while it is carrying you!"
msgstr "%s(이)가 당신을 옮기고 있는 동안에는 헤엄칠 수 없습니다!"

#: src/avatar_action.cpp
msgid "Dive into the water?"
msgstr "물속으로 들어가시겠습니까?"

#: src/avatar_action.cpp
msgid "You start swimming."
msgstr "헤엄치기 시작합니다."

#: src/avatar_action.cpp
#, c-format
msgid "%s to dive underwater."
msgstr "%s 키를 눌러 잠수합니다."

#: src/avatar_action.cpp
#, c-format
msgid "You open the %1$s's %2$s."
msgstr "%1$s의 %2$s(을)를 열었습니다."

#: src/avatar_action.cpp
#, c-format
msgid "You bump into the %s!"
msgstr "%s에 부딪힙니다!"

#: src/avatar_action.cpp
msgid "That door is locked!"
msgstr "문이 잠겨있습니다!"

#: src/avatar_action.cpp
msgid "You rattle the bars but the door is locked!"
msgstr "문을 흔들어보지만 잠겨있습니다!"

#: src/avatar_action.cpp
msgid "You can't climb here - there's a ceiling above."
msgstr "올라갈 수가 없습니다 - 위에 천장이 있습니다."

#: src/avatar_action.cpp src/game.cpp
msgid "The water puts out the flames!"
msgstr "물에 젖어 불이 꺼집니다!"

#: src/avatar_action.cpp
msgid "The water washes off the glowing goo!"
msgstr "빛나는 점액이 물에 씻겨져나갑니다!"

#: src/avatar_action.cpp
msgid "You sink like a rock!"
msgstr "돌덩어리처럼 가라앉습니다!"

#: src/avatar_action.cpp
#, c-format
msgid "You need to breathe!  (%s to surface.)"
msgstr "숨을 쉴 수가 없습니다!  (수면으로 올라가려면 %s)"

#: src/avatar_action.cpp
msgid "You need to breathe but you can't swim!  Get to dry land, quick!"
msgstr "숨을 쉬어야 하는데, 헤엄칠 수가 없습니다! 빨리 뭍으로 올라가세요, 빨리요!"

#: src/avatar_action.cpp
msgid "You cannot board a vehicle while mounted."
msgstr "타고 있는 동안 차량에 탑승할 수 없습니다."

#: src/avatar_action.cpp src/game.cpp
#, c-format
msgid "You are hiding in the %s."
msgstr "당신은 %s 안에 숨었습니다."

#: src/avatar_action.cpp
msgid "No hostile creature in reach.  Waiting a turn."
msgstr "사정거리 내에 적대적 대상이 없습니다. 한 턴을 기다립니다."

#: src/avatar_action.cpp
msgid "You refuse to use this ranged weapon."
msgstr "이 원거리 무기를 쓰고 싶지 않습니다."

#: src/avatar_action.cpp
msgid "You refuse to use this gun."
msgstr "이 총을 쓰고 싶지 않습니다."

#: src/avatar_action.cpp
msgid "Your eyes steel, and you raise your weapon!"
msgstr "마음을 단단히 먹고 무기를 들었다!"

#: src/avatar_action.cpp
msgid "You can't fire your weapon, it's too heavy…"
msgstr "무기가 너무 무거워서 발사할 수 없습니다..."

#: src/avatar_action.cpp
msgid "You refuse to use this ranged weapon"
msgstr "이 원거리 무기를 쓰고 싶지 않습니다."

#: src/avatar_action.cpp
msgid "You refuse to use this gun turret"
msgstr "이 총기 터렛을 쓰고 싶지 않습니다."

#: src/avatar_action.cpp
msgid "Your eyes steel, and you aim your weapon!"
msgstr "마음을 단단히 먹고 무기를 조준했다!"

#: src/avatar_action.cpp
msgid "You are too pacified to aim the turret…"
msgstr "터렛을 조준하기에는 당신의 마음이 너무 무릅니다..."

#: src/avatar_action.cpp
#, c-format
msgid "The %s is out of ammo."
msgstr "%s의 탄약이 다 떨어졌습니다."

#: src/avatar_action.cpp
#, c-format
msgid "The %s is not powered."
msgstr "%s의 동력이 없습니다."

#: src/avatar_action.cpp
#, c-format
msgid "The %s must be attached to a gun, it can not be fired separately."
msgstr "%s(은)는 총기에 부착해야 쓸 수 있습니다. 개별적으로 발사할 수 없습니다."

#: src/avatar_action.cpp
#, c-format
msgid "The %s can't be fired while loaded with incompatible ammunition %s"
msgstr "%s에 호환되지 않는 탄약 %s(이)가 장전되어 있어 발사할 수 없습니다!"

#: src/avatar_action.cpp
msgid "You're not wielding anything."
msgstr "손에 들고 있는 것이 없습니다."

#: src/avatar_action.cpp
#, c-format
msgid "You're too full to eat the leaves from the %s."
msgstr "%s에서 이파리를 뜯어먹기에는 너무 배부릅니다."

#: src/avatar_action.cpp
msgid "You eat the underbrush."
msgstr "덤불을 먹었습니다."

#: src/avatar_action.cpp
msgid "You're too full to graze."
msgstr "풀을 뜯어먹기에는 너무 배부릅니다."

#: src/avatar_action.cpp
msgid "You eat the grass."
msgstr "잔디를 뜯어먹었습니다."

#: src/avatar_action.cpp
msgid "This grass is too short to graze."
msgstr "이 잔디는 너무 짧아 먹을 수 없습니다."

#: src/avatar_action.cpp
msgid "This grass is dead and too mangled for you to graze."
msgstr "이 잔디는 죽은데다, 뜯어먹기 부적절할 정도로 뭉개졌습니다."

#: src/avatar_action.cpp
msgid "This grass is tainted with paint and thus inedible."
msgstr "이 잔디는 페인트칠되어있어서 먹을 수 없습니다."

#: src/avatar_action.cpp
#, c-format
msgid "You leave the empty %s."
msgstr "빈 %s(을)를 그 자리에 둡니다."

#: src/avatar_action.cpp
msgid "You can't effectively throw while you're in your shell."
msgstr "껍질에 들어가있는 동안에는 제대로 던지기 어렵습니다."

#: src/avatar_action.cpp src/game.cpp src/handle_action.cpp
#, c-format
msgid "Your %s refuses to move as its batteries have been drained."
msgstr "%s의 배터리가 고갈되어 작동하지 않습니다."

#: src/avatar_action.cpp
msgid "Throw item"
msgstr "물품 투척"

#: src/avatar_action.cpp
msgid "You don't have any items to throw."
msgstr "던질 수 있는 것이 없습니다."

#: src/avatar_action.cpp src/character.cpp
msgid "You don't have that item."
msgstr "그런 물품은 갖고 있지 않습니다."

#: src/avatar_action.cpp
msgid "That is too heavy to throw."
msgstr "던져버리기에는 너무 무겁습니다."

#: src/avatar_action.cpp
msgid "That's part of your body, you can't throw that!"
msgstr "당신의 신체 일부를 떼어내 던질 수는 없습니다!"

#: src/avatar_action.cpp
msgid "You concentrate mightily, and your body obeys!"
msgstr "힘껏 집중하자, 당신의 육신이 복종합니다!"

#: src/avatar_action.cpp
msgid "You can't muster up the effort to throw anything…"
msgstr "뭔가를 던질만한 집중력을 발휘할 수가 없습니다..."

#: src/avatar_action.cpp
#, c-format
msgid "You do not have enough free hands to throw %s without wielding it."
msgstr "%s(을)를 장비하지 않고 던지기에는 남는 손이 없습니다."

#: src/avatar_action.cpp
#, c-format
msgid "The %s is already fully loaded!"
msgstr "%s(은)는 이미 완전히 장전되어 있습니다!"

#: src/avatar_action.cpp
#, c-format
msgid "You need at least one %s to reload the %s!"
msgstr "최소한 %s(이)가 1개 있어야 %s(을)를 재장전할 수 있습니다!"

#: src/avatar_action.cpp
#, c-format
msgid "The %s is already full!"
msgstr "%s(은)는 이미 가득 차 있습니다!"

#: src/avatar_action.cpp
#, c-format
msgid "You can't reload a %s!"
msgstr "%s(을)를 장전할 수 없습니다!"

#: src/avatar_action.cpp
#, c-format
msgid "You struggle to reload the fouled %s."
msgstr "고장난 %s(을)를 장전하기 위해 애씁니다."

#: src/avatar_action.cpp
msgid "Reload item"
msgstr "내용물 넣기"

#: src/avatar_action.cpp
msgid "You have nothing to reload."
msgstr "장전할 것이 없습니다."

#: src/avatar_action.cpp
msgid "You aren't holding something you can reload."
msgstr "재장전할만한 것을 갖고 있지 않습니다."

#: src/avatar_action.cpp
msgid "Unload item"
msgstr "내용물 회수"

#: src/avatar_action.cpp
msgid "You have nothing to unload."
msgstr "회수할만한 것이 없습니다."

#: src/avatar_functions.cpp
msgid "You relax as your roots embrace the soil."
msgstr "뿌리가 흙에 파고들자 편안한 기분이 듭니다."

#: src/avatar_functions.cpp
msgid "It's impossible to sleep in this wheeled pot!"
msgstr "이딴 바퀴 달린 냄비 안에서는 잘 수 없습니다!"

#: src/avatar_functions.cpp
msgid "The humans' furniture blocks your roots.  You can't get comfortable."
msgstr "인간들의 가구가 당신의 뿌리를 가로막습니다. 도저히 편안해지질 않는군요."

#: src/avatar_functions.cpp
msgid "Your roots scrabble ineffectively at the unyielding surface."
msgstr "파고들 수도 없는 땅을 뿌리로 헛되게 긁적거립니다."

#: src/avatar_functions.cpp
msgid ""
"Our fibers meld with the ground beneath us.  The gills on our neck begin to "
"seed the air with spores as our awareness fades."
msgstr "우리의 섬유는 우리 밑의 땅과 섞여 있습니다. 목의 아가미는 우리의 의식이 희미해지면서 공기중으로 씨앗을 뿌리기 시작합니다."

#: src/avatar_functions.cpp
msgid "These thick webs support your weight, and are strangely comfortable�"
msgstr "이 두툼한 거미줄은 당신의 체중을 충분히 견디고, 왠지 기묘하게 편안합니다..."

#: src/avatar_functions.cpp
msgid "You try to sleep, but the webs get in the way.  You brush them aside."
msgstr "잠을 청하지만 거미줄이 거치적거려서, 휙 쓸어냈습니다."

#: src/avatar_functions.cpp
msgid "You relax into your web."
msgstr "거미줄 속에서 편안히 휴식을 취합니다."

#: src/avatar_functions.cpp
msgid ""
"You try to sleep, but you feel exposed and your spinnerets keep twitching."
msgstr "잠을 청해보지만, 나신으로 있는 듯한 느낌과 함께 방적기관이 근질거립니다."

#: src/avatar_functions.cpp
msgid "Maybe a nice thick web would help you sleep."
msgstr "두꺼운 거미줄이 있다면 잠을 청하기 쉬울 것 같습니다."

#: src/avatar_functions.cpp
msgid ""
"You lay beneath the waves' embrace, gazing up through the water's surface�"
msgstr "수면 너머를 바라보며, 파도의 포옹에 몸을 맡깁니다..."

#: src/avatar_functions.cpp
msgid "You settle into the water and begin to drowse�"
msgstr "물에 잠긴 채 꾸벅꾸벅 졸기 시작합니다..."

#: src/avatar_functions.cpp
msgid "This is a comfortable place to sleep."
msgstr "여기서 자면 정말 편안할 것 같습니다."

#: src/avatar_functions.cpp
#, c-format
msgid "It's a little hard to get to sleep on this %s."
msgstr "%s 위에서는 잠을 청하기가 조금 힘듭니다."

#: src/avatar_functions.cpp
#, c-format
msgid "It's hard to get to sleep on this %s."
msgstr "%s 위에서는 잠을 청하기가 힘듭니다."

#. ~ %1$s: vehicle name, %2$s: vehicle part name
#: src/avatar_functions.cpp
#, c-format
msgid "It's a little hard to get to sleep on this %2$s in %1$s."
msgstr "%1$s 안의 %2$s 위에서는 잠을 청하기가 조금 힘듭니다."

#. ~ %1$s: vehicle name
#: src/avatar_functions.cpp
#, c-format
msgid "It's hard to get to sleep in %1$s."
msgstr "%1$s 안에서는 잠을 청하기가 힘듭니다."

#: src/avatar_functions.cpp
msgid "You start trying to fall asleep."
msgstr "잠자리에 들었습니다."

#: src/avatar_functions.cpp
msgid "Your soporific inducer starts working its magic."
msgstr "수면 유도기가 작동합니다."

#: src/avatar_functions.cpp
msgid "Your soporific inducer doesn't have enough power to operate."
msgstr "수면 유도기 작동을 위한 전력이 부족합니다."

#: src/avatar_functions.cpp
msgid "Toggle which fault?"
msgstr "어느 결함점을 켜고끕니까?"

#: src/avatar_functions.cpp
#, c-format
msgctxt "fault"
msgid "Mend: %s"
msgstr "보수: %s"

#: src/avatar_functions.cpp
#, c-format
msgctxt "fault"
msgid "Set: %s"
msgstr "설정: %s"

#: src/avatar_functions.cpp
#, c-format
msgid "The %s doesn't have any faults to toggle."
msgstr "%s(은)는  전환해야 할 결함이 없습니다."

#: src/avatar_functions.cpp
#, c-format
msgid "The %s doesn't have any faults to mend."
msgstr "%s에는 고칠 부분이 없습니다."

#: src/avatar_functions.cpp
#, c-format
msgid ""
"It is damaged, and could be repaired with %s.  %s to use one of those items."
msgstr "이 물품은 손상되었지만 %s(을)를 사용하여 수리할 수 있습니다.  %s하여 이 물품들 중 하나를 사용하세요."

#: src/avatar_functions.cpp
msgid "Mend which fault?"
msgstr "어느 부분을 보수합니까?"

#: src/avatar_functions.cpp
#, c-format
msgid "Turns into: <color_cyan>%s</color>\n"
msgstr "상태 변화: <color_cyan>%s</color>\n"

#: src/avatar_functions.cpp
#, c-format
msgid "Also mends: <color_cyan>%s</color>\n"
msgstr "동시에 수리: <color_cyan>%s</color>\n"

#: src/avatar_functions.cpp
#, c-format
msgid "Time required: <color_cyan>%s</color>\n"
msgstr "요구시간: <color_cyan>%s</color>\n"

#: src/avatar_functions.cpp
msgid "Skills: <color_cyan>none</color>\n"
msgstr "기술: <color_cyan>없음</color>\n"

#: src/avatar_functions.cpp
#, c-format
msgid "Skills: %s\n"
msgstr "기술: %s\n"

#. ~ %1$s: skill name, %2$s: current skill level, %3$s: required skill level
#: src/avatar_functions.cpp
#, c-format
msgctxt "skill requirement"
msgid "<color_cyan>%1$s</color> <color_green>(%2$d/%3$d)</color>"
msgstr "<color_cyan>%1$s</color> <color_green>(%2$d/%3$d)</color>"

#. ~ %1$s: skill name, %2$s: current skill level, %3$s: required skill level
#: src/avatar_functions.cpp
#, c-format
msgctxt "skill requirement"
msgid "<color_cyan>%1$s</color> <color_yellow>(%2$d/%3$d)</color>"
msgstr "<color_cyan>%1$s</color> <color_yellow>(%2$d/%3$d)</color>"

#: src/avatar_functions.cpp
#, c-format
msgid "You are currently unable to mend the %s this way."
msgstr "지금 이대로는 %s(을)를 고칠 수 없습니다."

#: src/avatar_functions.cpp
#, c-format
msgid "<color_yellow>Permanently</color> install your %1$s in your %2$s?"
msgstr "%2$s에 %1$s(을)를 <color_yellow>영구적으로</color> 설치합니까?"

#: src/avatar_functions.cpp
#, c-format
msgid "Attach your %1$s to your %2$s?"
msgstr "%1$s(을)를 %2$s에 장착합니까?"

#: src/avatar_functions.cpp
msgid ""
"Warning: A magazine adapter is required to load this gun after modification."
msgstr "경고: 이 개조가 적용되면 총기 장전시 탄창 어댑터가 필요해집니다."

#: src/avatar_functions.cpp
#, c-format
msgid "Try without tools (%i%%) risking damage (%i%%)"
msgstr "도구 없이 시도 성공률 (%i%%) 손상 가능성 (%i%%)"

#: src/avatar_functions.cpp
#, c-format
msgid "Use 100 charges of firearm repair kit (%i%%)"
msgstr "총기 수리도구 충전량 100 사용(%i%%)"

#: src/avatar_functions.cpp
#, c-format
msgid "Use 25 charges of gunsmith repair kit (%i%%)"
msgstr "총기기술자 수리도구 충전량 25 사용(%i%%)"

#: src/avatar_functions.cpp
msgid "Install without tools"
msgstr "도구 없이 설치"

#: src/avatar_functions.cpp
msgid "Compare before/after installation"
msgstr "설치 전/후 비교"

#. ~ %1$s - gunmod, %2$s - gun.
#: src/avatar_functions.cpp
#, c-format
msgid "You remove your %1$s from your %2$s."
msgstr "%2$s에서 %1$s(을)를 떼어냈습니다."

#: src/avatar_functions.cpp
#, c-format
msgid "Permanently install your %1$s in your %2$s?"
msgstr "%2$s에 %1$s(을)를 영구적으로 설치합니까?"

#: src/avatar_functions.cpp src/consumption.cpp src/salvage.cpp
msgid "You do not have that item."
msgstr "그런 물품은 가지고 있지 않습니다."

#: src/avatar_functions.cpp src/iuse.cpp
#, c-format
msgid "You can't do anything interesting with your %s."
msgstr "%s(으)로 할 수 있는 것이 없습니다."

#: src/avatar_functions.cpp
#, c-format
msgid "You put the %s in your inventory."
msgstr "%s(을)를 주머니에 넣었습니다."

#: src/avatar_functions.cpp
#, c-format
msgid "The %s is already empty!"
msgstr "%s(은)는 이미 비어있습니다!"

#: src/avatar_functions.cpp
msgid "The liquid can't be unloaded in its current state!"
msgstr "해당 상태의 액체를 빼낼 수 없습니다!"

#: src/avatar_functions.cpp
msgid "Unload what?"
msgstr "무엇의 내용물을 회수합니까?"

#: src/avatar_functions.cpp
#, c-format
msgid "You can't unload a %s!"
msgstr "%s의 내용물을 회수할 수 없습니다!"

#: src/avatar_functions.cpp
#, c-format
msgid "You can't unload a rechargeable %s!"
msgstr "재충전 가능한 %s에서는 배터리를 빼낼 수 없습니다!"

#: src/avatar_functions.cpp
#, c-format
msgid "Your %s isn't charged."
msgstr "%s(은)는 충전되지 않았습니다."

#: src/avatar_functions.cpp
#, c-format
msgid "Your %s isn't loaded."
msgstr "%s(은)는 장전되지 않았습니다."

#: src/avatar_functions.cpp
#, c-format
msgid "You disassemble your %s."
msgstr "%s(을)를 분해합니다."

#: src/avatar_functions.cpp
#, c-format
msgid "You unload your %s."
msgstr "%s의 내용물을 회수합니다."

#: src/avatar_functions.cpp
#, c-format
msgid "You recover %i unused plutonium."
msgstr "미사용 플루토늄 %i개를 회수했습니다."

#: src/avatar_functions.cpp
msgid "You can't remove partially depleted plutonium!"
msgstr "부분적으로 고갈된 플루토늄은 제거할 수 없습니다!"

#: src/ballistics.cpp
#, c-format
msgid "The %s shatters!"
msgstr "%s(이)가 산산조각납니다!"

#: src/ballistics.cpp
#, c-format
msgid "The %s bursts!"
msgstr "%s(이)가 터져나갑니다!"

#: src/ballistics.cpp
#, c-format
msgid "The %1$s embeds in %2$s!"
msgstr "%1$s(이)가 %2$s에 박힙니다!"

#: src/ballistics.cpp
#, c-format
msgid "The attack bounced to %s!"
msgstr "공격이 %s에 튕겨져나갑니다!"

#: src/bionics.cpp
#, c-format
msgid "Your %s is shorting out and can't be activated."
msgstr "%s(이)가 고갈되어 작동시킬 수 없습니다."

#: src/bionics.cpp
#, c-format
msgid "You don't have the power to activate your %s."
msgstr "전력이 부족해서 %s(을)를 작동시킬 수 없습니다."

#: src/bionics.cpp src/iuse_actor.cpp src/npcmove.cpp
#, c-format
msgid "%s activates their %s."
msgstr "%s(이)가 %s(을)를 작동시킵니다."

#: src/bionics.cpp
#, c-format
msgid "Deactivate your %s first!"
msgstr "우선 %s(을)를 비활성화해야 합니다!"

#: src/bionics.cpp src/character.cpp
#, c-format
msgid "Stop wielding %s?"
