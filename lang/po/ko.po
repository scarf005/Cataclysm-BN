#: src/construction.cpp
#, c-format
msgid "Press [<color_red>%s</color>] to show unavailable constructions."
msgstr "[<color_yellow>%s</color>]를 눌러 불가능한 건설 항목 보이기"

#: src/construction.cpp
#, c-format
msgid "Press [<color_yellow>%s</color>] to remove from favorites."
msgstr "[<color_yellow>%s</color>] 키를 눌러 즐겨찾기에서 제거합니다."

#: src/construction.cpp
#, c-format
msgid "Press [<color_yellow>%s</color>] to add to favorites."
msgstr "[<color_yellow>%s</color>] 키를 눌러 즐겨찾기에 추가합니다."

#: src/construction.cpp
#, c-format
msgid "Press [<color_yellow>%s</color>] to view and edit keybindings."
msgstr "[<color_yellow>%s</color>]를 눌러 키 설정"

#: src/construction.cpp src/iexamine.cpp
msgid "It is too dark to construct right now."
msgstr "지금 건설하기에는 너무 어둡습니다."

#: src/construction.cpp
msgid "You can't build that!"
msgstr "만들 수 없습니다!"

#: src/construction.cpp
msgid "Construct where?"
msgstr "어디에 만듭니까?"

#: src/construction.cpp
msgid ""
"There is already an unfinished construction there, examine it to continue "
"working on it"
msgstr "이미 완료되지 않은 건설이 존재합니다.  계속 작업하려면 조사하세요"

#: src/construction.cpp
#, c-format
msgid "%s assists you with the work…"
msgstr "%s(이)가 일을 돕는 중..."

#: src/construction.cpp
#, c-format
msgid "%s watches you work…"
msgstr "%s(이)가 당신이 일하는 것을 보는 중..."

#: src/construction.cpp
#, c-format
msgid "%s finished construction: %s."
msgstr "%s(이)가 건설을 마쳤습니다 : %s."

#: src/construction.cpp
msgid ""
"You feel relieved after providing last rites for this human being, whose "
"name is lost in the Cataclysm."
msgstr "대재앙 속에 잊혀진 이름의 인격체의 마지막 장례를 치르고 나자, 당신은 안도감을 느꼈다."

#: src/construction.cpp
msgid "You bury remains of a human, whose name is lost in the Cataclysm."
msgstr "대재앙 속에 잊혀진 이름의 사람의 유해를 묻었습니다."

#: src/construction.cpp
#, c-format
msgid ""
"You feel sadness, but also relief after providing last rites for %s, whose "
"name you will keep in your memory."
msgstr "기억 속에 남을 이름, %s의 마지막 장례를 치르고 나자, 슬픔을 느끼는 한편 안도감도 느껴집니다."

#: src/construction.cpp
#, c-format
msgid ""
"You bury remains of %s, who joined uncounted masses perished in the "
"Cataclysm."
msgstr "셀 수 없는 망자들을 따라간 %s의 유품을 묻습니다."

#: src/construction.cpp
msgid "Inscribe something on the grave?"
msgstr "묘비에 글을 새기겠습니까?"

#: src/construction.cpp
msgid ""
"Unfortunately you don't have anything sharp to place an inscription on the "
"grave."
msgstr "안타깝게도 묘비에 글을 새길 날카로운 물건이 없습니다."

#: src/construction.cpp src/veh_interact.cpp
msgid "Enter new vehicle name:"
msgstr "차량의 새로운 이름을 입력하세요:"

#: src/construction.cpp
#, c-format
msgid "That %s can not be disassembled!"
msgstr "%s(은)는 분해할 수 없습니다!"

#: src/construction.cpp
#, c-format
msgid "The %s is disassembled."
msgstr "%s(이)가 분해되었습니다."

#: src/construction.cpp
#, c-format
msgid "That %s can not be disassembled, since there is furniture above it."
msgstr "%s 위에 가구가 있으므로 분해할 수 없습니다."

#: src/construction.cpp
msgid "The rock feels much warmer than normal.  Proceed?"
msgstr "이 바위는 평범한 바위보다 훨씬 뜨거운 것 같습니다. 계속할까요?"

#: src/construction.cpp
msgid "You just tunneled into lava!"
msgstr "용암을 뚫고 들어갔습니다!"

#: src/construction.cpp
msgid "You dig into a preexisting space, and improvise a ladder."
msgstr "기존에 있던 공간을 파고들어가 사다리를 즉석에서 세웠습니다."

#: src/construction.cpp
msgid "You dig a stairway, adding sturdy timbers and a rope for safety."
msgstr "계단을 파내고 안전을 위해 튼튼한 받침목과 로프를 더했습니다."

#: src/construction.cpp
msgid "You drill out a passage, heading deeper underground."
msgstr "지하로 통하는 통로를 뚫었습니다."

#: src/construction.cpp
msgid "The rock overhead feels hot.  You decide *not* to mine magma."
msgstr "머리 위의 바위가 뜨겁습니다. 마그마를 파내지 않기로 합니다."

#: src/construction.cpp
msgid "The rock above is rather damp.  You decide *not* to mine water."
msgstr "머리 위의 바위가 축축합니다. 물을 파내지 않기로 합니다."

#: src/construction.cpp
msgid "You drill out a passage, heading for the surface."
msgstr "지상으로 통하는 통로를 뚫었습니다."

#: src/construction.cpp
msgid "After boarding up the window the curtains and curtain rod are left."
msgstr "창문을 판자로 막고 나니 이제 커튼과 커튼봉이 남아있습니다."

#: src/construction.cpp
msgid "You gather some clay."
msgstr "점토를 모읍니다."

#: src/construction.cpp
msgid "You gather some sand."
msgstr "모래를 모읍니다."

#: src/construction.cpp
msgid "You gather some materials."
msgstr "재료를 모읍니다."

#: src/construction.cpp
msgid "You cannot build there!"
msgstr "그곳에 지을 수 없습니다!"

#: src/construction.cpp
msgid "You cannot deconstruct this!"
msgstr "이건 해체할 수 없습니다!"

#: src/construction.cpp
msgid "Time to complete: "
msgstr "제작 요구시간:"

#: src/consumption.cpp
msgid "That doesn't look edible."
msgstr "먹을 수 없습니다."

#: src/consumption.cpp
msgid "That doesn't look edible to you."
msgstr "이건 먹을 수 없습니다."

#: src/consumption.cpp
msgid "That doesn't look edible in its current form."
msgstr "현재 상태에선 먹을 수 없습니다."

#: src/consumption.cpp
msgid "This is full of dirt after being on the ground."
msgstr "땅에 뒹굴어 흙이 엄청 묻었습니다."

#: src/consumption.cpp src/iuse.cpp src/iuse_actor.cpp
msgid "You can't do that while underwater."
msgstr "물 속에서는 할 수 없습니다."

#: src/consumption.cpp
#, c-format
msgid "You need a %s to consume that!"
msgstr "사용하려면 %s(이)가 필요합니다!"

#: src/consumption.cpp
msgid "We can't eat that.  It's not right for us."
msgstr "우리는 그것을 먹을 수 없다. 그것은 우리와 맞지 않는다."

#: src/consumption.cpp
msgid "Ugh, you can't drink that!"
msgstr "우웩, 이런건 마실게 못됩니다!"

#: src/consumption.cpp
msgid "Eww.  Inedible plant stuff!"
msgstr "우웨엑, 먹지도 못할 풀떼기 같으니!"

#: src/consumption.cpp
msgid "The thought of eating that makes you feel sick."
msgstr "이런걸 먹는다는 생각만으로도 구역질이 납니다."

#: src/consumption.cpp
msgid "You can't eat this."
msgstr "이건 먹을 수 없습니다."

#: src/consumption.cpp
msgid "This is rotten and smells awful!"
msgstr "이건 푹 썩은데다 냄새도 지독합니다!"

#: src/consumption.cpp
msgid "The thought of eating human flesh makes you feel sick."
msgstr "인육을 먹는다는 생각만으로도 구역질이 납니다."

#: src/consumption.cpp
msgid "You still feel nauseous and will probably puke it all up again."
msgstr "아직 어지럽고 계속 구역질이 납니다."

#: src/consumption.cpp
msgid "You're full and will vomit if you try to consume anything."
msgstr "이미 배불러서, 이 이상 뭔가 먹으면 토할 것 같습니다."

#: src/consumption.cpp
msgid "Your stomach won't be happy (allergy)."
msgstr "속이 안 좋아질 것입니다. (알러지)"

#. ~ No, we don't eat "rotten" food. We eat properly aged food, like a normal
#. person.
#. ~ Semantic difference, but greatly facilitates people being proud of their
#. character.
#: src/consumption.cpp
msgid "Your stomach won't be happy (not rotten enough)."
msgstr "속이 안 좋아질 것입니다. (음식이 덜 썩음)"

#: src/consumption.cpp
msgid "You're full already and the excess food will be wasted."
msgstr "이미 배부른 탓에 남은 음식은 낭비될 것입니다."

#: src/consumption.cpp
#, c-format
msgid "Eat your %s anyway?"
msgstr "그래도 %s(을)를 먹으려 시도합니까?"

#: src/consumption.cpp
#, c-format
msgid "Drink your %s anyway?"
msgstr "그래도 %s(을)를 마시려 시도합니까?"

#: src/consumption.cpp
#, c-format
msgid "Consume your %s anyway?"
msgstr "그래도 %s(을)를 소비하려 시도합니까?"

#: src/consumption.cpp
#, c-format
msgid "You force yourself to vomit to make space for %s."
msgstr "%s(을)를 먹기 전 뱃속을 비우기 위해 억지로 구역질합니다."

#: src/consumption.cpp
#, c-format
msgid "Ick, this %s doesn't taste so good…"
msgstr "윽, %s(은)는 맛이 영 별로입니다..."

#: src/consumption.cpp
#, c-format
msgid "Mmm, this %s tastes delicious…"
msgstr "으음, %s(은)는 맛이 끝내주는군요..."

#: src/consumption.cpp
#, c-format
msgid "<npcname> assimilates a %s."
msgstr "<npcname>(이)가 %s(을)를 동화시킵니다."

#: src/consumption.cpp
#, c-format
msgid "You assimilate your %s."
msgstr "%s(을)를 동화시킵니다."

#: src/consumption.cpp
#, c-format
msgid "<npcname> drinks a %s."
msgstr "<npcname>(이)가 %s(을)를 마십니다."

#: src/consumption.cpp
#, c-format
msgid "You drink your %s."
msgstr "%s(을)를 마십니다."

#: src/consumption.cpp
#, c-format
msgid "<npcname> eats a %s."
msgstr "<npcname>(이)가 %s(을)를 먹었습니다."

#: src/consumption.cpp
#, c-format
msgid "You eat your %s."
msgstr "%s(을)를 먹었습니다."

#: src/consumption.cpp
msgid "The shadows are getting ever closer."
msgstr "그림자가 점점 다가오고 있습니다."

#: src/consumption.cpp
msgid "You have a bad feeling about this."
msgstr "느낌이 영 좋지 않습니다."

#: src/consumption.cpp
msgid "A powerful sense of dread comes over you."
msgstr "끔찍한 공포가 당신을 덮칩니다."

#: src/consumption.cpp
msgid "Your skin starts crawling."
msgstr "몸이 덜덜 떨리기 시작합니다."

#: src/consumption.cpp
msgid "They're coming to get you."
msgstr "놈들이 다가옵니다."

#: src/consumption.cpp
msgid "This might've been a bad idea…"
msgstr "좋지 않은 판단이었습니다..."

#: src/consumption.cpp
msgid "You've really done it this time, haven't you?"
msgstr "이번에야말로 해냈군요. 그렇죠?"

#: src/consumption.cpp
msgid "You have to stay vigilant.  They're always watching…"
msgstr "경계를 늦춰선 안됩니다. 놈들은 어디서나 당신을 지켜봅니다..."

#: src/consumption.cpp
msgid "mistake mistake mistake mistake mistake"
msgstr ""
"실패했다 실패했다 실패했다 실패했다 실패했다 실패했다 "
"실패했다실패했다실패했다실패했다실패했다실패했다실패했다실패했다실패실패실패실패실패실패실패실패실패실패실패실패실패실패실패"

#: src/consumption.cpp
msgid "Just gotta stay calm, and you'll make it through this."
msgstr "참자, 참자, 참자. 이제 다 끝날 거야."

#: src/consumption.cpp
msgid "You're starting to feel very jumpy."
msgstr "매우 초조해지기 시작합니다."

#: src/consumption.cpp
msgid "Something is twitching at the edge of your vision."
msgstr "시야 끄트머리에서 뭔가가 꾸물거립니다."

#: src/consumption.cpp
msgid "They know what you've done…"
msgstr "놈들은 당신이 저지른 짓을 알고 있습니다..."

#: src/consumption.cpp
msgid "You're feeling even more paranoid than usual."
msgstr "평소보다 더 편집증적인 느낌이 듭니다."

#: src/consumption.cpp
#, c-format
msgid "You heat up your %1$s using the %2$s."
msgstr "%2$s(을)를 사용하여 %1$s(을)를 데웁니다."

#: src/consumption.cpp
#, c-format
msgid "<npcname> heats up their %1$s using the %2$s."
msgstr "<npcname>(이)가 %2$s(을)를 사용하여 %1$s(을)를 데웁니다."

#: src/consumption.cpp
msgid "This stuff is icy!"
msgstr "이 음식은 꽁꽁 얼었습니다!"

#: src/consumption.cpp
msgid "This stuff is cold!"
msgstr "이 음식은 차갑습니다!"

#: src/consumption.cpp
msgid "You indulge your shameful hunger."
msgstr "불미스러운 갈망을 마음껏 채웁니다."

#: src/consumption.cpp
msgid "You feel horrible for eating a person."
msgstr "식인하는 것에 대해 끔찍한 기분이 들었습니다."

#: src/consumption.cpp
msgid "Yuck!  How can anybody eat this stuff?"
msgstr "우웩! 이딴걸 누가 먹는거죠?"

#: src/consumption.cpp
msgid "Mmm, junk food."
msgstr "으음, 불량식품."

#: src/consumption.cpp
msgid "When life's got you down, there's always sugar."
msgstr "삶이 힘들고 괴로울 때는 달달한걸 먹어줘야죠."

#: src/consumption.cpp
msgid "They may do what they must… you've already won."
msgstr "저들은 해야 할 일을 할 뿐입니다... 당신이 이미 해낸 일을요."

#: src/consumption.cpp
msgid "Your stomach begins gurgling and you feel bloated and ill."
msgstr "위장이 꾸륵거리고, 속이 메스꺼워지기 시작합니다."

#: src/consumption.cpp
msgid "You find the sweet taste of honey surprisingly palatable."
msgstr "이 꿀은 달달한게 참 좋습니다."

#: src/consumption.cpp
msgid "You feast upon the sweet honey."
msgstr "달콤한 꿀을 실컷 즐깁니다."

#: src/consumption.cpp
msgid "You feel as though you're going to split open!  In a good way?"
msgstr "째지는 기분입니다! 긍정적인 의미로요."

#. ~ slimespawns have *small voices* which may be the Nice equivalent
#. ~ of the Rat King's ALL CAPS invective.  Probably shared-brain telepathy.
#: src/consumption.cpp
msgid "hey, you look like me!  let's work together!"
msgstr "흠, 우리 닮은 것 같은데! 같이 하자고!"

#: src/consumption.cpp
#, c-format
msgid "Are you sure you want to eat your favorited %s?"
msgstr "즐겨찾기된 %s(을)를 정말 먹을건가요?"

