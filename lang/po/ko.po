#: src/ranged.cpp
#, c-format
msgid "<npcname>'s attached %s is destroyed by their shot!"
msgstr "<npcname>의 부착된 %s(이)가 격발과 함께 파괴되었습니다!"

#: src/ranged.cpp
#, c-format
msgid "Your attached %s is damaged by your shot!"
