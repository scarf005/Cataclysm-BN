#: src/ranged.cpp
#, c-format
msgid "<npcname>'s %s is damaged by their shot!"
msgstr "<npcname>의 부착된 %s(이)가 격발과 함께 손상을 입었다!"

#: src/ranged.cpp
#, c-format
msgid "Your %s emits a grimace-inducing screech!"
msgstr "%s에서 얼굴을 찌푸리게 하는 굉음이 납니다!"

#: src/ranged.cpp
#, c-format
msgid "<npcname>'s %s emits a grimace-inducing screech!"
msgstr "<npcname>의 %s에서 얼굴을 찌푸리게 하는 굉음이 납니다!"

#: src/ranged.cpp
#, c-format
msgid "Your %s fails to cycle!"
msgstr "%s(이)가 순환에 실패합니다!"

#: src/ranged.cpp
#, c-format
msgid "<npcname>'s %s fails to cycle!"
msgstr "<npcname>의 %s(이)가 순환에 실패합니다!"

#: src/ranged.cpp
#, c-format
msgid "Your %s is damaged by the high pressure!"
msgstr "%s(이)가 높은 압력에 의해 손상을 입었습니다!"

#: src/ranged.cpp
#, c-format
msgid "<npcname>'s %s is damaged by the high pressure!"
msgstr "<npcname>의 %s(이)가 높은 압력에 의해 손상을 입었습니다!"

#: src/ranged.cpp
#, c-format
msgid "%s shoots something."
msgstr "%s(이)가 뭔가에 사격합니다."

#: src/ranged.cpp
#, c-format
msgid "You hear %s."
msgstr "%s 소리를 들었습니다."

#: src/ranged.cpp
#, c-format
msgid "You cycle your %s manually."
msgstr "%s(을)를 수동으로 순환시킵니다."

#: src/ranged.cpp
#, c-format
msgid "You fire your %s, %s"
msgstr "%s (을)를 발사합니다. %s"

#: src/ranged.cpp
#, c-format
msgid "You fire your %s!"
msgstr "%s(을)를 발사합니다!"

#: src/ranged.cpp
#, c-format
msgid "You feel a surge of euphoria as flames roar out of the %s!"
msgstr "%s(이)가 불길이 치솟으면서 행복감이 솟구치는 것을 느낍니다!"

#: src/ranged.cpp
msgid "Steadiness"
msgstr "안정도"

#: src/ranged.cpp
msgid "Moves"
