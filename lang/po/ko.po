#: src/activity_handlers.cpp
#, c-format
msgid "You failed at installing the %s and destroyed your %s!"
msgstr "%s 설치에 실패해 %s(을)를 부숴버렸습니다!"

#: src/activity_handlers.cpp
#, c-format
msgid "You failed at installing the %s and damaged your %s!"
msgstr "%s 설치에 실패해 %s에 피해를 입습니다!"

