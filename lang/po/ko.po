msgid "A glass bowl for soup or dessert."
msgstr "수프나 디저트를 담는데 쓰이는 유리 그릇입니다."

#: data/json/items/generic/dining_kitchen.json
msgid "plastic tumbler"
msgid_plural "plastic tumblers"
