msgstr "워머스.  록 배스처럼 이 작은 물고기는 선피쉬같은 물고기입니다."

#: data/json/monsters/fish.json
msgid "bullhead"
msgid_plural "bullheads"
msgstr[0] "불헤드"

#. ~ Description for {'str': 'bullhead'}
