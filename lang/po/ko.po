msgstr "게임 난이도"

#: src/iuse_software_minesweeper.cpp
msgid "Beginner"
msgstr "초심자"

#: src/iuse_software_minesweeper.cpp
msgid "Intermediate"
msgstr "중급자"

#: src/iuse_software_minesweeper.cpp
msgid "Expert"
msgstr "뛰어남"

#: src/iuse_software_minesweeper.cpp
msgid "Level width:"
msgstr "가로:"

#: src/iuse_software_minesweeper.cpp
msgid "Level height:"
msgstr "세로:"

#: src/iuse_software_minesweeper.cpp
msgid "Number of bombs:"
msgstr "폭탄 갯수:"

