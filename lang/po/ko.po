#: data/json/snippets/residential_signs.json
msgid "Polyphemus Security - 555-1112-  \"Keeping an Eye Out since 1987\""
msgstr "폴리페무스 경비업체 - 555-1112 - \"1987년부터 줄곧 경비 중\""

#: data/json/snippets/schizophrenia.json
msgid "Hey, can you hear me?"
msgstr "야, 내 말 들려?"

#: data/json/snippets/schizophrenia.json
msgid "Don't touch me."
msgstr "건드리지 마."

#: data/json/snippets/schizophrenia.json
msgid "What's your name?"
msgstr "이름이 뭐야?"

#: data/json/snippets/schizophrenia.json
msgid "I thought you were my friend."
msgstr "난 네가 내 친구인 줄 알았어."

#: data/json/snippets/schizophrenia.json
msgid "How are you today?"
msgstr "오늘 어떠니?"

#: data/json/snippets/schizophrenia.json
msgid "Shut up!  Don't lie to me."
msgstr "닥쳐! 거짓말하지마."

#: data/json/snippets/schizophrenia.json src/iuse.cpp
msgid "Why would you do that?"
msgstr "왜 그런 짓을 하는거야?"

#: data/json/snippets/schizophrenia.json
msgid "Please, don't go."
msgstr "제발 가지마."

#: data/json/snippets/schizophrenia.json
msgid "Don't leave me alone!"
msgstr "날 혼자 두지 마!"

#: data/json/snippets/schizophrenia.json
msgid "No way, man."
msgstr "안돼, 임마."

#: data/json/snippets/schizophrenia.json
msgid "Do you really think so?"
msgstr "정말 그렇게 생각해?"

#: data/json/snippets/schizophrenia.json
msgid "Is it really time for that?"
msgstr "꼭 그거 지금 해야 해?"

#: data/json/snippets/schizophrenia.json
msgid "Sorry, I can't hear you."
msgstr "미안, 못 들었어."

#: data/json/snippets/schizophrenia.json
msgid "You've told me already."
msgstr "그거 이미 말했잖아."

#: data/json/snippets/schizophrenia.json
msgid "I know!"
msgstr "나 알아!"

#: data/json/snippets/schizophrenia.json
msgid "Why are you following me?"
msgstr "왜 나를 미행하는 거야?"

#: data/json/snippets/schizophrenia.json
msgid "This place is dangerous, you shouldn't be here."
msgstr "이 장소는 너무 위험해, 너는 여기있어선 안돼"

#: data/json/snippets/schizophrenia.json
msgid "That's not true, is it?"
msgstr "사실이 아니겠지?"

#: data/json/snippets/schizophrenia.json
msgid "Are you hurt?"
msgstr "다쳤어?"

#: data/json/snippets/schizophrenia.json
msgid "I awaken when you slumber."
msgstr "네가 잠들 때 나는 깨어난다."

#: data/json/snippets/schizophrenia.json
msgid "Was that noises?  I think I heard noises."
msgstr "방금 무슨 소리였지? 무슨 소리를 들은 것 같은데."

#: data/json/snippets/schizophrenia.json
msgid "I saw something up ahead.  I promise this time."
msgstr "저쪽에서 뭔가를 봤어. 이번에는 진짜야."

#: data/json/snippets/schizophrenia.json
msgid "Who cried wolf!?"
msgstr "누가 양치기 소년짓을 했어!"

#: data/json/snippets/schizophrenia.json
msgid "The trees are talking behind your back."
msgstr "네 뒤에서 나무들이 이야기하고 있어."

#: data/json/snippets/schizophrenia.json
msgid "And thus we live to struggle another day."
msgstr "그리고 우리는 오늘도 살아가는거야."

#: data/json/snippets/schizophrenia.json
msgid "Any man, no matter how hard, can bear his burdens for one day."
msgstr "강인하든 허약하든, 사람은 제 책임을 감당해야 하는 법이지."

#: data/json/snippets/schizophrenia.json
msgid ""
"Did you sleep well last night?  And the night before that?  I was with you "
"from the very beginning."
msgstr "어젯밤에 잘 잤어? 그 전날밤에는? 난 처음부터 너랑 함께 있었는데."

#: data/json/snippets/schizophrenia.json
msgid "Please, someone, save me."
msgstr "제발, 누가, 좀 구해줘."

#: data/json/snippets/schizophrenia.json
msgid "Hey, let's go kill that %1$s!"
msgstr "이봐, 나%1$s(을)를 죽이러 가자!"

#: data/json/snippets/schizophrenia.json
msgid "Did you see that %1$s!?"
msgstr "너 %1$s봤어?"

#: data/json/snippets/schizophrenia.json
msgid "I want to kill that %1$s!"
msgstr "나는 %1$s(을)를 죽이고 싶어!"

#: data/json/snippets/schizophrenia.json
msgid "Let me kill that %1$s!"
msgstr "%1$s(을)를 죽이게 해줘!"

#: data/json/snippets/schizophrenia.json
msgid "Hey, I need to kill that %1$s!"
msgstr "이봐, 나는 %1$s(을)를 죽여야되!"

#: data/json/snippets/schizophrenia.json
msgid "I want to watch that %1$s bleed!"
msgstr "나는 %1$s(이)가 피 흘리는걸 보고 싶어!"

#: data/json/snippets/schizophrenia.json
msgid "Wait, that %1$s needs to die!"
msgstr "잠깐, %1$s(은)는 죽어야 해!"

#: data/json/snippets/schizophrenia.json
msgid "Go kill that %1$s!"
msgstr "%1$s(을)를 죽이러 가자!"

#: data/json/snippets/schizophrenia.json
msgid "Look at that %1$s!"
msgstr "%1$s(을)를 봐!"

#: data/json/snippets/schizophrenia.json
msgid "That %1$s doesn't deserve to live!"
msgstr "그 %1$s(은)는 살 자격이 없어!"

#: data/json/snippets/schizophrenia.json
msgid "That %1$s looked at you funny.  Kill it.  Now."
msgstr "%1$s(이)가 널 비웃었어. 죽여. 당장."

#: data/json/snippets/schizophrenia.json
msgid "That %1$s seems to be smiling at you.  Go say hi for me."
msgstr "%1$s(이)가 너한테 웃어주는 것 같아. 가서 내 대신 인사해줘."

#: data/json/snippets/schizophrenia.json
msgid "Hey, you're bleeding."
msgstr "야, 너 피 흘리고 있잖아."

#: data/json/snippets/schizophrenia.json
msgid "Your wound looks pretty bad."
msgstr "지독한 상처구만."

#: data/json/snippets/schizophrenia.json
msgid "Shouldn't you put a bandage on that?"
msgstr "붕대 좀 감아야 될 것 같은데?"

#: data/json/snippets/schizophrenia.json
msgid "Please don't die!  No one else lets me kill things!"
msgstr "죽으면 안돼! 네가 없으면 누구랑 같이 저것들을 죽여야 해!?"

#: data/json/snippets/schizophrenia.json
msgid "You look hurt, did I do that?"
msgstr "다친 것 같은데, 내가 그랬어?"

#: data/json/snippets/schizophrenia.json
msgid "Are you supposed to be bleeding?"
msgstr "너 오늘 하루종일 피흘릴 예정이야?"

#: data/json/snippets/schizophrenia.json
msgid "You're not going to die, are you?"
msgstr "죽는거 아니지, 응?"

#: data/json/snippets/schizophrenia.json
msgid "Kill a few more before you bleed out!"
msgstr "비쩍 마른 미라 새끼 되기 전에 한 놈이라도 더 죽여!"

#: data/json/snippets/schizophrenia.json
msgid "Let me have a taste of your blood."
msgstr "네 피를 한 방울만 맛보게 해줘."

#: data/json/snippets/schizophrenia.json
msgid ""
"Thrust me deeper into the wound.  You know that this is the only way out "
"right?"
msgstr "더 깊게 찔러야지. 그게 네가 유일하게 할 줄 아는거잖아?"

#: data/json/snippets/schizophrenia.json
msgid "Hey fix me up."
msgstr "여기 다친 곳 좀 꿰매봐."

#: data/json/snippets/schizophrenia.json
msgid "I need healing!"
msgstr "나 치료가 필요해!"

#: data/json/snippets/schizophrenia.json
msgid "I hurt all over…"
msgstr "온 몸이 아픈데…"

#: data/json/snippets/schizophrenia.json
msgid "You can put me back together, right?"
msgstr "나 다시 불러줄거지, 응?"

#: data/json/snippets/schizophrenia.json
msgid "I… I can't move my legs!"
msgstr "다… 다리가 안 움직여!"

#: data/json/snippets/schizophrenia.json
msgid "Medic!"
msgstr "의무병!"

#: data/json/snippets/schizophrenia.json
msgid "I can still fight, don't replace me!"
msgstr "나 아직 싸울 수 있어, 내쫓지 말아줘!"

#: data/json/snippets/schizophrenia.json
msgid "They got me!"
msgstr "놈들한테 잡혔어!"

#: data/json/snippets/schizophrenia.json
msgid "*cough cough* Go on without me…"
msgstr "켁켁, 난 놔두고 빨리 가…"

#: data/json/snippets/schizophrenia.json
msgid "Am I gonna die?"
msgstr "나 죽는거냐?"

#: data/json/snippets/schizophrenia.json
msgid "Why have you treated me like you treated your self?"
msgstr "왜 넌 네 자신한테 한 짓거리들을 나한테도 하는거야?"

#: data/json/snippets/schizophrenia.json
msgid "This is the end; the bitter, bitter end."
msgstr "이게 바로 끝이야. 비참하고 씁쓸한 끝이지."

#: data/json/snippets/schizophrenia.json
msgid "Let me kill something already!"
msgstr "뭐 좀 죽이고 싶은데!"

#: data/json/snippets/schizophrenia.json
msgid "I'm your best friend, right?"
msgstr "난 너의 제일 친한 친구야, 그렇지?"

#: data/json/snippets/schizophrenia.json
msgid "Do you think it will rain today?"
msgstr "오늘 비가 올 것 같아?"

#: data/json/snippets/schizophrenia.json
msgid "Try not to drop me."
msgstr "나를 떨어트리지 마."

#: data/json/snippets/schizophrenia.json
msgid "How many do you think we've killed?"
msgstr "우리가 몇 명이나 죽였을까?"

#: data/json/snippets/schizophrenia.json
msgid "I'll keep you safe!"
msgstr "내가 널 지켜줄게!"

#: data/json/snippets/schizophrenia.json
msgid "I don't trust you."
msgstr "난 널 믿지 않아."

#: data/json/snippets/schizophrenia.json
msgid "Why did you suffer so?"
msgstr "왜 그렇게 괴로워하는거지?"

#: data/json/snippets/schizophrenia.json
msgid "It's time to let me go."
msgstr "이제 날 보내줄 시간이야."

#: data/json/snippets/schizophrenia.json
msgid "You feel like the world is out to get you."
msgstr "온 세상이 당신을 괴롭히는 기분이 듭니다."

#: data/json/snippets/schizophrenia.json
msgid "You feel a mounting sense of impending doom."
msgstr "가까워지는 멸망에 대한 기분이 당신을 짓누릅니다."

#: data/json/snippets/schizophrenia.json
msgid ""
"You gain the sudden realization that you must have been responsible for the "
"Cataclysm."
msgstr "당신이 이 종말에 대한 책임이 있다는 갑작스러운 깨달음이 찾아옵니다."

#: data/json/snippets/schizophrenia.json
msgid "You get the odd feeling that your thoughts are not your own."
msgstr "당신의 생각을 스스로 떠올린게 아닌 것 같다는 기이한 기분이 듭니다."

#: data/json/snippets/schizophrenia.json
msgid ""
"You feel as if everyone in the world must be playing a sick prank on you."
msgstr "온 세상의 모두가 당신을 상대로 개같은 장난을 치는 기분이 듭니다."

#: data/json/snippets/schizophrenia.json
msgid "You are being watched… by THEM."
msgstr "놈들이… 당신을 지켜보고 있습니다."

#: data/json/snippets/schizophrenia.json
msgid ""
"You sense a vast aura envelop the landscape, and the skies seem to turn a "
"bleeding edge.  Then, a thunderclap is heard in the distance, and everything"
" becomes normal once more.  For now."
msgstr ""
"주변 풍경으로부터 어마어마한 기운이 솟구치고, 하늘이 피눈물을 흘리기 시작합니다. 그리고 저 멀리서 천둥번개가 울려퍼지자 세상이 다시 "
"원래대로 돌아옵니다. 지금 당장은요."

#: data/json/snippets/schizophrenia.json
msgid ""
"You feel your innards churn as you suddenly develop the urge to tear grass "
"out of its roots."
msgstr "풀을 뿌리째 산산조각내고 싶다는 욕망이 솟구쳐 속이 뒤틀립니다."

#: data/json/snippets/schizophrenia.json
msgid ""
"You begin to sweat uncontrollably as your hands start to shake.  It feels as"
" if something is shaking them violently."
msgstr "손이 덜덜 떨리고, 식은땀이 줄줄 흐릅니다. 마치 누군가가 당신의 손을 붙잡고 격하게 흔드는 것 같습니다."

#: data/json/snippets/schizophrenia.json
msgid ""
"You gain the sudden realization that you are the creator of the universe."
msgstr "당신이 이 우주의 창조자라는 갑작스러운 깨달음이 찾아옵니다."

#: data/json/snippets/schizophrenia.json
msgid "You increase all your skills to level 10."
msgstr "모든 기술을 10레벨까지 습득했습니다."

#: data/json/snippets/schizophrenia.json
msgid ""
"You feel that this must be a global reality show, in which you are the star."
msgstr "시실 이 모든 게 굉장한 리얼리티 예능이고, 당신이 그 주인공인 것 같다는 기분이 듭니다."

#: data/json/snippets/schizophrenia.json
msgid ""
"You now know that you are a secret agent, kept alive to continue serving the"
" government."
msgstr "당신이 아직 살아남아 정부에 봉사하는 비밀요원이라는 사실을 이제 알고 있습니다."

#: data/json/snippets/schizophrenia.json
msgid "You feel in full control of the situation."
msgstr "당신은 상황을 완전하게 통제하고 있다는 기분이 듭니다."

#: data/json/snippets/schizophrenia.json
msgid ""
"You attained perfection a long time ago.  This world is but a mirage of your"
" own making.  Thus, this is a perfect world."
msgstr ""
"먼 옛날, 당신은 완전성을 손에 넣었습니다. 이 세상은 당신이 만든 것의 거울상에 불과하죠. 그러므로 참으로 완벽한 세상이라 하겠습니다."

#: data/json/snippets/schizophrenia.json
msgid "Your skin feels itchy."
msgstr "피부가 가렵습니다."

#: data/json/snippets/schizophrenia.json
msgid "You can feel something wriggling underneath your skin."
msgstr "피부 아래에서 꿈틀거리는 무언가가 느껴집니다."

#: data/json/snippets/schizophrenia.json
msgid "You can feel insects crawling all over you."
msgstr "벌레들이 당신을 기어다니고 있습니다."

#: data/json/snippets/schizophrenia.json
msgid "You feel larvae wriggling beneath the skin."
msgstr "피부 아래에서 꿈틀거리는 애벌레가 느껴집니다."

#: data/json/snippets/schizophrenia.json
msgid "You feel itchy all over."
msgstr "온 몸이 가렵습니다."

#: data/json/snippets/schizophrenia.json
msgid "You feel like you're covered in bugs."
msgstr "벌레로 뒤덮인 것 같은 기분이 듭니다."

#: data/json/snippets/schizophrenia.json
msgid "You feel bugs crawling on you."
msgstr "벌레가 당신을 기어다닙니다."

#: data/json/snippets/schizophrenia.json
msgid "You distinctly feel a presence just behind you."
msgstr "본능적으로 당신의 뒤쪽으로부터 존재감을 느낍니다."

#: data/json/snippets/schizophrenia.json
msgid "\"Get away from there!\""
msgstr "\"거기서 물러나!\""

#: data/json/snippets/schizophrenia.json
msgid "\"Don't point that thing at me!\""
msgstr "\"나한테 그걸 겨누지 마!\""

#: data/json/snippets/schizophrenia.json
msgid "\"No!  Stop!\""
msgstr "\"안돼! 멈춰!\""

#: data/json/snippets/schizophrenia.json
msgid "\"Get the fuck away from me!\""
msgstr "\"당장 나한테서 꺼져!\""

#: data/json/snippets/schizophrenia.json
msgid "\"That's not true!\""
msgstr "\"그건 사실이 아니야!\""

#: data/json/snippets/schizophrenia.json
msgid "\"What do you want from me?\""
msgstr "\"나한테서 뭘 원하는거야?\""

#: data/json/snippets/schizophrenia.json
msgid "\"I didn't mean to do it!\""
msgstr "\"난 그러려던 게 아니였어!\""

#: data/json/snippets/schizophrenia.json
msgid "\"I had to do it!\""
msgstr "\"난 그걸 해야 했어!\""

#: data/json/snippets/schizophrenia.json
msgid "\"I should never have trusted you!\""
msgstr "\"너를 믿는 게 아니였는데!\""

#: data/json/snippets/schizophrenia.json
msgid "\"RUN.  NOW.  IT MAY NOT BE TOO LATE.\""
msgstr "\"뛰어. 당장. 아직 안 늦었어.\""

