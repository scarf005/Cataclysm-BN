#: data/json/npcs/talk_tags.json
msgid "I'm parched, I need to drink something."
msgstr "목말라 죽을 것 같아. 뭐라도 마셔야겠어."

#: data/json/npcs/talk_tags.json
msgid "I'm thirsty…"
msgstr "목말라..."

#: data/json/npcs/talk_tags.json
msgid "I'm <very> thirsty."
msgstr "나 <very> 목말라."

#: data/json/npcs/talk_tags.json
