msgid "<n>ew level"
msgstr "<n> 새 게임"

#: src/iuse_software_minesweeper.cpp
msgid "<f>lag"
msgstr "<f> 깃발"

#: src/iuse_software_minesweeper.cpp
msgid "Boom, you're dead!  Better luck next time."
msgstr "쾅, 당신은 죽었습니다! 다음에는 더 잘할 수 있을거에요."

