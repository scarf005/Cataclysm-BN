msgstr "지자기 폭풍"

#: data/mods/JP_Weather_Variants/weather_type.json
msgid "Northern Lights"
msgstr "북극광"

#: data/mods/JP_Weather_Variants/weather_type.json
msgid "Acid Flurries"
msgstr "강산 진눈깨비"

#: data/mods/JP_Weather_Variants/weather_type.json
