msgstr "%s의 잔여량이 모두 떨어졌습니다."

#: src/activity_handlers.cpp src/iuse_actor.cpp
msgid "You won't learn anything more by doing that."
msgstr "그 행동에서 아무것도 배운 것이 없습니다."

#: src/activity_handlers.cpp
#, c-format
msgid "%s %s\n"
msgstr "%s %s\n"

#: src/activity_handlers.cpp
#, c-format
