msgid "<+> next"
msgstr "<+> 다음단계"

#: src/iuse_software_sokoban.cpp
msgid "<-> prev"
msgstr "<-> 이전단계"

#: src/iuse_software_sokoban.cpp
msgid "<u>ndo move"
msgstr "<u>이동 전으로"

