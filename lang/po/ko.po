#, c-format
msgid "Level: %d/%d"
msgstr "단계: %d/%d"

#: src/iuse_software_sokoban.cpp
#, c-format
msgid "Moves: %d"
msgstr "이동횟수: %d"

#: src/iuse_software_sokoban.cpp
#, c-format
msgid "Total moves: %d"
msgstr "총 이동횟수: %d"

