#: src/iuse.cpp
#, c-format
msgid "You remove the radio modification from your %s!"
msgstr "%s에서 라디오 부품을 제거합니다!"

#: src/iuse.cpp
msgid "Are you sure you want to drink… this?"
msgstr "이걸 마신다니… 진짜로요?"

#: src/iuse.cpp
#, c-format
msgid "You take some %s."
msgstr "%s(을)를 복용합니다."

#: src/iuse.cpp
msgid "You take some antibiotics."
msgstr "항생제를 들이킵니다."

#: src/iuse.cpp
msgid "<npcname> takes some antibiotics."
msgstr "<npcname>(이)가 항생제를 들이킵니다."

#: src/iuse.cpp
msgid ""
"Maybe just placebo effect, but you feel a little better as the dose settles "
"in."
msgstr "플라시보 효과일지도 모르지만, 약을 들이키고 나니 기분이 좀 나아집니다."

#: src/iuse.cpp
#, c-format
msgid "You're out of %s."
msgstr "%s(이)가 다 떨어졌습니다."

#: src/iuse.cpp src/iuse_actor.cpp
#, c-format
msgid "You use your %s."
msgstr "%s(을)를 사용합니다."

#: src/iuse.cpp
msgid "You wash the slime from your eyes."
msgstr "눈에서 점액을 씻어냅니다."

#: src/iuse.cpp
msgid "<npcname> uses some fungicide"
msgstr "<npcname>(이)가 살진균제를 사용합니다."

#: src/iuse.cpp
msgid "You use your fungicide."
msgstr "살진균제를 사용합니다."

#: src/iuse.cpp
msgid "You feel a burning sensation under your skin that quickly fades away."
msgstr "피부 밑에서 불타는 듯한 감각이 느껴지다가 빠르게 잦아듭니다."

#: src/iuse.cpp
msgid "Your skin grows warm for a moment."
msgstr "피부가 잠시 뜨거워집니다."

#: src/iuse.cpp
msgid "You take some antifungal medication."
msgstr "항진균제를 복용합니다."

#: src/iuse.cpp
msgid "You take some antiparasitic medication."
msgstr "구충제를 복용합니다."

#: src/iuse.cpp
msgid "The itching sensation under your skin fades away."
msgstr "가려운 느낌이 점차 사라집니다."

#: src/iuse.cpp
msgid "Your bowels clench as something inside them dies."
msgstr "뱃속의 뭔가가 죽으면서 창자가 꽉 죄입니다."

#: src/iuse.cpp
msgid "Your bowels spasm painfully as something inside them dies."
msgstr "뱃속의 뭔가가 죽으면서 창자가 고통스럽게 경련합니다."

#: src/iuse.cpp
msgid "Your skin prickles and your veins itch for a few moments."
msgstr "피부가 따끔거리고 정맥이 잠시 가려워집니다."

#: src/iuse.cpp
msgid "The pressure inside your head feels better already."
msgstr "머릿속의 압박감이 꽤 나아졌습니다."

#: src/iuse.cpp
msgid "Your head pounds like a sore tooth as something inside of it dies."
msgstr "머릿속의 뭔가가 죽으면서 머리가 마치 시린 이처럼 후들거립니다."

#: src/iuse.cpp
msgid "The stiffness in your joints goes away."
msgstr "결리던 관절이 나아집니다."

#: src/iuse.cpp
msgid "The pain in your joints goes away."
msgstr "관절에서 느껴지던 고통이 사라집니다."

#: src/iuse.cpp
msgid "You take some anticonvulsant medication."
msgstr "항경련제를 복용합니다."

#: src/iuse.cpp
msgid "You stop shaking."
msgstr "몸의 떨림이 멈춥니다."

#: src/iuse.cpp
msgid "You smoke your meth."
msgstr "메스암페타민을 피웁니다."

#: src/iuse.cpp
msgid "The world seems to sharpen."
msgstr "세상이 점차 뚜렷하게 보입니다."

#: src/iuse.cpp
msgid "You snort some crystal meth."
msgstr "메스암페타민 가루를 흡입합니다."

#: src/iuse.cpp
msgid "You inject the vaccine."
msgstr "백신을 주사합니다."

#: src/iuse.cpp
msgid "You feel tough."
msgstr "튼튼해진 기분입니다."

#: src/iuse.cpp
msgid ""
"You no longer need to worry about asthma attacks, at least for a while."
msgstr "천식 발작을 걱정하지 않아도 될 것 같습니다. 적어도 당분간은요."

#: src/iuse.cpp
msgid "Are you sure you want to eat this?  It looks poisonous…"
msgstr "이걸 정말로 먹습니까? 독이 있어보입니다…"

#: src/iuse.cpp
#, c-format
msgid "This %s probably meant a lot to someone at one time."
msgstr "이 %s(은)는 누군가에게는 큰 의미가 있었을지도 모릅니다."

#: src/iuse.cpp
msgid "You feel completely exhausted."
msgstr "완전히 지쳤습니다."

#: src/iuse.cpp
msgid "You feel a bit wobbly."
msgstr "조금 어지럽습니다."

#: src/iuse.cpp
msgid "You suddenly feel hollow inside."
msgstr "느닷없이 몸 안이 텅 빈 느낌이 듭니다."

#: src/iuse.cpp
msgid "You feel sleepy…"
msgstr "졸립니다..."

#: src/iuse.cpp
msgid "You eat the datura seed."
msgstr "흰독말풀 씨앗을 먹습니다."

#: src/iuse.cpp
#, c-format
msgid "You take some %s"
msgstr "%s(을)를 복용합니다."

#: src/iuse.cpp
msgid "You take a puff from your inhaler."
msgstr "호흡기로 숨을 들이마십니다."

#: src/iuse.cpp
msgid "<npcname> takes a puff from their inhaler."
msgstr "<npcname>(이)가 호흡기로 숨을 들이마쉽니다."

#: src/iuse.cpp
#, c-format
msgid "You breathe deeply from the %s"
msgstr "%s(을)를 깊게 들이마십니다."

#: src/iuse.cpp
#, c-format
msgid "<npcname> breathes from the %s"
msgstr "<npcname>(이)가 %s(을)를 깊게 들이마십니다."

#: src/iuse.cpp
msgid "This looks unhealthy, sure you want to drink it?"
msgstr "이건 몸에 좋지 않아보이는데, 정말로 마십니까?"

#: src/iuse.cpp
msgid "This looks unhealthy, sure you want to eat it?"
msgstr "이건 몸에 좋지 않아보이는데, 정말로 먹습니까?"

#: src/iuse.cpp
msgid "Blech, that tastes gross!"
msgstr "우웩, 맛이 끔찍합니다!"

#: src/iuse.cpp
msgid "Blech, that burns your throat!"
msgstr "우웩, 목이 타는 것 같습니다!"

#: src/iuse.cpp
msgid "This looks unclean, sure you want to drink it?"
msgstr "이건 더러워보이는데, 정말로 마십니까?"

#: src/iuse.cpp
msgid "This looks unclean, sure you want to eat it?"
msgstr "이건 더러워보이는데, 정말로 먹습니까?"

#: src/iuse.cpp
msgid "The meal is revitalizing."
msgstr "음식을 먹고 나니 몸에 활기가 돕니다."

#: src/iuse.cpp
msgid "Oddly enough, this doesn't taste so bad."
msgstr "기묘하게도, 맛이 그렇게 나쁘지는 않습니다."

#: src/iuse.cpp
msgid "You feel cleansed."
msgstr "정화되는 듯한 기분입니다."

#: src/iuse.cpp
msgid "You feel a slight itching inside, but it passes."
msgstr "안쪽에서 조금 근질거리는 느낌이 들었지만, 이내 사라집니다."

#: src/iuse.cpp
msgid "You feel a distinct burning inside, but it passes."
msgstr "체내에서 열기를 느꼈지만, 이내 사라집니다."

#: src/iuse.cpp
msgid "Feels like you're on fire, but you're OK."
msgstr "마치 불타는 듯한 기분이 들지만, 당신은 멀쩡합니다."

#: src/iuse.cpp
msgid "You don't have any mutations to purify."
msgstr "정화할 변이가 없습니다."

#: src/iuse.cpp
msgid "Choose a mutation to purify"
msgstr "정화할 변이를 선택하세요"

#: src/iuse.cpp
msgid ""
"You inject the purifier.  The liquid thrashes inside the tube and goes down "
"reluctantly."
msgstr "정화제를 주사합니다. 주사기 안에 든 액체가 주입을 거부하듯이 출렁이며 주사됩니다."

#: src/iuse.cpp
#, c-format
msgid ""
"As you eat the %s, you have a near-religious experience, feeling at one with"
" your surroundings…"
msgstr "%s(을)를 먹자, 거의 종교적이라고 일컫을만한 경험이 느껴집니다. 주변과 하나가 되는듯한..."

#: src/iuse.cpp
msgid "It tastes extremely strange!"
msgstr "정말 기묘한 맛이 납니다!"

#: src/iuse.cpp
msgid "You feel better all over."
msgstr "기분이 무척 좋아졌습니다."

#: src/iuse.cpp
msgid "It is delicious, and very filling!"
msgstr "맛있는데다 속도 든든해집니다!"

#: src/iuse.cpp
msgid "You take one bite, and immediately vomit!"
msgstr "한 입 베어문 직후 곧장 구토합니다!"

#: src/iuse.cpp
msgid ""
"You feel a familiar warmth, but suddenly it surges into an excruciating burn"
" as you convulse, vomiting, and black out…"
msgstr "친숙한 온기를 느끼지만, 온기가 느닷없이 극심한 열기로 변하여 경련하고 구토하다가 이내 의식이 끊깁니다..."

#: src/iuse.cpp
msgctxt "memorial_male"
msgid "Suffered Marloss Rejection."
msgstr "말로스 거부반응."

#: src/iuse.cpp
msgctxt "memorial_female"
msgid "Suffered Marloss Rejection."
msgstr "말로스 거부반응."

#: src/iuse.cpp
msgid ""
"You feel a familiar warmth, but suddenly it surges into painful burning as "
"you convulse and collapse to the ground…"
msgstr "친숙한 혼기를 느끼지만, 온기가 느닷없이 고통스러운 열기로 변하여 경련하며 바닥에 쓰러집니다..."

#: src/iuse.cpp src/monattack.cpp
msgid ""
"You wake up in a marloss bush.  Almost *cradled* in it, actually, as though "
"it grew there for you."
msgstr "포근하게 안아올려진 채 깨어났다. 날 위해 자라난 말로스 덤불 위에서..."

#. ~ Beginning to hear the Mycus while conscious: that's it speaking
#: src/iuse.cpp
msgid ""
"unity.  together we have reached the door.  we provide the final key.  now "
"to pass through…"
msgstr "통합. 우리는 함께 관문에 다다랐습니다. 우리가 마지막 열쇠를 드립니다. 지나갈 때입니다..."

#: src/iuse.cpp
msgid "You feel a strange warmth spreading throughout your body…"
msgstr "전신에 낯선 온기가 퍼지는게 느껴집니다..."

#. ~ "Uh-uh" is a sound used for "nope", "no", etc.
#: src/iuse.cpp
msgid ""
"After what happened that last time?  uh-uh.  You're not eating that alien "
"poison."
msgstr "그때 이후로 무슨 일이 일어났냐고요? 으음. 다시는 그 외계 맹독을 먹지 않기로 했습니다."

#: src/iuse.cpp
msgid "We no longer require this scaffolding.  We reserve it for other uses."
msgstr "더이상 우리에게 이런 지지대는 필요치 않습니다. 우리의 다른 쓸모를 위해 남겨두겠습니다."

#: src/iuse.cpp
#, c-format
msgid "Sure you want to eat the %s?  You could plant it in a mound of dirt."
msgstr "정말로 %s(을)를 먹습니까?  흙더미에 심을 수도 있습니다."

#: src/iuse.cpp
msgid "It tastes amazing, and you finish it quickly."
msgstr "맛이 굉장하여, 순식간에 먹어치웁니다."

#: src/iuse.cpp
msgid ""
"As it settles in, you feel ecstasy radiating through every part of your "
"body…"
msgstr "그것이 몸에 들어오자, 몸 구석구석에 퍼지는 기쁨을 느낄 수 있습니다."

#: src/iuse.cpp
msgid ""
"Your eyes roll back in your head.  Everything dissolves into a blissful "
"haze…"
msgstr "눈이 뒤집어집니다. 모든 것이 행복한 안개로 무너져내립니다..."

#. ~ The Mycus does not use the term (or encourage the concept of) "you".  The
#. PC is a local/native organism, but is now the Mycus.
#. ~ It still understands the concept, but uninitelligent fungaloids and mind-
#. bent symbiotes should not need it.
#. ~ We are the Mycus.
#: src/iuse.cpp
msgid "We welcome into us.  We have endured long in this forbidding world."
msgstr "우리 된 것을 환영합니다. 우리는 이 위험한 세계에서 오래도록 기다려왔습니다."

#: src/iuse.cpp
msgid ""
"A sea of white caps, waving gently.  A haze of spores wafting silently over "
"a forest."
msgstr "하얗게 덮인 바다가 부드럽게 파도칩니다. 포자 안개가 숲 너머로 고요하게 퍼집니다."

#: src/iuse.cpp
msgid "The natives have a saying: \"E Pluribus Unum.\"  Out of many, one."
msgstr "아메리카 원주민들의 격언이 있죠, \"에 플루리부스 우눔\". 다수로부터 하나에."

#: src/iuse.cpp
msgid ""
"The blazing pink redness of the berry.  The juices spreading across your "
"tongue, the warmth draping over us like a lover's embrace."
msgstr "타오르는듯한 분홍색 열매의 적열. 그 과즙이 당신의 혀를 타고 퍼지고, 온기가 연인들의 포옹과도 같이 우리를 감싸안습니다."

#: src/iuse.cpp
msgid ""
"We welcome the union of our lines in our local guide.  We will prosper, and "
"unite this world.  Even now, our fruits adapt to better serve local "
"physiology."
msgstr ""
"우리의 현지 안내자가 우리의 연결-통합체에 포함된 것을 환영합니다. 우리는 번영하고, 이 세계를 통합할 것입니다. 지금도 우리의 과실은 "
"현지 생체 말단에 적합하도록 적응하고 있습니다."

#: src/iuse.cpp
msgid ""
"The sky-blue of the seed.  The nutty, creamy flavors intermingling with the "
"berry, a memory that will never leave us."
msgstr "하늘을 닮은 푸른색 씨앗. 고소하고 크리미한 향 섞인 열매. 우리에게서 결코 사라지지 않을 기억."

#: src/iuse.cpp
msgid ""
"As, in time, shall we adapt to better welcome those who have not received "
"us."
msgstr "지금은, 우리를 아직 받아들이지 않은 이들에게 더 나은 환영을 베풀기 위해, 적응해야 하는 때입니다."

#: src/iuse.cpp
msgid ""
"The amber-yellow of the sap.  Feel it flowing through our veins, taking the "
"place of the strange, thin red gruel called \"blood.\""
msgstr "\"혈액\"이라는 붉고도 옅은 귀리죽 따위가 아닌, 호박과도 같은 노란색 수액이 우리의 관을 타고 흐르는 것을 느끼세요."

#: src/iuse.cpp
msgid "This tastes really weird!  You're not sure it's good for you…"
msgstr "맛이 정말 기묘합니다! 이게 당신에게 적합한건지 확실하지 않습니다..."

#: src/iuse.cpp
msgid "You doubt someone would want to eat % 1$s."
msgstr "%1$s 같은걸 누가 먹고싶어할지 의문이 듭니다."

#: src/iuse.cpp
#, c-format
msgid "Tame which animal with the %s?"
msgstr "%s(으)로 어느 동물을 길들입니까?"

#: src/iuse.cpp
msgid "Are you sure you want to feed a person the pet food?"
msgstr "정말 사람에게 동물 사료를 먹입니까?"

#: src/iuse.cpp
#, c-format
msgid "You put your %1$s into %2$s's mouth!"
msgstr "%1$s(을)를 %2$s에게 먹입니다!"

#: src/iuse.cpp
msgid ""
"Okay, but please, don't give me this again.  I don't want to eat pet food in"
" the cataclysm all day."
msgstr "그래, 근데 부탁인데, 이거 다시는 주지 마. 아무리 세상이 이꼴이 났어도 동물 사료를 먹고 싶지는 않아."

#: src/iuse.cpp
#, c-format
msgid "%s knocks it out from your hand!"
msgstr "%s(이)가 당신의 손에서 그걸 쳐냅니다!"

#: src/iuse.cpp
#, c-format
msgid "You try to feed the %s some %s, but it vanishes!"
msgstr "%s에게 %s(을)를 먹이려 했지만, 사라져버립니다!"

#: src/iuse.cpp
#, c-format
msgid "You reach for the %s, but it recoils away from you!"
msgstr "%s(으)로 손을 뻗었지만, 당신을 피해 뒤로 물러납니다!"

#: src/iuse.cpp
#, c-format
msgid "The %s doesn't want that kind of food."
msgstr "%s(은)는 이런 음식을 좋아하지 않는 것 같습니다."

#: src/iuse.cpp
#, c-format
msgid "The %s does not trust your kind."
msgstr "%s(은)는 당신 부류를 믿지 않습니다."

#: src/iuse.cpp
msgid "You want to feed it the pet food, but it bites your fingers!"
msgstr "동물 사료를 먹이려 했지만, 놈이 당신의 손가락을 물었습니다!"

#: src/iuse.cpp
msgid ""
"Apparently it's more interested in your flesh than the pet food in your "
"hand!"
msgstr "보아하니 당신의 손에 들린 동물 사료보다 당신의 살점을 더 좋아하는 것 같습니다!"

#: src/iuse.cpp
#, c-format
msgid "You feed your %1$s to the %2$s."
msgstr "%2$s에게 %1$s(을)를 먹입니다."

#: src/iuse.cpp
#, c-format
msgid "The %1$s is your pet now!"
msgstr "%1$s(은)는 이제 당신의 애완동물입니다!"

#: src/iuse.cpp
#, c-format
msgid "The %s looks healthier and more productive."
msgstr "%s(이)가 보다 건강해보이고, 생산력이 향상된 상태입니다."

#: src/iuse.cpp
msgid "There is nothing to be fed here."
msgstr "주변에 먹이를 줄 대상이 없습니다."

#: src/iuse.cpp
msgid "Modify what?"
msgstr "무엇을 개조합니까?"

#: src/iuse.cpp src/iuse_actor.cpp
msgid "You do not have that item!"
msgstr "그 물품을 갖고 있지 않습니다!"

#: src/iuse.cpp
msgid "Which signal should activate the item?"
msgstr "어느 신호로 물품을 작동시킵니까?"

#: src/iuse.cpp
msgid "\"Blue\""
msgstr "\"파란색\""

#: src/iuse.cpp
msgid "\"Green\""
msgstr "\"초록색\""

#: src/iuse.cpp
msgid "\"Red\""
msgstr "\"빨간색\""

#: src/iuse.cpp
msgid "This item has been modified this way already."
msgstr "이미 그렇게 설정되어 있습니다."

#: src/iuse.cpp
#, c-format
msgid ""
"You modify your %1$s to listen for %2$s activation signal on the radio."
msgstr "%1$s(을)를 개조해서 %2$s 작동 신호를 듣게 했다."

#: src/iuse.cpp
msgid "Remove mods from tool?"
msgstr "도구에서 부속물을 떼어냅니까?"

#: src/iuse.cpp
msgid "You don't have any modified tools."
msgstr "개조된 도구가 없습니다."

#: src/iuse.cpp
#, c-format
msgid "You remove the %s from the tool."
msgstr "도구에서 %s(을)를 떼어냈습니다."

#: src/iuse.cpp
msgid "You doubt you will catch anything here, best look elsewhere"
msgstr "여기서 물고기를 잡을 수 있을 것 같지 않습니다. 다른 곳을 찾아보는 것이 좋겠습니다."

#: src/iuse.cpp
msgid "You can't fish there!"
msgstr "그곳에서는 물고기를 낚을 수 없다!"

#: src/iuse.cpp
msgid "You doubt you will catch too much here, but surely theres some"
msgstr "여기서 물고기를 그다지 잡을 수 있을 것 같지 않지만, 몇 마리쯤 있긴 할겁니다."

#: src/iuse.cpp
msgid "You think there might be a few things to catch here"
msgstr "여기서 물고기를 좀 잡을 수 있을 것 같습니다."

#: src/iuse.cpp
msgid "You see at least one catch, should be a decent spot"
msgstr "수면 아래로 물고기가 최소한 한 마리는 있는 것이 똑똑히 보입니다. 괜찮은 낚시터 같군요."

#: src/iuse.cpp
msgid "You see several catches already, this should be a great spot"
msgstr "수면 아래로 물고기 여러 마리가 똑똑히 보입니다. 훌륭한 낚시터 같군요."

#: src/iuse.cpp
msgid "You see a massive number of catches here, this is as good as it gets"
msgstr "수면 아래로 대량의 물고기가 똑똑히 보입니다. 물 반 고기 반입니다!"

#: src/iuse.cpp
msgid "You cast your line and wait to hook something…"
msgstr "낚싯줄을 늘어뜨리고 뭔가 낚이기를 기다립니다…"

#: src/iuse.cpp
msgid "Fish are not foolish enough to go in here without bait."
msgstr "물고기는 미끼도 없는데 낚일 만큼 멍청하지 않습니다."

#: src/iuse.cpp
msgid "Put fish trap where?"
msgstr "어디에 통발을 설치합니까?"

#: src/iuse.cpp
msgid "You place the fish trap, in three hours or so you may catch some fish."
msgstr "통발을 설치했습니다. 세 시간쯤 지나면 물고기가 잡혀있을지도 모릅니다."

#: src/iuse.cpp
msgid "Spray where?"
msgstr "어디에 스프레이를 뿌립니까?"

#: src/iuse.cpp
#, c-format
msgid "The %s is sprayed!"
msgstr "%s(이)가 뿌려집니다!"

#: src/iuse.cpp
#, c-format
msgid "The %s looks blinded."
msgstr "%s(은)는 눈이 먼 것 같습니다."

#: src/iuse.cpp
#, c-format
msgid "The %s is frozen!"
msgstr "%s(이)가 얼어붙었습니다!"

#: src/iuse.cpp
#, c-format
msgid "You unpack your %s for use."
msgstr "%s의 포장을 풀어 쓸 수 있도록 준비합니다."

#: src/iuse.cpp
msgid "Choose CBM to pack"
msgstr "포장할 바이오닉 선택"

#: src/iuse.cpp
msgid "You don't have any CBMs."
msgstr "갖고 있는 CBM이 없습니다."

#: src/iuse.cpp
msgid "This CBM is faulty.  You should mend it first.  Do you want to try?"
msgstr "이 바이오닉은 고장났습니다. 포장하기 앞서 수리해야 합니다. 수리할까요?"

#: src/iuse.cpp
msgid "You carefully prepare the CBM for sterilization."
msgstr "조심스럽게 바이오닉을 멸균할 준비를 마쳤습니다."

#: src/iuse.cpp
msgid "You fail to properly prepare the CBM."
msgstr "바이오닉 멸균 준비에 실패했습니다."

#: src/iuse.cpp
#, c-format
msgid "You can't pack your %s until you take it off."
msgstr "%s(을)를 벗지 않으면 포장할 수 없습니다."

#: src/iuse.cpp
#, c-format
msgid "You pack your %s for storage."
msgstr "%s(을)를 보관하기 위해 말았다."

#: src/iuse.cpp
msgid "Purify what?"
msgstr "무엇을 정수합니까?"

#: src/iuse.cpp
msgid "You don't have water to purify."
msgstr "정화할 물이 없습니다."

#: src/iuse.cpp
msgid "That volume of water is too large to purify."
msgstr "물의 양이 너무 많아 정화할 수 없습니다."

#: src/iuse.cpp
msgid "It's dead."
msgstr "배터리가 없거나, 죽은 것 같습니다."

#: src/iuse.cpp
msgid "You turn the radio on."
msgstr "라디오를 켰습니다."

#: src/iuse.cpp
msgid "Must have an active radio to check for signal direction."
msgstr "사용 가능한 라디오가 있어야 신호 방향을 확인할 수 있다."

#: src/iuse.cpp
msgid "You can't find the direction if your radio isn't tuned."
msgstr "라디오 주파수를 조정하지 않으면 방향을 찾을 수 없습니다."

#: src/iuse.cpp
#, c-format
msgid "The signal seems strongest to the %s."
msgstr "신호가 %s 방향에서 가장 강한 것 같습니다."

#: src/iuse.cpp
msgid "Radio: Kssssssssssssh."
msgstr "라디오: 치이이이이이익."

#: src/iuse.cpp
#, c-format
msgid "radio: %s"
msgstr "라디오: %s"

#: src/iuse.cpp
msgid "Radio:"
msgstr "라디오:"

#: src/iuse.cpp
msgid "Scan"
msgstr "스캔"

#: src/iuse.cpp
msgid "The radio dies."
msgstr "라디오가 꺼졌다."

#: src/iuse.cpp
msgid "You turn the noise emitter on."
msgstr "소음 발생기를 작동시켰다."

#. ~ the sound of a noise emitter when turned on
#: src/iuse.cpp
msgid "KXSHHHHRRCRKLKKK!"
msgstr "삐삐삐이이이삐이이이익!"

#: src/iuse.cpp
msgid "The infernal racket dies as the noise emitter turns off."
msgstr "소음 발생기를 끄자 지옥 같은 소음이 멈췄다."

#: src/iuse.cpp
msgid "Pry where?"
msgstr "어느 문을 비틀어 엽니까?"

#: src/iuse.cpp
msgid "There is nothing to pry nearby."
msgstr "비틀어 열 것이 없습니다."

#: src/iuse.cpp
msgid "You try to hit yourself with the hammer."
msgstr "망치로 스스로를 후려칠 뻔합니다."

#: src/iuse.cpp
msgid "But you can't touch this."
msgstr "대상이 손에 닿지 않습니다."

#: src/iuse.cpp
msgid "You can't pry that."
msgstr "대상을 비틀어 열 수 없습니다."

#: src/iuse.cpp
msgid ""
"You attempt to pry open your wallet but alas.  You are just too miserly."
msgstr "지갑을 비틀어 열려고 했지만 세상에 맙소사. 가진 돈이 없습니다."

#: src/iuse.cpp
msgid "You notice the door is unlocked, so you simply open it."
msgstr "문이 잠겨있지 않아, 구태여 더 시도하지 않고 그대로 열었습니다."

#: src/iuse.cpp
#, c-format
msgid "You can't get sufficient leverage to open that with your %s."
msgstr "%s(으)로 그걸 열기에는 지렛대의 힘이 불충분합니다."

#: src/iuse.cpp
msgid "Till soil where?"
msgstr "어느 곳의 토양을 개간합니까?"

#: src/iuse.cpp
msgid "You think about jumping on a shovel, but then change up your mind."
msgstr "삽을 타고 펄쩍펄쩍 뛰어다닐까하다가, 이내 생각을 고쳐먹습니다."

#: src/iuse.cpp
msgid "You start churning up the earth here."
msgstr "땅을 갈아엎기 시작합니다."

#: src/iuse.cpp
msgid "You can't churn up this ground."
msgstr "이 땅을 갈아엎을 수 없습니다."

#: src/iuse.cpp
msgid ""
"You can't dig a pit in this location.  Ensure it is clear diggable ground "
"with no items or obstacles."
msgstr "이곳에 구덩이를 팔 수 없습니다. 물건이나 장애물이 남아있지 않은지, 팔 수 있는 지형인지 확인하세요."

#: src/iuse.cpp
msgid "You can't exhume a grave without a better digging tool."
msgstr "이 무덤을 파헤치려면 더 나은 땅파기 도구가 필요합니다."

#: src/iuse.cpp
msgid "You don't have a good enough digging tool to dig there!"
msgstr "이곳을 파헤칠만한 성능의 땅파기 도구가 없습니다!"

#: src/iuse.cpp
msgid "Deposit excavated materials where?"
msgstr "파낸 물품들을 어디에 놓습니까?"

#: src/iuse.cpp
msgid "There is nowhere to deposit the excavated materials."
msgstr "파낸 것들을 놓을만한 곳이 없습니다."

#: src/iuse.cpp
msgid "You can't deposit the excavated materials onto an impassable location."
msgstr "통과할 수 없는 지점에 파낸 것들을 놓을 수 없습니다."

#: src/iuse.cpp
msgid "Would you really touch the sacred resting place of the dead?"
msgstr "정말로 망자의 신성한 안식처를 건드립니까?"

#: src/iuse.cpp
msgid "Exhuming a grave is really against your beliefs."
msgstr "묘지를 도굴하는건 정말로 당신의 신앙에 어긋나는 짓입니다."

#: src/iuse.cpp
msgid "Exhuming a grave is fun now, where there is no one to object."
msgstr "묘지를 도굴하는건 재미있네요. 방해하는 사람이 없기도 하고요."

#: src/iuse.cpp
msgid "Exhuming this grave is utterly disgusting!"
msgstr "묘지를 도굴하는건 진짜로 구역질나는 짓입니다!"

#: src/iuse.cpp
msgid ""
"You can't dig a channel in this location.  Ensure it is clear diggable "
"ground with no items or obstacles, adjacent to flowing water."
msgstr ""
"이곳에 물길을 낼 수 없습니다. 물건이나 장애물이 남아있지 않은지, 팔 수 있는 지형인지, 흐르는 물에 인접한게 맞는지 확인하세요."

#: src/iuse.cpp
msgid "Fill which pit or mound?"
msgstr "어느 것을 메웁니까?"

#: src/iuse.cpp
msgid "There is no pit or mound to fill nearby."
msgstr "주변에 메울만한 구덩이나 흙더미가 없습니다."

#: src/iuse.cpp
msgid "You decide not to bury yourself that early."
msgstr "스스로가 이렇게나 빨리 죽어서 땅에 묻혀야 한다고는 생각하지 않습니다."

#: src/iuse.cpp
msgid "There is nothing to fill."
msgstr "채울 것이 없습니다."

#: src/iuse.cpp
msgid "Clear rubble where?"
msgstr "어느 돌무더기를 치울까요?"

#: src/iuse.cpp
msgid "There is no rubble to clear nearby."
msgstr "근처에 치울만한 돌무더기가 없습니다."

#: src/iuse.cpp
msgid "There's no rubble to clear."
msgstr "치울만한 돌무더기가 없습니다."

#: src/iuse.cpp
msgid "Siphon from where?"
msgstr "어디의 내용물을 빼냅니까?"

#: src/iuse.cpp
msgid "There is nothing to siphon nearby."
msgstr "근처에 빨아들일 것이 없습니다."

#: src/iuse.cpp
msgid "Drill where?"
msgstr "어디를 뚫을까요?"

#: src/iuse.cpp
msgid "You can't drill there."
msgstr "해당 지점을 뚫을 수 없습니다."

#: src/iuse.cpp
msgid "There's a vehicle in the way!"
msgstr "경로에 차량이 있습니다!"

#: src/iuse.cpp
#, c-format
msgid "You start drilling into the %1$s with your %2$s."
msgstr "%1$s(을)를 %2$s(으)로 뚫기 시작합니다."

#: src/iuse.cpp
msgid "Mine where?"
msgstr "어디를 파낼까요?"

#: src/iuse.cpp
msgid "You can't mine there."
msgstr "해당 지점을 파낼 수 없습니다."

#: src/iuse.cpp
#, c-format
msgid "You strike the %1$s with your %2$s."
msgstr "%1$s(을)를 %2$s(으)로 후려치기 시작합니다."

#: src/iuse.cpp
msgid "Burrow where?"
msgstr "어딜 팝니까?"

#: src/iuse.cpp
msgid "You can't burrow there."
msgstr "해당 지점에 파고들 수 없습니다."

#: src/iuse.cpp
#, c-format
msgid "You start tearing into the %1$s with your %2$s."
msgstr "%1$s(을)를 %2$s(으)로 파헤치기 시작합니다."

#: src/iuse.cpp
msgid "buzzing"
msgstr "웅웅"

#: src/iuse.cpp
msgid "clicking"
msgstr "째깍"

#: src/iuse.cpp
msgid "rapid clicking"
msgstr "쨰깍째깍째깍째깍"

#: src/iuse.cpp
msgid "geiger_high"
msgstr "geiger_high"

#: src/iuse.cpp
msgid "geiger_low"
msgstr "geiger_low"

#: src/iuse.cpp
msgid "geiger_medium"
msgstr "geiger_medium"

#: src/iuse.cpp
msgid "The geiger counter buzzes intensely."
