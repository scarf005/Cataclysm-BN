msgstr "투박한 나무 탁자."

#: data/json/items/vehicle/tables.json
#: data/json/vehicleparts/vehicle_parts.json
msgid "survivors workbench"
msgid_plural "survivors workbenches"
msgstr[0] "생존자의 작업대"

#: data/json/items/vehicle/tables.json
#: data/json/vehicleparts/vehicle_parts.json
