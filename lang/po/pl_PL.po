msgid "<q>uit"
msgstr "[q]wyjdź"

#: src/iuse_software_lightson.cpp
msgid "<color_white>Game goal:</color> Switch all the lights on."
msgstr "<color_white>Cel gry:</color> Włącz wszystkie światła."

#: src/iuse_software_lightson.cpp
msgid "<color_white>Legend: #</color> on, <color_dark_gray>-</color> off."
msgstr "<color_white>Legenda: #</color> wł., <color_dark_gray>-</color> wył."

#: src/iuse_software_lightson.cpp
msgid "Toggle lights switches selected light and 4 its neighbors."
msgstr "Przełączenie świateł przełącza wybrane światła i 4 sąsiednie."

#: src/iuse_software_lightson.cpp src/iuse_software_minesweeper.cpp
msgid "Congratulations, you won!"
msgstr "Gratulacje, wygrałeś!"

