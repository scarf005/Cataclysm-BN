msgid "<n>ew level"
msgstr "<n>owy poziom"

#: src/iuse_software_minesweeper.cpp
msgid "<f>lag"
msgstr "<f>laga"

#: src/iuse_software_minesweeper.cpp
msgid "Boom, you're dead!  Better luck next time."
msgstr "Boom, nie żyjesz! Powodzenia następnym razem."

