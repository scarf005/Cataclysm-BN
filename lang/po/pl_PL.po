msgstr[3] "komercyjny nawóz"

#. ~ Description for {'str_sp': 'commercial fertilizer'}
#: data/json/items/chemicals_and_resources.json
msgid "Nutrient rich granules for plants."
msgstr "Bogate w składniki odżywcze granulki dla roślin."

#: data/json/items/chemicals_and_resources.json
msgid "fungicide"
msgid_plural "fungicide"
msgstr[0] "preparat grzybobójczy"
msgstr[1] "preparat grzybobójczy"
msgstr[2] "preparat grzybobójczy"
msgstr[3] "preparat grzybobójczy"

#. ~ Description for {'str_sp': 'fungicide'}
#: data/json/items/chemicals_and_resources.json
msgid ""
"Agricultural grade chemical anti-fungal powder designed to destroy "
"infections in plants."
msgstr ""
"Rolnicze chemia grzybobójcza w proszku stosowana do zwalczania grzybiczych "
"infekcji roślinnych."

#: data/json/items/chemicals_and_resources.json
