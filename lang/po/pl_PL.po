msgstr[2] ""
msgstr[3] ""

#. ~ Description for arcade machine
#: data/json/furniture_and_terrain/furniture-recreation.json
msgid ""
"Play stupid games, win stupid prizes.  That was the idea, anyway.  Now, "
"without power, it's just stupid.  Smarter to disassemble for all kinds of "
"useful electronic parts."
msgstr ""

#: data/json/furniture_and_terrain/furniture-recreation.json
#: data/json/items/fake.json data/json/items/furniture.json
msgid "pinball machine"
msgid_plural "pinball machines"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""
msgstr[3] ""

#. ~ Description for pinball machine
#: data/json/furniture_and_terrain/furniture-recreation.json
msgid ""
"Most underrated game of the 20th century.  Press buttons so the ball doesn't"
" go in the hole.  It doesn't seem to be working without electricity.  Could "
"be disassembled for various electronic parts."
msgstr ""

#: data/json/furniture_and_terrain/furniture-recreation.json
#: data/json/items/fake.json data/json/items/furniture.json
msgid "ergometer"
msgid_plural "ergometers"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""
msgstr[3] ""

#. ~ Description for ergometer
#: data/json/furniture_and_terrain/furniture-recreation.json
msgid ""
"A rowing exercise machine, might have useful parts in it.  Examine it to "
"practice your Athletics skill."
msgstr ""

#: data/json/furniture_and_terrain/furniture-recreation.json
#: data/json/items/fake.json data/json/items/furniture.json
msgid "treadmill"
msgid_plural "treadmills"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""
msgstr[3] ""

#. ~ Description for treadmill
#: data/json/furniture_and_terrain/furniture-recreation.json
msgid ""
"Used for training leg muscles.  Could be taken apart for its… parts.  You "
"could use it to practice Athletics, but this will require restoring power to"
