msgstr "<+> następny"

#: src/iuse_software_sokoban.cpp
msgid "<-> prev"
msgstr "<-> poprzedni"

#: src/iuse_software_sokoban.cpp
msgid "<u>ndo move"
msgstr "[<u>]cofnij ruch"

