msgstr[0] ""
msgstr[1] ""
msgstr[2] ""
msgstr[3] ""

#. ~ Description for {'str': 'pair of C.R.I.T. shoes', 'str_pl': 'pairs of
#. C.R.I.T. dress shoes'}
#: data/mods/CRT_EXPANSION/items/crt_clothes.json
msgid "A sleek pair of dress shoes.  Fancy but easy on the eyes."
msgstr ""

#: data/mods/CRT_EXPANSION/items/crt_clothes.json
msgid "pair of C.R.I.T. rec gloves"
msgid_plural "pairs of C.R.I.T. rec gloves"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""
msgstr[3] ""

#. ~ Description for {'str': 'pair of C.R.I.T. rec gloves', 'str_pl': 'pairs
#. of C.R.I.T. rec gloves'}
#: data/mods/CRT_EXPANSION/items/crt_clothes.json
