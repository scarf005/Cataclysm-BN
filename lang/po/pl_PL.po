#: data/help/texts.json
msgid ""
"<color_light_green>^>v<</color>        House - Filled with a variety of "
"items. Good place to sleep."
msgstr ""
"<color_light_green>^>v<</color>        Dom - wypełniony różnorodnymi "
"rzeczami. Dobre miejsce na sen."

#: data/help/texts.json
msgid ""
"<color_light_blue>^>v<</color>        Gas station - A good place to collect "
"gasoline. Risk of explosion."
msgstr ""
"<color_light_blue>^>v<</color>        Stacja paliw - Dobre miejsce do "
"zaopatrzenia w paliwo. Ryzyko wybuchu."

#: data/help/texts.json
msgid ""
"<color_light_red>^>v<</color>        Pharmacy - The best source for vital "
"medications."
msgstr ""
"<color_light_red>^>v<</color>        Apteka - Najlepsze źródło "
"niezastąpionych leków."

#: data/help/texts.json
msgid ""
"<color_green>^>v<</color>        Grocery store - A good source of canned "
"food and other supplies."
msgstr ""
"<color_green>^>v<</color>        Sklep spożywczy - dobre źródło puszkowanej "
